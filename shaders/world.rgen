#version 460
#extension GL_GOOGLE_include_directive : require
#if defined(PRIME_ENABLE_SER)
#extension GL_EXT_buffer_reference_uvec2 : require
#extension GL_EXT_shader_invocation_reorder : require
#endif
#include "common.glsl"
#include "atmosphere_rt.glsl"
#include "nrd_common.glsl"

layout(location = 0) rayPayloadEXT TracePayload primePayload;
layout(location = 1) rayPayloadEXT uint primeShadowHitDistanceBits;

#include "sampling.glsl"
#include "bsdf.glsl"
#include "lights.glsl"
#include "integrator.glsl"
#include "camera.glsl"

void main() {
    uvec2 pixel = gl_LaunchIDEXT.xy;
    IntegratorRecord integrator;
    integrator.sunDirectionIntensity = vec4(
            primePush.sunDirection,
            ATM_SPACE_SUN_INTENSITY * primeSunRadianceMultiplier());
    integrator.environmentRadiance = vec4(0.0);
    vec2 cameraSample = primeCameraSample();
    PathState path = primeCameraPath(pixel, 0u, cameraSample);

    PrimeIntegrationResult sampleResult = primeIntegrate(path, integrator);
    PrimeTransparencyGuideResult transparencyGuide;
    transparencyGuide.backgroundRadiance = vec3(0.0);
    transparencyGuide.reflectionHitDistance = 0.0;
    transparencyGuide.valid = false;
    if ((primePush.path.w & PRIME_PATH_DLSS_RR_MASK) != 0u
            && (sampleResult.primaryMaterialFlags & PRIME_MATERIAL_FLAG_TRANSMISSIVE) != 0u) {
        transparencyGuide = primeIntegrateTransparencyGuide(path, integrator);
        if (transparencyGuide.valid) {
            sampleResult.specularHitDistance = transparencyGuide.reflectionHitDistance;
        }
    }
    vec3 noisyDiffuse = sampleResult.diffuseRadiance;
    vec3 noisySpecular = sampleResult.specularRadiance;
    primeNrdClampRadiancePair(noisyDiffuse, noisySpecular, PRIME_NRD_FP16_MAX);
    // These images are a private raygen -> NRD-preparation scratch contract. Keeping raw
    // radiance, hit distance and primary material data here removes demodulation, YCoCg packing,
    // guide construction and FSR mask work from the register-heavy ray-generation shader. The
    // existing ray-tracing-to-compute barrier makes every write visible before nrd_motion.comp
    // converts the images in place to their public NRD meanings.
    imageStore(
            primeNrdNoisyDiffuse,
            ivec2(pixel),
            vec4(
                    primeNrdSanitizeRadiance(noisyDiffuse),
                    sampleResult.diffuseHitDistance));
    imageStore(
            primeNrdNoisySpecular,
            ivec2(pixel),
            vec4(
                    primeNrdSanitizeRadiance(noisySpecular),
                    sampleResult.specularHitDistance));
    // Diagnostic-only exact primary hit relative to the effective camera pinhole. Keeping this
    // separate from view-Z reconstruction lets the reprojection probe detect a self-consistent
    // but wrong camera transform instead of repeating the motion generator's assumptions.
    imageStore(
            primeNrdPrimaryPosition,
            ivec2(pixel),
            sampleResult.primaryDistance < 0.0
                    ? vec4(0.0)
                    : vec4(
                            sampleResult.primaryPosition,
                            uintBitsToFloat(packHalf2x16(cameraSample))));
    imageStore(
            primeNrdMaterial,
            ivec2(pixel),
            vec4(primeNrdSanitizeGuide(sampleResult.primaryAlbedo), sampleResult.primaryDistance));
    imageStore(
            primeNrdNormalRoughness,
            ivec2(pixel),
            primeNrdPackNormalRoughness(
                    sampleResult.primaryNormal,
                    sampleResult.primaryLinearRoughness));
    imageStore(
            primeNrdSpecularMaterial,
            ivec2(pixel),
            vec4(
                    primeNrdSanitizeGuide(sampleResult.primarySpecularAlbedo),
                    float(sampleResult.primaryMaterialFlags)));
    imageStore(
            primeNrdSunLighting,
            ivec2(pixel),
            vec4(
                    primeNrdClampRadiance(sampleResult.sunRadiance, PRIME_NRD_FP16_MAX),
                    sampleResult.sunVisibility));
    imageStore(
            primeNrdSunPenumbra,
            ivec2(pixel),
            vec4(sampleResult.sunPenumbra));
    imageStore(
            primeTransparencyGuide,
            ivec2(pixel),
            transparencyGuide.valid
                    ? vec4(
                            primeNrdClampRadiance(
                                    transparencyGuide.backgroundRadiance,
                                    PRIME_NRD_FP16_MAX),
                            1.0)
                    : vec4(0.0));

    // Directly visible sky/emission is a current-frame deterministic signal. FSR owns temporal
    // coverage reconstruction, so averaging a second independent history here would create stale
    // silhouettes and make its lock/disocclusion logic impossible to reason about.
    imageStore(primeAccumulation, ivec2(pixel), vec4(sampleResult.stableRadiance, 1.0));
}
