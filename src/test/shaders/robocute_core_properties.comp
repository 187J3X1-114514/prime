#version 460
#extension GL_GOOGLE_include_directive : require

#include "prime_test_abi.glsl"
#include "prime_bsdf_specializations.glsl"

const uint PRIME_CORE_INPUT_WORDS = 4u;
const uint PRIME_CORE_WITNESS_WORDS = 8u;

const uint PRIME_CORE_ONB = 0u;
const uint PRIME_CORE_COMMON = 1u;
const uint PRIME_CORE_FRESNEL = 2u;
const uint PRIME_CORE_REFLECTION = 3u;
const uint PRIME_CORE_REFRACTION = 4u;

struct PrimeCoreResult {
    uint mask;
    uvec4 witness[3];
};

void primeCoreClear(out PrimeCoreResult result) {
    result.mask = 0u;
    for (uint index = 0u; index < 3u; index++) {
        result.witness[index] = uvec4(0u);
    }
}

float primeCoreParam(uvec4 encoded[4], uint index) {
    uint flatIndex = index + 1u;
    return uintBitsToFloat(encoded[flatIndex / 4u][flatIndex % 4u]);
}

void primeCoreClassify(inout uint mask, float value) {
    mask |= primeTestClassify(value);
}

void primeCoreClassify(inout uint mask, vec2 value) {
    mask |= primeTestClassify(value);
}

void primeCoreClassify(inout uint mask, vec3 value) {
    mask |= primeTestClassify(value);
}

void primeCoreClassify(inout uint mask, vec4 value) {
    mask |= primeTestClassify(value);
}

bool primeCoreInUnitRange(float value) {
    return value >= -1.0e-6 && value <= 1.0 + 1.0e-6;
}

bool primeCoreInUnitRange(vec3 value) {
    return all(greaterThanEqual(value, vec3(-1.0e-6)))
            && all(lessThanEqual(value, vec3(1.0 + 1.0e-6)));
}

void primeCoreOnb(uvec4 encoded[4], out PrimeCoreResult result) {
    primeCoreClear(result);
    vec3 normal = vec3(
            primeCoreParam(encoded, 0u),
            primeCoreParam(encoded, 1u),
            primeCoreParam(encoded, 2u));
    vec3 local = vec3(
            primeCoreParam(encoded, 3u),
            primeCoreParam(encoded, 4u),
            primeCoreParam(encoded, 5u));
    PrimeRcOnb onb = primeRcOnbFromNormal(normal);
    vec3 world = primeRcOnbToWorld(onb, local);
    vec3 roundTrip = primeRcOnbToLocal(onb, world);
    vec3 lengths = vec3(
            length(onb.tangent),
            length(onb.bitangent),
            length(onb.normal));
    vec3 orthogonality = vec3(
            dot(onb.tangent, onb.bitangent),
            dot(onb.tangent, onb.normal),
            dot(onb.bitangent, onb.normal));
    float handedness = dot(cross(onb.tangent, onb.bitangent), onb.normal);
    float roundTripError = max(
            abs(roundTrip.x - local.x),
            max(abs(roundTrip.y - local.y), abs(roundTrip.z - local.z)));

    primeCoreClassify(result.mask, onb.tangent);
    primeCoreClassify(result.mask, onb.bitangent);
    primeCoreClassify(result.mask, onb.normal);
    primeCoreClassify(result.mask, world);
    primeCoreClassify(result.mask, roundTrip);
    primeCoreClassify(result.mask, lengths);
    primeCoreClassify(result.mask, orthogonality);
    primeCoreClassify(result.mask, handedness);
    primeCoreClassify(result.mask, roundTripError);
    if (!primeTestClose(lengths, vec3(1.0), 4.0e-5, 4.0e-5)
            || !primeTestClose(length(world), length(local), 4.0e-5, 4.0e-5)) {
        result.mask |= PRIME_TEST_FAILURE_UNIT_LENGTH;
    }
    if (!primeTestClose(orthogonality, vec3(0.0), 4.0e-5, 4.0e-5)
            || !primeTestClose(handedness, 1.0, 4.0e-5, 4.0e-5)) {
        result.mask |= PRIME_TEST_FAILURE_ORTHOGONAL;
    }
    if (roundTripError > 6.0e-5) {
        result.mask |= PRIME_TEST_FAILURE_ROUND_TRIP;
    }

    result.witness[0] = floatBitsToUint(vec4(lengths, handedness));
    result.witness[1] = floatBitsToUint(vec4(orthogonality, roundTripError));
    result.witness[2] = floatBitsToUint(vec4(world, length(world)));
}

void primeCoreCommon(uvec4 encoded[4], out PrimeCoreResult result) {
    primeCoreClear(result);
    vec2 sampleValue = vec2(
            primeCoreParam(encoded, 0u),
            primeCoreParam(encoded, 1u));
    float f0 = primeCoreParam(encoded, 2u);
    float roughness = primeCoreParam(encoded, 3u);
    float anisotropy = primeCoreParam(encoded, 4u);

    vec3 uniformHemisphere = primeRcUniformSampleHemisphere(sampleValue);
    vec3 cosineHemisphere = primeRcCosineSampleHemisphere(sampleValue);
    vec3 uniformSphere = primeRcUniformSampleSphere(sampleValue);
    float ior = primeRcF0ToIor(f0);
    float roundTripF0 = primeRcIorToF0(ior);
    vec2 alpha = primeRcSpecularNdfRoughnesses(roughness, anisotropy);
    vec3 lengths = vec3(
            length(uniformHemisphere),
            length(cosineHemisphere),
            length(uniformSphere));

    primeCoreClassify(result.mask, uniformHemisphere);
    primeCoreClassify(result.mask, cosineHemisphere);
    primeCoreClassify(result.mask, uniformSphere);
    primeCoreClassify(result.mask, ior);
    primeCoreClassify(result.mask, roundTripF0);
    primeCoreClassify(result.mask, alpha);
    primeCoreClassify(result.mask, lengths);
    if (!primeTestClose(lengths, vec3(1.0), 3.0e-5, 3.0e-5)) {
        result.mask |= PRIME_TEST_FAILURE_UNIT_LENGTH;
    }
    if (uniformHemisphere.z < -1.0e-7 || cosineHemisphere.z < -1.0e-7) {
        result.mask |= PRIME_TEST_FAILURE_HEMISPHERE;
    }
    if (!primeCoreInUnitRange(roundTripF0)
            || any(lessThan(alpha, vec2(0.0)))) {
        result.mask |= PRIME_TEST_FAILURE_RANGE;
    }
    if (!primeTestClose(roundTripF0, f0, 3.0e-6, 3.0e-5)) {
        result.mask |= PRIME_TEST_FAILURE_ROUND_TRIP;
    }
    if (anisotropy == 0.0 && !primeTestClose(alpha.x, alpha.y, 0.0, 0.0)) {
        result.mask |= PRIME_TEST_FAILURE_SYMMETRY;
    }
    if (anisotropy == 0.0) {
        float expectedAlpha = roughness * roughness;
        if (!primeTestClose(alpha.x, expectedAlpha, 1.0e-7, 1.0e-6)) {
            result.mask |= PRIME_TEST_FAILURE_IDENTITY;
        }
    }

    result.witness[0] = floatBitsToUint(vec4(lengths, uniformHemisphere.z));
    result.witness[1] = floatBitsToUint(vec4(ior, roundTripF0, alpha));
    result.witness[2] = floatBitsToUint(vec4(
            cosineHemisphere.z, uniformSphere.z, roughness, anisotropy));
}

void primeCoreFresnel(uvec4 encoded[4], out PrimeCoreResult result) {
    primeCoreClear(result);
    float ior = primeCoreParam(encoded, 0u);
    float cosineTheta = primeCoreParam(encoded, 1u);
    float phi = primeCoreParam(encoded, 2u);
    float sineTheta = sqrt(max(0.0, 1.0 - cosineTheta * cosineTheta));
    vec3 microIncident = vec3(
            sineTheta * cos(phi),
            sineTheta * sin(phi),
            cosineTheta);

    PrimeRcFloatPair amplitudes = primeRcDielectricRsRp(ior, cosineTheta);
    PrimeRcFloatPair reflectance = primeRcDielectricReflectance(ior, cosineTheta);
    float unpolarized = primeRcDielectricUnpolarized(ior, cosineTheta);
    float energy = primeRcDielectricEnergy(ior);
    float reciprocal = primeRcDielectricUnpolarized(1.0 / ior, -cosineTheta);
    float normalReflectance = primeRcDielectricUnpolarized(ior, 1.0);
    float expectedNormalReflectance = primeRcIorToF0(ior);
    vec3 incidentTowardInterface = -microIncident;
    PrimeRcRefractResult refracted = primeRcDielectricRefract(
            ior, incidentTowardInterface, vec3(0.0, 0.0, 1.0));
    float incidentCosine = incidentTowardInterface.z;
    float inverseEta = incidentCosine < 0.0 ? 1.0 / ior : ior;
    float refractionDiscriminant = 1.0
            - (1.0 - incidentCosine * incidentCosine) * inverseEta * inverseEta;
    uint expectedValid = refractionDiscriminant > 0.0 ? 1u : 0u;
    float snellError = abs(
            length(refracted.wo.xy) - inverseEta * length(incidentTowardInterface.xy));

    primeCoreClassify(result.mask, vec2(amplitudes.first, amplitudes.second));
    primeCoreClassify(result.mask, vec2(reflectance.first, reflectance.second));
    primeCoreClassify(result.mask, unpolarized);
    primeCoreClassify(result.mask, energy);
    primeCoreClassify(result.mask, reciprocal);
    primeCoreClassify(result.mask, normalReflectance);
    primeCoreClassify(result.mask, expectedNormalReflectance);
    primeCoreClassify(result.mask, refracted.wo);
    primeCoreClassify(result.mask, refractionDiscriminant);
    primeCoreClassify(result.mask, snellError);
    if (!primeCoreInUnitRange(reflectance.first)
            || !primeCoreInUnitRange(reflectance.second)
            || !primeCoreInUnitRange(unpolarized)
            || !primeCoreInUnitRange(normalReflectance)
            || !primeCoreInUnitRange(expectedNormalReflectance)) {
        result.mask |= PRIME_TEST_FAILURE_RANGE;
    }
    // Reciprocity is discontinuously sensitive to rounded reciprocal IORs at the TIR boundary.
    if (abs(refractionDiscriminant) > 1.0e-5
            && !primeTestClose(unpolarized, reciprocal, 2.0e-6, 2.0e-5)) {
        result.mask |= PRIME_TEST_FAILURE_RECIPROCITY;
    }
    if (!primeTestClose(
            normalReflectance, expectedNormalReflectance, 2.0e-6, 2.0e-5)) {
        result.mask |= PRIME_TEST_FAILURE_IDENTITY;
    }
    if (refracted.valid != expectedValid || refracted.valid > 1u) {
        result.mask |= PRIME_TEST_FAILURE_STATE;
    }
    if (refracted.valid != 0u) {
        if (!primeTestClose(length(refracted.wo), 1.0, 4.0e-5, 4.0e-5)) {
            result.mask |= PRIME_TEST_FAILURE_UNIT_LENGTH;
        }
        if (snellError > 4.0e-5) {
            result.mask |= PRIME_TEST_FAILURE_IDENTITY;
        }
    } else if (!primeTestClose(unpolarized, 1.0, 3.0e-6, 3.0e-5)) {
        result.mask |= PRIME_TEST_FAILURE_STATE;
    }

    result.witness[0] = floatBitsToUint(vec4(
            reflectance.first, reflectance.second, unpolarized, energy));
    result.witness[1] = uvec4(
            floatBitsToUint(refracted.wo.x),
            floatBitsToUint(refracted.wo.y),
            floatBitsToUint(refracted.wo.z),
            refracted.valid);
    result.witness[2] = floatBitsToUint(vec4(
            reciprocal, normalReflectance, refractionDiscriminant, snellError));
}

void primeCoreReflection(uvec4 encoded[4], out PrimeCoreResult result) {
    primeCoreClear(result);
    PrimeRcMicrofacet microfacet;
    microfacet.alpha = vec2(
            primeCoreParam(encoded, 0u),
            primeCoreParam(encoded, 1u));
    vec3 wi = normalize(vec3(
            primeCoreParam(encoded, 2u),
            primeCoreParam(encoded, 3u),
            primeCoreParam(encoded, 4u)));
    vec2 randomValue = vec2(
            primeCoreParam(encoded, 5u),
            primeCoreParam(encoded, 6u));

    bool effectivelySmooth = primeRcMicrofacetEffectivelySmooth(microfacet);
    vec3 halfVector = vec3(0.0, 0.0, 1.0);
    float distribution = 0.0;
    float microfacetPdf = 0.0;
    float symmetryDistribution = 0.0;
    if (!effectivelySmooth) {
        halfVector = primeRcMicrofacetSample(microfacet, wi, randomValue, true);
        distribution = primeRcMicrofacetD(microfacet, halfVector);
        microfacetPdf = primeRcMicrofacetPdf(
                microfacet, wi, halfVector, true);
        PrimeRcMicrofacet swapped;
        swapped.alpha = microfacet.alpha.yx;
        symmetryDistribution = primeRcMicrofacetD(
                swapped, halfVector.yxz);
    }
    PrimeRcReflectiveSampleBase sampled = primeRcReflectiveSampleBase(
            wi,
            vec3(randomValue, 0.5),
            microfacet,
            PRIME_RC_FLAG_ALL,
            PRIME_RC_FLAG_REFLECTION);
    uint flags = sampled.bsdfSample.throughput.flags;
    PrimeRcReflectiveEvalBase evaluated;
    evaluated.flags = PRIME_RC_FLAG_NONE;
    evaluated.factor = 0.0;
    evaluated.microCosine = 0.0;
    float evaluatedPdf = 0.0;
    if (flags != PRIME_RC_FLAG_NONE) {
        evaluated = primeRcReflectiveEvalBase(
                wi,
                sampled.bsdfSample.wo,
                microfacet,
                PRIME_RC_FLAG_ALL,
                PRIME_RC_FLAG_REFLECTION);
        evaluatedPdf = primeRcReflectivePdf(
                wi,
                sampled.bsdfSample.wo,
                microfacet,
                PRIME_RC_FLAG_ALL,
                PRIME_RC_FLAG_REFLECTION);
    }
    vec3 directionalAlbedo = primeRcMicrofacetDirectionalAlbedoReflection(
            microfacet, wi.z, vec3(0.04), vec3(1.0));

    primeCoreClassify(result.mask, halfVector);
    primeCoreClassify(result.mask, distribution);
    primeCoreClassify(result.mask, microfacetPdf);
    primeCoreClassify(result.mask, symmetryDistribution);
    primeCoreClassify(result.mask, sampled.bsdfSample.wo);
    primeCoreClassify(result.mask, sampled.bsdfSample.pdf);
    primeCoreClassify(result.mask, sampled.bsdfSample.throughput.value);
    primeCoreClassify(result.mask, evaluated.factor);
    primeCoreClassify(result.mask, evaluatedPdf);
    primeCoreClassify(result.mask, directionalAlbedo);
    if (distribution < 0.0
            || microfacetPdf < 0.0
            || sampled.bsdfSample.pdf < 0.0
            || any(lessThan(sampled.bsdfSample.throughput.value, vec3(0.0)))
            || evaluated.factor < 0.0
            || evaluatedPdf < 0.0
            || !primeCoreInUnitRange(directionalAlbedo)) {
        result.mask |= PRIME_TEST_FAILURE_RANGE;
    }
    if (!effectivelySmooth) {
        if (!primeTestClose(length(halfVector), 1.0, 3.0e-5, 3.0e-5)) {
            result.mask |= PRIME_TEST_FAILURE_UNIT_LENGTH;
        }
        if (halfVector.z < -1.0e-7) {
            result.mask |= PRIME_TEST_FAILURE_HEMISPHERE;
        }
        if (!primeTestClose(
                distribution, symmetryDistribution, 2.0e-6, 3.0e-5)) {
            result.mask |= PRIME_TEST_FAILURE_SYMMETRY;
        }
    }

    if (flags != PRIME_RC_FLAG_NONE) {
        if (!primeTestClose(length(sampled.bsdfSample.wo), 1.0, 4.0e-5, 4.0e-5)) {
            result.mask |= PRIME_TEST_FAILURE_UNIT_LENGTH;
        }
        if (sampled.bsdfSample.wo.z <= 0.0) {
            result.mask |= PRIME_TEST_FAILURE_HEMISPHERE;
        }
        uint expectedFlags = effectivelySmooth
                ? PRIME_RC_FLAG_DELTA_REFLECTION
                : PRIME_RC_FLAG_SPECULAR_REFLECTION;
        if (flags != expectedFlags) {
            result.mask |= PRIME_TEST_FAILURE_EVENT;
        }
        if (effectivelySmooth) {
            vec3 expectedOutgoing = vec3(-wi.xy, wi.z);
            if (!primeTestClose(sampled.bsdfSample.wo, expectedOutgoing, 2.0e-6, 2.0e-5)
                    || sampled.bsdfSample.pdf != 1.0
                    || !primeTestClose(
                            sampled.bsdfSample.throughput.value,
                            vec3(1.0),
                            0.0,
                            0.0)
                    || evaluated.flags != PRIME_RC_FLAG_NONE
                    || evaluatedPdf != 0.0) {
                result.mask |= PRIME_TEST_FAILURE_IDENTITY;
            }
        } else {
            if (evaluated.flags != PRIME_RC_FLAG_SPECULAR_REFLECTION) {
                result.mask |= PRIME_TEST_FAILURE_EVENT;
            }
            // Reconstructing h from nearly antipodal wi/wo is ill-conditioned.
            if (abs(sampled.microCosine) > 1.0e-2
                    && min(microfacet.alpha.x, microfacet.alpha.y) >= 5.0e-4) {
                float consistencyTolerance =
                        min(microfacet.alpha.x, microfacet.alpha.y) < 1.0e-3
                                || abs(wi.z) < 2.0e-2
                        ? 5.0e-3
                        : 3.0e-4;
                if (!primeTestClose(
                        sampled.bsdfSample.pdf,
                        evaluatedPdf,
                        2.0e-6,
                        consistencyTolerance)) {
                    result.mask |= PRIME_TEST_FAILURE_PDF;
                }
                if (!primeTestClose(
                        sampled.bsdfSample.throughput.value.x,
                        evaluated.factor,
                        2.0e-6,
                        consistencyTolerance)) {
                    result.mask |= PRIME_TEST_FAILURE_VALUE;
                }
            }
            PrimeRcReflectiveEvalBase reverse = primeRcReflectiveEvalBase(
                    sampled.bsdfSample.wo,
                    wi,
                    microfacet,
                    PRIME_RC_FLAG_ALL,
                    PRIME_RC_FLAG_REFLECTION);
            primeCoreClassify(result.mask, reverse.factor);
            if (reverse.flags != PRIME_RC_FLAG_SPECULAR_REFLECTION
                    || !primeTestClose(
                            evaluated.factor / abs(sampled.bsdfSample.wo.z),
                            reverse.factor / abs(wi.z),
                            3.0e-5,
                            4.0e-4)) {
                result.mask |= PRIME_TEST_FAILURE_RECIPROCITY;
            }
        }
    } else if (evaluated.flags != PRIME_RC_FLAG_NONE || evaluatedPdf != 0.0) {
        result.mask |= PRIME_TEST_FAILURE_EVENT;
    }

    result.witness[0] = floatBitsToUint(vec4(
            halfVector, distribution));
    result.witness[1] = uvec4(
            floatBitsToUint(sampled.bsdfSample.pdf),
            floatBitsToUint(evaluatedPdf),
            flags,
            evaluated.flags);
    result.witness[2] = floatBitsToUint(vec4(
            sampled.bsdfSample.throughput.value.x,
            evaluated.factor,
            microfacetPdf,
            length(sampled.bsdfSample.wo)));
}

void primeCoreRefraction(uvec4 encoded[4], out PrimeCoreResult result) {
    primeCoreClear(result);
    PrimeRcState state;
    state.specularMicrofacet.alpha = vec2(
            primeCoreParam(encoded, 0u),
            primeCoreParam(encoded, 1u));
    vec3 wi = normalize(vec3(
            primeCoreParam(encoded, 2u),
            primeCoreParam(encoded, 3u),
            primeCoreParam(encoded, 4u)));
    vec3 randomValue = vec3(
            primeCoreParam(encoded, 5u),
            primeCoreParam(encoded, 6u),
            primeCoreParam(encoded, 7u));
    float ior = primeCoreParam(encoded, 8u);
    state.specularFresnel.ior = ior;
    state.specularFresnel.energyIor = ior;
    state.specularFresnel.color = vec3(1.0);
    state.specularFresnel.thinFilmWeight = 0.0;
    state.specularFresnel.thinFilmThickness = 0.0;
    state.specularFresnel.thinFilmIor = 1.5;
    state.wavelengthsNm = vec3(630.0, 532.0, 467.0);
    state.spectrumed = 0u;
    state.samplingFlags = PRIME_RC_FLAG_ALL;
    state.geometryThinWalled = 0u;

    PrimeRcSample sampled = primeRcRefractiveSample(wi, randomValue, state);
    uint flags = sampled.throughput.flags;
    PrimeRcThroughput evaluated;
    evaluated.value = vec3(0.0);
    evaluated.flags = PRIME_RC_FLAG_NONE;
    float evaluatedPdf = 0.0;
    if (flags != PRIME_RC_FLAG_NONE) {
        evaluated = primeRcRefractiveEval(wi, sampled.wo, state);
        evaluatedPdf = primeRcRefractivePdf(wi, sampled.wo, state);
    }
    float sampledG2 = 0.0;
    float maximumLambda = 0.0;
    if (sampled.throughput.flags == PRIME_RC_FLAG_SPECULAR_TRANSMISSION) {
        vec3 orientedWi = wi;
        vec3 orientedWo = sampled.wo;
        if (orientedWi.z < 0.0) {
            orientedWi = -orientedWi;
            orientedWo = -orientedWo;
        }
        float firstLambda = primeRcMicrofacetLambda(
                state.specularMicrofacet, -orientedWi);
        float secondLambda = primeRcMicrofacetLambda(
                state.specularMicrofacet, orientedWo);
        maximumLambda = max(firstLambda, secondLambda);
        sampledG2 = primeRcMicrofacetG2t(
                state.specularMicrofacet, wi, sampled.wo);
    }
    bool effectivelySmooth = primeRcMicrofacetEffectivelySmooth(state.specularMicrofacet)
            || ior == 1.0;
    bool numericInterior = effectivelySmooth
            || (min(
                    state.specularMicrofacet.alpha.x,
                    state.specularMicrofacet.alpha.y) >= 5.0e-3
            && abs(wi.z) >= 1.0e-1
            && (flags == PRIME_RC_FLAG_NONE || abs(sampled.wo.z) >= 5.0e-2)
            && abs(ior - 1.0) >= 1.0e-2);

    primeCoreClassify(result.mask, sampled.wo);
    primeCoreClassify(result.mask, sampled.eta);
    primeCoreClassify(result.mask, maximumLambda);
    if (numericInterior) {
        primeCoreClassify(result.mask, sampled.pdf);
        primeCoreClassify(result.mask, evaluatedPdf);
        primeCoreClassify(result.mask, sampled.throughput.value);
        primeCoreClassify(result.mask, evaluated.value);
        primeCoreClassify(result.mask, sampledG2);
    }
    if (sampled.pdf < 0.0 || evaluatedPdf < 0.0
            || (numericInterior
            && (any(lessThan(sampled.throughput.value, vec3(0.0)))
            || any(lessThan(evaluated.value, vec3(0.0)))))) {
        result.mask |= PRIME_TEST_FAILURE_RANGE;
    }

    if (flags != PRIME_RC_FLAG_NONE) {
        uint allowed = PRIME_RC_FLAG_SPECULAR_REFLECTION
                | PRIME_RC_FLAG_SPECULAR_TRANSMISSION
                | PRIME_RC_FLAG_DELTA_REFLECTION
                | PRIME_RC_FLAG_DELTA_TRANSMISSION;
        if ((flags & allowed) == 0u || (flags & (flags - 1u)) != 0u) {
            result.mask |= PRIME_TEST_FAILURE_EVENT;
        }
        if (!primeTestClose(length(sampled.wo), 1.0, 5.0e-5, 5.0e-5)) {
            result.mask |= PRIME_TEST_FAILURE_UNIT_LENGTH;
        }
        bool reflected = (flags & PRIME_RC_FLAG_REFLECTION) != 0u;
        float expectedEta = reflected
                ? 1.0
                : (wi.z > 0.0 ? ior : 1.0 / ior);
        if (!primeTestClose(sampled.eta, expectedEta, 1.0e-7, 2.0e-6)) {
            result.mask |= PRIME_TEST_FAILURE_STATE;
        }
        if ((reflected && wi.z * sampled.wo.z <= 0.0)
                || (!reflected && wi.z * sampled.wo.z >= 0.0)) {
            result.mask |= PRIME_TEST_FAILURE_HEMISPHERE;
        }
        if (effectivelySmooth) {
            if ((flags & PRIME_RC_FLAG_DELTA) == 0u
                    || evaluated.flags != PRIME_RC_FLAG_NONE
                    || evaluatedPdf != 0.0) {
                result.mask |= PRIME_TEST_FAILURE_EVENT;
            }
            float microIncident = wi.z;
            PrimeRcVecPair deltaRt = primeRcSpecularFresnelRt(
                    state.specularFresnel,
                    state.wavelengthsNm,
                    state.spectrumed,
                    microIncident);
            vec3 expectedDeltaValue = (flags == PRIME_RC_FLAG_DELTA_TRANSMISSION)
                    ? deltaRt.second * (1.0 / primeRcSquare(sampled.eta))
                    : deltaRt.first;
            if (!primeTestClose(
                    sampled.throughput.value,
                    expectedDeltaValue,
                    3.0e-6,
                    3.0e-5)) {
                result.mask |= PRIME_TEST_FAILURE_VALUE;
            }
        } else {
            if ((flags & PRIME_RC_FLAG_SPECULAR) == 0u) {
                result.mask |= PRIME_TEST_FAILURE_EVENT;
            }
            bool reflected = (flags & PRIME_RC_FLAG_REFLECTION) != 0u;
            float halfVectorLength = length(wi + sampled.eta * sampled.wo);
            bool stableReconstruction = numericInterior
                    && (reflected || abs(ior - 1.0) >= 1.0e-2)
                    && halfVectorLength > 1.0e-3;
            if (stableReconstruction) {
                if (evaluated.flags != flags) {
                    result.mask |= PRIME_TEST_FAILURE_EVENT;
                }
                // Refractive h reconstruction magnifies float error near grazing
                // directions; this remains far below the eta-scale mismatch.
                if (!primeTestClose(sampled.pdf, evaluatedPdf, 3.0e-6, 2.0e-3)) {
                    result.mask |= PRIME_TEST_FAILURE_PDF;
                }
                if (!primeTestClose(
                        sampled.throughput.value,
                        evaluated.value,
                        3.0e-6,
                        2.0e-3)) {
                    result.mask |= PRIME_TEST_FAILURE_VALUE;
                }
            }
        }
    } else if (evaluated.flags != PRIME_RC_FLAG_NONE || evaluatedPdf != 0.0) {
        result.mask |= PRIME_TEST_FAILURE_EVENT;
    }

    result.witness[0] = uvec4(
            floatBitsToUint(sampled.wo.x),
            floatBitsToUint(sampled.wo.y),
            floatBitsToUint(sampled.wo.z),
            flags);
    result.witness[1] = uvec4(
            floatBitsToUint(sampled.pdf),
            floatBitsToUint(evaluatedPdf),
            evaluated.flags,
            effectivelySmooth ? 1u : 0u);
    result.witness[2] = floatBitsToUint(vec4(
            sampled.throughput.value.x,
            evaluated.value.x,
            sampledG2,
            maximumLambda));
}

void primeCoreCommit(
        uint caseIndex,
        uint kind,
        uvec4 encoded[4],
        PrimeCoreResult result) {
    uint outputWords = primeTestOutputWords();
    uint outputOffset = primeTestOutputOffset(caseIndex, outputWords);
    primeTestOutput.words[outputOffset] = uvec4(
            result.mask, kind, caseIndex, 0u);
    if (outputWords >= PRIME_CORE_WITNESS_WORDS) {
        for (uint index = 0u; index < PRIME_CORE_INPUT_WORDS; index++) {
            primeTestOutput.words[outputOffset + 1u + index] = encoded[index];
        }
        for (uint index = 0u; index < 3u; index++) {
            primeTestOutput.words[outputOffset + 5u + index] =
                    result.witness[index];
        }
    }
}

void main() {
    uint caseIndex;
    if (!primeTestBegin(caseIndex)) {
        return;
    }
    uint inputOffset = primeTestInputOffset(caseIndex, PRIME_CORE_INPUT_WORDS);
    uvec4 encoded[4];
    for (uint index = 0u; index < PRIME_CORE_INPUT_WORDS; index++) {
        encoded[index] = primeTestInput.words[inputOffset + index];
    }
    uint kind = encoded[0].x;
    PrimeCoreResult result;
    if (kind == PRIME_CORE_ONB) {
        primeCoreOnb(encoded, result);
    } else if (kind == PRIME_CORE_COMMON) {
        primeCoreCommon(encoded, result);
    } else if (kind == PRIME_CORE_FRESNEL) {
        primeCoreFresnel(encoded, result);
    } else if (kind == PRIME_CORE_REFLECTION) {
        primeCoreReflection(encoded, result);
    } else if (kind == PRIME_CORE_REFRACTION) {
        primeCoreRefraction(encoded, result);
    } else {
        primeCoreClear(result);
        result.mask = PRIME_TEST_FAILURE_STATE;
    }
    if (caseIndex >= primeTestInput.words[0].x) {
        result.mask |= PRIME_TEST_FAILURE_INDEX;
    }
    primeCoreCommit(caseIndex, kind, encoded, result);
}
