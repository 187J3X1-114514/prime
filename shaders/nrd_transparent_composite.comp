#version 460
#extension GL_GOOGLE_include_directive : require

#include "atmosphere.glsl"
#include "nrd_common.glsl"

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 0, binding = 0, rgba16f) uniform image2D primeTransparentSceneColor;
layout(set = 0, binding = 1, rgba16f) uniform readonly image2D primeReflectionDenoised;
layout(set = 0, binding = 2, rgba16f) uniform readonly image2D primeReflectionMetadata;
layout(set = 0, binding = 3, rgba16f) uniform readonly image2D primeReflectionSpecularDenoised;
layout(set = 0, binding = 4, rgba16f) uniform readonly image2D primeReflectionSpecularMaterial;
layout(set = 0, binding = 5, rgba16f) uniform readonly image2D primeReflectionThroughput;
layout(set = 0, binding = 6, rgba16f) uniform readonly image2D primeTransmissionDenoised;
layout(set = 0, binding = 7, rgba16f) uniform readonly image2D primeTransmissionMetadata;
layout(set = 0, binding = 8, rgba16f) uniform readonly image2D primeTransmissionSpecularDenoised;
layout(set = 0, binding = 9, rgba16f) uniform readonly image2D primeTransmissionSpecularMaterial;
layout(set = 0, binding = 10, rgba16f) uniform readonly image2D primeTransmissionThroughput;
layout(set = 0, binding = 11, rgba16f) uniform readonly image3D primeTransparentAerialRadiance;
layout(set = 0, binding = 12, rgba16f) uniform readonly image3D primeTransparentAerialTransmittance;

layout(push_constant) uniform PrimeTransparentCompositePushConstants {
    uvec2 outputExtent;
} primeTransparentCompositePush;

ATM_DECLARE_SAMPLE_3D(
        primeTransparentSampleAerialRadiance,
        primeTransparentAerialRadiance)
ATM_DECLARE_SAMPLE_3D(
        primeTransparentSampleAerialTransmittance,
        primeTransparentAerialTransmittance)

vec3 primeResolveTransparentBranch(
        ivec2 pixel,
        bool reflectionBranch) {
    vec4 metadata = reflectionBranch
            ? imageLoad(primeReflectionMetadata, pixel)
            : imageLoad(primeTransmissionMetadata, pixel);
    // Negative alpha denotes an atmosphere/sun miss. It is deterministic for a fixed camera ray
    // and bypasses NRD; finite virtual surfaces consume their own branch's independent history.
    if (metadata.a < 0.0) {
        return metadata.rgb;
    }
    vec3 diffuse = primeNrdYCoCgToLinear(reflectionBranch
            ? imageLoad(primeReflectionDenoised, pixel).rgb
            : imageLoad(primeTransmissionDenoised, pixel).rgb) * metadata.rgb;
    vec4 specularMaterial = reflectionBranch
            ? imageLoad(primeReflectionSpecularMaterial, pixel)
            : imageLoad(primeTransmissionSpecularMaterial, pixel);
    vec3 specular = primeNrdYCoCgToLinear(reflectionBranch
            ? imageLoad(primeReflectionSpecularDenoised, pixel).rgb
            : imageLoad(primeTransmissionSpecularDenoised, pixel).rgb)
            * specularMaterial.rgb;
    vec3 throughput = (reflectionBranch
            ? imageLoad(primeReflectionThroughput, pixel)
            : imageLoad(primeTransmissionThroughput, pixel)).rgb;
    return throughput * (diffuse + specular);
}

void primeTransparentCompositeApplyAerial(
        uvec2 pixel,
        float primaryDistance,
        inout vec3 radiance) {
    float distanceKm = primaryDistance * ATM_WORLD_UNIT_SCALE_KM;
    ivec3 dimensions = imageSize(primeTransparentAerialRadiance);
    float firstSliceDepth = 0.5 / float(max(dimensions.z, 1));
    float firstSliceDistanceKm = ATM_AERIAL_MAX_DISTANCE_KM
            * firstSliceDepth * firstSliceDepth;
    float normalizedDepth = max(firstSliceDepth, sqrt(clamp(
            distanceKm / max(ATM_AERIAL_MAX_DISTANCE_KM, 1.0e-6), 0.0, 1.0)));
    float nearWeight = clamp(
            distanceKm / max(firstSliceDistanceKm, 1.0e-6), 0.0, 1.0);
    vec2 screenUv = (vec2(pixel) + vec2(0.5))
            / vec2(primeTransparentCompositePush.outputExtent);
    vec3 uvw = vec3(screenUv, normalizedDepth);
    vec3 inscatter = max(
            primeTransparentSampleAerialRadiance(uvw).rgb, vec3(0.0));
    vec3 transmittance = clamp(
            primeTransparentSampleAerialTransmittance(uvw).rgb,
            vec3(0.0),
            vec3(1.0));
    if (any(isnan(inscatter)) || any(isinf(inscatter))) {
        inscatter = vec3(0.0);
    }
    if (any(isnan(transmittance)) || any(isinf(transmittance))) {
        transmittance = vec3(1.0);
    }
    radiance = radiance * mix(vec3(1.0), transmittance, nearWeight)
            + inscatter * nearWeight;
}

void main() {
    uvec2 pixel = gl_GlobalInvocationID.xy;
    if (any(greaterThanEqual(pixel, primeTransparentCompositePush.outputExtent))) {
        return;
    }
    vec4 scene = imageLoad(primeTransparentSceneColor, ivec2(pixel));
    if (scene.a >= 0.0) {
        return;
    }

    vec3 radiance = scene.rgb;
    radiance += primeResolveTransparentBranch(
            ivec2(pixel), true);
    radiance += primeResolveTransparentBranch(
            ivec2(pixel), false);
    primeTransparentCompositeApplyAerial(pixel, -scene.a - 1.0, radiance);
    imageStore(
            primeTransparentSceneColor,
            ivec2(pixel),
            vec4(primeNrdSanitizeRadiance(radiance), 1.0));
}
