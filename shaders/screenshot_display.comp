#version 460
#extension GL_GOOGLE_include_directive : require

#include "display_transform.glsl"

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 0, binding = 0, rgba32f) uniform readonly image2D primeScreenshotRunningMean;
layout(set = 0, binding = 1, rgba8) uniform writeonly image2D primeScreenshotOutput;

layout(push_constant) uniform PrimeScreenshotDisplayPushConstants {
    uvec2 outputExtent;
    float oklabOverexposure;
    uint reserved;
} primeScreenshotDisplayPush;

void main() {
    uvec2 pixel = gl_GlobalInvocationID.xy;
    if (any(greaterThanEqual(pixel, primeScreenshotDisplayPush.outputExtent))) {
        return;
    }
    vec3 radiance = imageLoad(primeScreenshotRunningMean, ivec2(pixel)).rgb;
    if (any(isnan(radiance)) || any(isinf(radiance))) {
        radiance = vec3(0.0);
    }
    // Display conversion is intentionally outside the history: accumulation always remains
    // scene-referred linear Rec.2020, so changing this display control never contaminates it.
    imageStore(
            primeScreenshotOutput,
            ivec2(pixel),
            vec4(primeDisplayTransformToSrgb(
                    max(radiance, vec3(0.0)),
                    primeScreenshotDisplayPush.oklabOverexposure), 1.0));
}
