#version 460
#extension GL_GOOGLE_include_directive : require
#include "common.glsl"
#include "atmosphere_rt.glsl"
#include "nrd_common.glsl"

layout(location = 0) rayPayloadEXT TracePayload primePayload;
layout(location = 1) rayPayloadEXT uint primeShadowOccluded;

#include "sampling.glsl"
#include "bsdf.glsl"
#include "lights.glsl"
#include "integrator.glsl"

void main() {
    uvec2 pixel = gl_LaunchIDEXT.xy;
    IntegratorRecord integrator;
    integrator.sunDirectionIntensity = vec4(
            primePush.sunDirection,
            ATM_SPACE_SUN_INTENSITY);
    integrator.environmentRadiance = vec4(0.0);
    PathState path;
    path.physicalOrigin = primePush.cameraPosition;
    path.bounce = 0u;
    path.traceOrigin = primePush.cameraPosition;
    path.sampleDimension = 0u;
    path.rayDirection = vec3(0.0);
    path.flags = PRIME_PATH_PREVIOUS_DELTA;
    path.throughput = vec3(1.0);
    path.previousBsdfPdf = 0.0;
    path.radiance = vec3(0.0);
    path.pixel = pixel;
    path.sampleIndex = primePush.path.x;
    path.sampleEpoch = primePush.path.y;

    PrimeSampleBase cameraSampleBase = primeMakeSampleBase(path, 0u);
    // NRD describes one camera jitter for the whole frame. Keeping the low-discrepancy sample
    // independent of pixel identity makes the ray projection and NRD's reprojection contract
    // exactly agree; per-pixel lens jitter cannot be represented by its CommonSettings API.
    cameraSampleBase.pixel = uvec2(0u);
    vec2 cameraSample = primeSobolSample2D(
            cameraSampleBase,
            PRIME_SAMPLE_EFFECT_CAMERA,
            PRIME_SAMPLE_DIMENSION_PRIMARY);
    vec2 uv = (vec2(pixel) + cameraSample) / vec2(primePush.outputExtent);
    vec2 ndc = vec2(uv.x * 2.0 - 1.0, uv.y * 2.0 - 1.0);
    vec4 nearPoint = primePush.inverseViewProjection * vec4(ndc, 1.0, 1.0);
    vec4 farPoint = primePush.inverseViewProjection * vec4(ndc, 0.0, 1.0);
    path.rayDirection = normalize(farPoint.xyz / farPoint.w - nearPoint.xyz / nearPoint.w);

    PrimeIntegrationResult sampleResult = primeIntegrate(path, integrator);
    vec4 centerNear = primePush.inverseViewProjection * vec4(0.0, 0.0, 1.0, 1.0);
    vec4 centerFar = primePush.inverseViewProjection * vec4(0.0, 0.0, 0.0, 1.0);
    vec3 cameraForward = normalize(
            centerFar.xyz / centerFar.w - centerNear.xyz / centerNear.w);
    float viewZ = sampleResult.primaryDistance < 0.0
            ? PRIME_NRD_FP16_MAX
            : -sampleResult.primaryDistance * dot(path.rayDirection, cameraForward);
    vec3 materialFactor = sampleResult.primaryHitKind == PRIME_HIT_NONE
            ? vec3(1.0)
            : primeNrdMaterialFactor(sampleResult.primaryBaseColor);
    vec3 demodulatedDiffuse = sampleResult.diffuseRadiance / materialFactor;
    float normalizedHitDistance = sampleResult.diffuseHitDistance <= 0.0
            ? 0.0
            : primeNrdNormalizedDiffuseHitDistance(
                    sampleResult.diffuseHitDistance, viewZ);

    imageStore(
            primeNrdNoisyDiffuse,
            ivec2(pixel),
            primeNrdPackDiffuseSignal(demodulatedDiffuse, normalizedHitDistance));
    imageStore(
            primeNrdNormalRoughness,
            ivec2(pixel),
            primeNrdPackNormalRoughness(
                    sampleResult.primaryNormal, PRIME_NRD_LINEAR_ROUGHNESS));
    imageStore(primeNrdViewZ, ivec2(pixel), vec4(viewZ, 0.0, 0.0, 0.0));
    // Terrain and its acceleration structures are static within a submitted frame. Zero world
    // motion is therefore exact; NRD derives camera motion from the current/previous matrices.
    imageStore(primeNrdMotion, ivec2(pixel), vec4(0.0));
    imageStore(
            primeNrdMaterial,
            ivec2(pixel),
            vec4(materialFactor, sampleResult.primaryDistance));

    vec3 stable = sampleResult.stableRadiance;
    if (path.sampleIndex != 0u) {
        vec3 previous = imageLoad(primeAccumulation, ivec2(pixel)).rgb;
        stable = previous + (stable - previous) / float(path.sampleIndex + 1u);
    }
    imageStore(primeAccumulation, ivec2(pixel), vec4(stable, 1.0));
}
