#version 460
#extension GL_GOOGLE_include_directive : require

#include "sun_shadow_hierarchy.glsl"

layout(local_size_x = 128, local_size_y = 1, local_size_z = 1) in;

const int SUN_SHADOW_CASCADE_COUNT = 5;
const float SUN_SHADOW_MAX_DISTANCE_METERS = 2048.0;
const float SUN_SHADOW_DEPTH_BIAS_METERS = 0.02;
const float SUN_SHADOW_CASCADE_RADIUS_TEXELS = 254.0;
const float SUN_SHADOW_TRAVERSAL_EPSILON = 1.0e-5;

struct PrimeProfileCase {
    vec4 cameraDirection;
    vec4 rayBlocker;
    vec4 intervalDepth;
};

layout(set = 0, binding = 0, std430) readonly buffer PrimeProfileInput {
    PrimeProfileCase values[];
} primeProfileInput;

layout(set = 0, binding = 1, std430) writeonly buffer PrimeProfileOutput {
    float values[];
} primeProfileOutput;

struct PrimeTestAtmospherePush {
    vec4 shadowCameraEnabled;
};

const PrimeTestAtmospherePush atmospherePush =
        PrimeTestAtmospherePush(vec4(0.0, 0.0, 0.0, 1.0));

float sunShadowTexelSize(int cascade) {
    return cascade == 0 ? 0.5
            : (cascade == 1 ? 1.0
            : (cascade == 2 ? 2.0
            : (cascade == 3 ? 4.0 : 8.0)));
}

vec2 sunShadowHierarchyRange(
        int cascade, int level, ivec2 worldNode) {
    float blocker = primeProfileInput
            .values[gl_WorkGroupID.x]
            .rayBlocker.w;
    return vec2(blocker);
}

#include "atmosphere_epipolar_shadow.glsl"

void main() {
    uint caseIndex = gl_WorkGroupID.x;
    PrimeProfileCase value = primeProfileInput.values[caseIndex];
    if (gl_LocalInvocationIndex == 0) {
        sunShadowProfileBasisU = vec3(1.0, 0.0, 0.0);
        sunShadowProfileBasisV = vec3(0.0, 1.0, 0.0);
        sunShadowProfileDirectionToSun = vec3(0.0, 0.0, 1.0);
        sunShadowProfileCamera = value.cameraDirection.xy;
        sunShadowProfileDirection = normalize(value.cameraDirection.zw);
        sunShadowProfileDirectionMax = max(
                abs(sunShadowProfileDirection.x),
                abs(sunShadowProfileDirection.y));
        sunShadowProfileCameraDepth = value.intervalDepth.z;
    }
    barrier();
    if (gl_LocalInvocationIndex < SUN_SHADOW_CASCADE_COUNT) {
        sunShadowBuildProfileCascade(int(gl_LocalInvocationIndex));
    }
    barrier();
    if (gl_LocalInvocationIndex == 0) {
        int outputBase = int(caseIndex) * 7;
        for (int cascade = 0;
                cascade < SUN_SHADOW_CASCADE_COUNT;
                ++cascade) {
            primeProfileOutput.values[outputBase + cascade] =
                    float(sunShadowProfileCounts[cascade]);
        }
        int last = sunShadowProfileCounts[0] - 1;
        primeProfileOutput.values[outputBase + 5] = last >= 0
                ? sunShadowProfileEntries[last].x
                : -1.0;
        primeProfileOutput.values[outputBase + 6] =
                localSunVisibilityInterval(
                        value.rayBlocker.xyz,
                        value.intervalDepth.x,
                        value.intervalDepth.y);
    }
}
