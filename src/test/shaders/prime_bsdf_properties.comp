#version 460
#extension GL_GOOGLE_include_directive : require

#define PRIME_RC_TRANSMISSION_GGX_SET 0
#define PRIME_RC_TRANSMISSION_GGX_BINDING 2
#define PRIME_COLOR_WORKING_SPACE_LINEAR_REC2020_D65 1
#define PRIME_COLOR_TEXTURE_ENCODING_SRGB 1
#define PRIME_COLOR_DISPLAY_ENCODING_SRGB 1
#define PRIME_COLOR_DISPLAY_SPACE_REC709_D65 1
#include "prime_test_abi.glsl"
#include "numerical.glsl"

uint primeAdapterDiagnosticFlags = 0u;

void primeAdapterRecord(uint flags) {
    primeAdapterDiagnosticFlags |= flags;
}

void primeRecordNonFinite(float value) {
    primeAdapterRecord(primeClassifyNonFinite(value));
}

void primeRecordNonFinite(vec3 value) {
    primeAdapterRecord(primeClassifyNonFinite(value));
}

void primeRecordNonnegative(float value) {
    primeAdapterRecord(primeClassifyNonnegative(value));
}

void primeRecordNonnegative(vec3 value) {
    primeAdapterRecord(primeClassifyNonnegative(value));
}

void primeRecordRadiance(vec3 value) {
    primeAdapterRecord(primeClassifyRadiance(value));
}

void primeRecordUnit(float value) {
    primeAdapterRecord(primeClassifyUnit(value));
}

void primeRecordUnit(vec3 value) {
    primeAdapterRecord(primeClassifyUnit(value));
}

void primeRecordDirection(vec3 value) {
    primeAdapterRecord(primeClassifyDirection(value));
}

#include "bsdf.glsl"

const uint PRIME_ADAPTER_INPUT_WORDS = 7u;
const uint PRIME_ADAPTER_WITNESS_WORDS = 12u;

const uint PRIME_ADAPTER_OPAQUE = 0u;
const uint PRIME_ADAPTER_TRANSMISSION = 1u;
const uint PRIME_ADAPTER_FOLIAGE = 2u;
const uint PRIME_ADAPTER_PRIMARY_SPLIT = 3u;

struct PrimeAdapterResult {
    uint mask;
    BsdfSample first;
    BsdfSample second;
    BsdfEvaluation sampledEvaluation;
    BsdfEvaluation probeEvaluation;
    PrimeDenoiseAlbedos albedos;
    uvec2 stackCounts;
};

float primeAdapterFloat(uvec4 encoded[7], uint index) {
    uint flatIndex = index + 4u;
    return uintBitsToFloat(encoded[flatIndex / 4u][flatIndex % 4u]);
}

PrimeRcVolumeStack primeAdapterStack(uint count) {
    PrimeRcVolumeStack stack = primeEmptyVolumeStack();
    PrimeRcVolume volume;
    volume.extinction = vec3(0.01, 0.02, 0.04);
    volume.albedo = vec3(0.0);
    volume.anisotropy = 0.0;
    volume.ior = 1.333;
    primeRcStackPush(stack, volume);
    volume.extinction = vec3(0.02, 0.01, 0.005);
    volume.ior = 1.5;
    primeRcStackPush(stack, volume);
    stack.count = min(count, PRIME_RC_MAX_VOLUME_STACK_SIZE);
    return stack;
}

void primeAdapterClassify(inout uint mask, float value) {
    mask |= primeTestClassify(value);
}

void primeAdapterClassify(inout uint mask, vec3 value) {
    mask |= primeTestClassify(value);
}

bool primeAdapterZero(vec3 value) {
    return all(equal(value, vec3(0.0)));
}

void primeAdapterCheckEvaluation(
        inout uint mask, BsdfEvaluation evaluation) {
    primeAdapterClassify(mask, evaluation.response);
    primeAdapterClassify(mask, evaluation.pdf);
    if (any(lessThan(evaluation.response, vec3(0.0))) || evaluation.pdf < 0.0) {
        mask |= PRIME_TEST_FAILURE_RANGE;
    }
}

void primeAdapterCheckSample(
        inout uint mask,
        BsdfSample sampleValue,
        vec3 outwardNormal,
        vec3 viewDirection) {
    const uint knownEvents = PRIME_BSDF_EVENT_REFLECTION
            | PRIME_BSDF_EVENT_TRANSMISSION
            | PRIME_BSDF_EVENT_DIFFUSE
            | PRIME_BSDF_EVENT_GLOSSY
            | PRIME_BSDF_EVENT_DELTA;
    if (sampleValue.eventFlags == 0u) {
        if (!primeAdapterZero(sampleValue.direction)
                || !primeAdapterZero(sampleValue.response)
                || sampleValue.pdf != 0.0
                || sampleValue.relativeEta != 1.0) {
            mask |= PRIME_TEST_FAILURE_EVENT;
        }
        return;
    }

    primeAdapterClassify(mask, sampleValue.direction);
    primeAdapterClassify(mask, sampleValue.response);
    primeAdapterClassify(mask, sampleValue.pdf);
    primeAdapterClassify(mask, sampleValue.relativeEta);
    if ((sampleValue.eventFlags & ~knownEvents) != 0u
            || ((sampleValue.eventFlags & PRIME_BSDF_EVENT_REFLECTION) != 0u)
                    == ((sampleValue.eventFlags & PRIME_BSDF_EVENT_TRANSMISSION) != 0u)
            || sampleValue.pdf <= 0.0
            || sampleValue.relativeEta <= 0.0
            || any(lessThan(sampleValue.response, vec3(0.0)))) {
        mask |= PRIME_TEST_FAILURE_EVENT;
    }
    uint lobe = sampleValue.eventFlags
            & (PRIME_BSDF_EVENT_DIFFUSE
                    | PRIME_BSDF_EVENT_GLOSSY
                    | PRIME_BSDF_EVENT_DELTA);
    if (lobe == 0u || (lobe & (lobe - 1u)) != 0u) {
        mask |= PRIME_TEST_FAILURE_EVENT;
    }
    if (!primeTestClose(length(sampleValue.direction), 1.0, 8.0e-5, 8.0e-5)) {
        mask |= PRIME_TEST_FAILURE_UNIT_LENGTH;
    }
    float sideProduct = dot(outwardNormal, viewDirection)
            * dot(outwardNormal, sampleValue.direction);
    bool reflected = (sampleValue.eventFlags & PRIME_BSDF_EVENT_REFLECTION) != 0u;
    if ((reflected && sideProduct <= 0.0) || (!reflected && sideProduct >= 0.0)) {
        mask |= PRIME_TEST_FAILURE_HEMISPHERE;
    }
}

void primeAdapterProperties(
        uint kind, uvec4 encoded[7], out PrimeAdapterResult result) {
    result.mask = 0u;
    result.first = primeInvalidBsdfSample();
    result.second = primeInvalidBsdfSample();
    result.sampledEvaluation = primeInvalidBsdfEvaluation();
    result.probeEvaluation = primeInvalidBsdfEvaluation();
    result.albedos.diffuse = vec3(0.0);
    result.albedos.specular = vec3(0.0);
    result.stackCounts = uvec2(0u);

    uint materialFlags = encoded[0].y;
    uint packedNormal = encoded[0].z;
    uint packedSpecular = encoded[0].w;
    vec3 baseColor = vec3(
            primeAdapterFloat(encoded, 0u),
            primeAdapterFloat(encoded, 1u),
            primeAdapterFloat(encoded, 2u));
    float opacity = primeAdapterFloat(encoded, 3u);
    vec3 outwardNormal = normalize(vec3(
            primeAdapterFloat(encoded, 4u),
            primeAdapterFloat(encoded, 5u),
            primeAdapterFloat(encoded, 6u)));
    float rayT = primeAdapterFloat(encoded, 7u);
    vec3 viewDirection = normalize(vec3(
            primeAdapterFloat(encoded, 8u),
            primeAdapterFloat(encoded, 9u),
            primeAdapterFloat(encoded, 10u)));
    uint stackCount = min(encoded[3].w, PRIME_RC_MAX_VOLUME_STACK_SIZE);
    vec3 firstSample = vec3(
            primeAdapterFloat(encoded, 12u),
            primeAdapterFloat(encoded, 13u),
            primeAdapterFloat(encoded, 14u));
    vec3 secondSample = vec3(
            primeAdapterFloat(encoded, 15u),
            primeAdapterFloat(encoded, 16u),
            primeAdapterFloat(encoded, 17u));
    vec3 probeDirection = normalize(vec3(
            primeAdapterFloat(encoded, 18u),
            primeAdapterFloat(encoded, 19u),
            primeAdapterFloat(encoded, 20u)));
    PrimeRcVolumeStack stack = primeAdapterStack(stackCount);

    if (kind == PRIME_ADAPTER_OPAQUE) {
        result.first = primeSampleOpaque(
                baseColor,
                outwardNormal,
                packedNormal,
                packedSpecular,
                materialFlags,
                viewDirection,
                firstSample,
                rayT,
                stack);
        if (result.first.eventFlags != 0u) {
            PrimeBsdfComponents components = primeEvaluateOpaqueComponents(
                    baseColor,
                    outwardNormal,
                    packedNormal,
                    packedSpecular,
                    materialFlags,
                    viewDirection,
                    result.first.direction,
                    rayT,
                    stack);
            result.sampledEvaluation.response =
                    components.diffuseResponse + components.specularResponse;
            result.sampledEvaluation.pdf = components.pdf;
        }
        PrimeBsdfComponents probe = primeEvaluateOpaqueComponents(
                baseColor,
                outwardNormal,
                packedNormal,
                packedSpecular,
                materialFlags,
                viewDirection,
                probeDirection,
                rayT,
                stack);
        result.probeEvaluation.response =
                probe.diffuseResponse + probe.specularResponse;
        result.probeEvaluation.pdf = probe.pdf;
        PrimeRcState state = primeOpaqueState(
                baseColor,
                outwardNormal,
                packedNormal,
                packedSpecular,
                materialFlags,
                viewDirection,
                rayT,
                stack);
        result.albedos = primeDenoiseAlbedosFromState(
                state, viewDirection, PRIME_DENOISE_CLOSURE_OPAQUE);
    } else if (kind == PRIME_ADAPTER_FOLIAGE) {
        result.first = primeSampleMinecraftFoliage(
                baseColor,
                outwardNormal,
                packedNormal,
                packedSpecular,
                materialFlags,
                viewDirection,
                firstSample,
                rayT,
                stack);
        if (result.first.eventFlags != 0u) {
            result.sampledEvaluation = primeEvaluateMinecraftFoliage(
                    baseColor,
                    outwardNormal,
                    packedNormal,
                    packedSpecular,
                    materialFlags,
                    viewDirection,
                    result.first.direction,
                    rayT,
                    stack);
        }
        result.probeEvaluation = primeEvaluateMinecraftFoliage(
                baseColor,
                outwardNormal,
                packedNormal,
                packedSpecular,
                materialFlags,
                viewDirection,
                probeDirection,
                rayT,
                stack);
        PrimeRcState state = primeMinecraftFoliageState(
                baseColor,
                outwardNormal,
                packedNormal,
                packedSpecular,
                materialFlags,
                viewDirection,
                rayT,
                stack);
        result.albedos = primeDenoiseAlbedosFromState(
                state, viewDirection, PRIME_DENOISE_CLOSURE_FOLIAGE);
    } else if (kind == PRIME_ADAPTER_TRANSMISSION) {
        PrimeTransmissiveBsdfSample sampled = primeSampleMinecraftTransmission(
                baseColor,
                opacity,
                outwardNormal,
                materialFlags,
                packedNormal,
                packedSpecular,
                viewDirection,
                firstSample,
                rayT,
                stack);
        result.first = sampled.bsdfSample;
        result.stackCounts.x = sampled.volumeStack.count;
        if (result.first.eventFlags != 0u) {
            result.sampledEvaluation = primeEvaluateMinecraftTransmission(
                    baseColor,
                    opacity,
                    outwardNormal,
                    materialFlags,
                    packedNormal,
                    packedSpecular,
                    viewDirection,
                    result.first.direction,
                    rayT,
                    stack);
        }
        result.probeEvaluation = primeEvaluateMinecraftTransmission(
                baseColor,
                opacity,
                outwardNormal,
                materialFlags,
                packedNormal,
                packedSpecular,
                viewDirection,
                probeDirection,
                rayT,
                stack);
        PrimeRcState state = primeMinecraftTransmissionState(
                baseColor,
                opacity,
                outwardNormal,
                materialFlags,
                packedNormal,
                packedSpecular,
                viewDirection,
                rayT,
                stack);
        result.albedos = primeDenoiseAlbedosFromState(
                state, viewDirection, PRIME_DENOISE_CLOSURE_TRANSMISSIVE);
    } else {
        PrimeTransmissivePrimarySample sampled =
                primeSampleMinecraftTransmissionPrimary(
                baseColor,
                opacity,
                outwardNormal,
                materialFlags,
                packedNormal,
                packedSpecular,
                viewDirection,
                firstSample,
                secondSample,
                rayT,
                stack);
        result.first = sampled.paths.reflection.bsdfSample;
        result.second = sampled.paths.transmission.bsdfSample;
        result.stackCounts = uvec2(
                sampled.paths.reflection.volumeStack.count,
                sampled.paths.transmission.volumeStack.count);
        result.albedos = sampled.albedos;
        if (result.second.eventFlags != 0u) {
            result.sampledEvaluation = primeEvaluateMinecraftTransmissionBranch(
                    baseColor,
                    opacity,
                    outwardNormal,
                    materialFlags,
                    packedNormal,
                    packedSpecular,
                    viewDirection,
                    result.second.direction,
                    rayT,
                    stack);
        }
        result.probeEvaluation = primeEvaluateMinecraftTransmissionBranch(
                baseColor,
                opacity,
                outwardNormal,
                materialFlags,
                packedNormal,
                packedSpecular,
                viewDirection,
                probeDirection,
                rayT,
                stack);
    }

    primeAdapterCheckSample(
            result.mask, result.first, outwardNormal, viewDirection);
    primeAdapterCheckSample(
            result.mask, result.second, outwardNormal, viewDirection);
    primeAdapterCheckEvaluation(result.mask, result.sampledEvaluation);
    primeAdapterCheckEvaluation(result.mask, result.probeEvaluation);
    primeAdapterClassify(result.mask, result.albedos.diffuse);
    primeAdapterClassify(result.mask, result.albedos.specular);
    if (any(lessThan(result.albedos.diffuse, vec3(0.0)))
            || any(greaterThan(result.albedos.diffuse, vec3(1.0)))
            || any(lessThan(result.albedos.specular, vec3(0.0)))
            || any(greaterThan(result.albedos.specular, vec3(1.0)))
            || any(greaterThan(
                    result.stackCounts, uvec2(PRIME_RC_MAX_VOLUME_STACK_SIZE)))) {
        result.mask |= PRIME_TEST_FAILURE_RANGE;
    }

    uint nonFinite = primeAdapterDiagnosticFlags
            & (PRIME_NUMERICAL_NAN
                    | PRIME_NUMERICAL_POSITIVE_INFINITY
                    | PRIME_NUMERICAL_NEGATIVE_INFINITY);
    result.mask |= nonFinite;
    if ((primeAdapterDiagnosticFlags
            & (PRIME_NUMERICAL_FINITE_NEGATIVE
                    | PRIME_NUMERICAL_INVALID_DIRECTION)) != 0u) {
        result.mask |= PRIME_TEST_FAILURE_RANGE;
    }
}

void main() {
    uint caseIndex;
    if (!primeTestBegin(caseIndex)) return;
    uint inputOffset = primeTestInputOffset(caseIndex, PRIME_ADAPTER_INPUT_WORDS);
    uvec4 encoded[7];
    for (uint word = 0u; word < PRIME_ADAPTER_INPUT_WORDS; word++) {
        encoded[word] = primeTestInput.words[inputOffset + word];
    }
    uint kind = encoded[0].x;
    PrimeAdapterResult result;
    primeAdapterProperties(kind, encoded, result);

    uint outputOffset = primeTestOutputOffset(caseIndex, primeTestOutputWords());
    primeTestOutput.words[outputOffset] = uvec4(result.mask, kind, caseIndex, 0u);
    if (!primeTestWitnessEnabled()) return;
    primeTestOutput.words[outputOffset + 1u] = uvec4(
            floatBitsToUint(result.first.direction), result.first.eventFlags);
    primeTestOutput.words[outputOffset + 2u] = uvec4(
            floatBitsToUint(result.first.response), floatBitsToUint(result.first.pdf));
    primeTestOutput.words[outputOffset + 3u] = uvec4(
            floatBitsToUint(result.first.relativeEta),
            result.second.eventFlags,
            result.stackCounts);
    primeTestOutput.words[outputOffset + 4u] = uvec4(
            floatBitsToUint(result.second.direction), 0u);
    primeTestOutput.words[outputOffset + 5u] = uvec4(
            floatBitsToUint(result.second.response), floatBitsToUint(result.second.pdf));
    primeTestOutput.words[outputOffset + 6u] = uvec4(
            floatBitsToUint(result.sampledEvaluation.response),
            floatBitsToUint(result.sampledEvaluation.pdf));
    primeTestOutput.words[outputOffset + 7u] = uvec4(
            floatBitsToUint(result.probeEvaluation.response),
            floatBitsToUint(result.probeEvaluation.pdf));
    primeTestOutput.words[outputOffset + 8u] = uvec4(
            floatBitsToUint(result.albedos.diffuse), primeAdapterDiagnosticFlags);
    primeTestOutput.words[outputOffset + 9u] = uvec4(
            floatBitsToUint(result.albedos.specular), 0u);
    primeTestOutput.words[outputOffset + 10u] = encoded[0];
    primeTestOutput.words[outputOffset + 11u] = encoded[3];
}
