#version 460
#extension GL_GOOGLE_include_directive : require
#extension GL_EXT_control_flow_attributes : require
#if defined(PRIME_ENABLE_SER)
#extension GL_EXT_buffer_reference_uvec2 : require
#extension GL_EXT_shader_invocation_reorder : require
#endif
#include "common.glsl"
#include "atmosphere_rt.glsl"
#include "nrd_common.glsl"

layout(location = 0) rayPayloadEXT TracePayload primePayload;
layout(location = 1) rayPayloadEXT uint primeShadowHitDistanceBits;

#include "sampling.glsl"
#include "bsdf.glsl"
#include "lights.glsl"
#include "integrator.glsl"
#include "camera.glsl"
#include "world_output.glsl"
#include "wavefront_state.glsl"

const uint PRIME_WAVEFRONT_STAGE_HEAD = 0u;
const uint PRIME_WAVEFRONT_STAGE_STEP = 1u;
const uint PRIME_WAVEFRONT_STAGE_TRANSITION = 2u;
const uint PRIME_WAVEFRONT_STAGE_TAIL = 3u;

layout(shaderRecordEXT, std430) buffer PrimeWavefrontShaderRecord {
    uint stage;
} primeWavefrontShaderRecord;

void primeWavefrontHead() {
    uvec2 pixel = gl_LaunchIDEXT.xy;
    uint recordIndex = primeWavefrontIndex(pixel);
    uint maximumBounces = min(primePush.path.z & 0xffffu, 256u);
    primeSetNumericalContext(PRIME_NUMERICAL_STAGE_CAMERA, 0u);

    if (maximumBounces == 0u) {
        vec2 cameraSample = primeCameraSample();
        PathState path = primeCameraPath(pixel, 0u, cameraSample);
        PrimeRcVolumeStack volumeStack =
                (primePush.path.z & PRIME_PATH_CAMERA_IN_WATER_MASK) != 0u
                ? primeCameraWaterVolumeStack()
                : primeEmptyVolumeStack();
        PrimeDenoiserState denoiserState = primeInitialDenoiserState();
        PrimeIntegrationResult result = primeEmptyIntegrationResult();
        primeWavefrontPaths.records[recordIndex] = primeMakeWavefrontRecord(
                path, volumeStack, denoiserState, result, false);
        primeWriteRealtimeOutput(pixel, cameraSample, result);
        return;
    }

    vec2 traceCameraSample = primeCameraSample();
    vec3 traceDirection = primeCameraRayDirection(pixel, traceCameraSample);
    primeSetNumericalContext(PRIME_NUMERICAL_STAGE_TRACE, 0u);
    SurfaceInteraction surface =
            primeTraceSurface(primePush.cameraPosition, traceDirection);

    // Build transport, medium and denoiser state only after SER has executed the primary hit.
    // This keeps the largest realtime records out of the implementation's reorder spill set.
    vec2 cameraSample = primeCameraSample();
    PathState path = primeCameraPath(pixel, 0u, cameraSample);
    IntegratorRecord integrator;
    integrator.sunDirectionIntensity = vec4(
            primePush.sunDirection,
            ATM_SPACE_SUN_INTENSITY * primeSunRadianceMultiplier());
    integrator.environmentRadiance = vec4(0.0);
    PrimeRcVolumeStack volumeStack =
            (primePush.path.z & PRIME_PATH_CAMERA_IN_WATER_MASK) != 0u
            ? primeCameraWaterVolumeStack()
            : primeEmptyVolumeStack();
    PrimeDenoiserState denoiserState = primeInitialDenoiserState();
    PrimeIntegrationResult result = primeEmptyIntegrationResult();
    if (surface.hitKind == PRIME_HIT_SURFACE
            && primeMaterialIsTransmissive(surface.materialFlags)) {
        // The transparent island needs two correlated physical branches and up to three PSR
        // records. It remains invocation-local; retracing its primary interface is cheaper than
        // serializing that large, branch-shared state through every ordinary queue slot.
        result = primeIntegrate(path, integrator);
        primeWavefrontPaths.records[recordIndex] = primeMakeWavefrontRecord(
                path, volumeStack, denoiserState, result, false);
        primeWriteRealtimeOutput(pixel, cameraSample, result);
        return;
    }

    bool continuation = primeIntegrateWavefrontSurface(
            path,
            integrator,
            volumeStack,
            denoiserState,
            result,
            surface,
            false);
    continuation = continuation && path.bounce < maximumBounces;
    PrimeWavefrontPathRecord record = primeMakeWavefrontRecord(
            path, volumeStack, denoiserState, result, continuation);
    primeWavefrontPaths.records[recordIndex] = record;
    if (continuation) {
        primeStoreWavefrontIntermediate(pixel, result);
    } else {
        primeWriteRealtimeOutput(pixel, cameraSample, result);
    }
}

void primeWavefrontStep(bool sunOnlyTail) {
    uvec2 pixel = gl_LaunchIDEXT.xy;
    uint recordIndex = primeWavefrontIndex(pixel);
    if ((floatBitsToUint(
            primeWavefrontPaths.records[recordIndex]
                    .rayDirectionAndDenoiserControl.w)
            & PRIME_WAVEFRONT_ACTIVE_MASK) == 0u) {
        return;
    }
    uint packedDiagnostic = floatBitsToUint(
            primeWavefrontPaths.records[recordIndex]
                    .throughputAndNumericalFlags.w);
    primeRawNumericalFlags =
            packedDiagnostic & PRIME_WAVEFRONT_NUMERICAL_FLAGS_MASK;
    primeRawNumericalFirstContext =
            (packedDiagnostic >> PRIME_WAVEFRONT_NUMERICAL_CONTEXT_SHIFT)
                    & PRIME_WAVEFRONT_NUMERICAL_CONTEXT_MASK;
    uint bounce = floatBitsToUint(
            primeWavefrontPaths.records[recordIndex]
                    .traceOriginAndPathControl.w)
            & PRIME_WAVEFRONT_BYTE_MASK;
    vec3 traceOrigin = primeWavefrontPaths.records[recordIndex]
            .traceOriginAndPathControl.xyz;
    vec3 rayDirection = primeWavefrontPaths.records[recordIndex]
            .rayDirectionAndDenoiserControl.xyz;
    primeSetNumericalContext(PRIME_NUMERICAL_STAGE_TRACE, bounce);
    SurfaceInteraction surface = primeTraceSurface(traceOrigin, rayDirection);

    // Reload after SER so the 112-byte path record and image-backed result are not live state at
    // the reorder point. Only the traversal key and two diagnostic words cross that boundary.
    PrimeWavefrontPathRecord record = primeWavefrontPaths.records[recordIndex];
    PathState path = primeWavefrontPath(pixel, record);
    PrimeRcVolumeStack volumeStack = primeWavefrontVolumeStack(record);
    PrimeIntegrationResult result = primeLoadWavefrontIntermediate(pixel, record);
    PrimeDenoiserState denoiserState =
            primeWavefrontDenoiserState(record, result);
    IntegratorRecord integrator;
    integrator.sunDirectionIntensity = vec4(
            primePush.sunDirection,
            ATM_SPACE_SUN_INTENSITY * primeSunRadianceMultiplier());
    integrator.environmentRadiance = vec4(0.0);

    bool continuation = primeIntegrateWavefrontSurface(
            path,
            integrator,
            volumeStack,
            denoiserState,
            result,
            surface,
            sunOnlyTail);
    uint maximumBounces = min(primePush.path.z & 0xffffu, 256u);
    continuation = continuation && path.bounce < maximumBounces;
    primeUpdateWavefrontRecord(
            record, path, volumeStack, denoiserState, continuation);
    primeWavefrontPaths.records[recordIndex] = record;
    if (continuation) {
        primeStoreWavefrontIntermediate(pixel, result);
    } else {
        primeWriteRealtimeOutput(pixel, primeCameraSample(), result);
    }
}

void primeWavefrontTail() {
    uvec2 pixel = gl_LaunchIDEXT.xy;
    uint recordIndex = primeWavefrontIndex(pixel);
    PrimeWavefrontPathRecord record =
            primeWavefrontPaths.records[recordIndex];
    if (!primeWavefrontActive(record)) {
        return;
    }
    primeRestoreWavefrontDiagnostic(record);

    PathState path = primeWavefrontPath(pixel, record);
    PrimeRcVolumeStack volumeStack = primeWavefrontVolumeStack(record);
    PrimeIntegrationResult result =
            primeLoadWavefrontIntermediate(pixel, record);
    PrimeDenoiserState denoiserState =
            primeWavefrontDenoiserState(record, result);
    IntegratorRecord integrator;
    integrator.sunDirectionIntensity = vec4(
            primePush.sunDirection,
            ATM_SPACE_SUN_INTENSITY * primeSunRadianceMultiplier());
    integrator.environmentRadiance = vec4(0.0);
    uint maximumBounces = min(primePush.path.z & 0xffffu, 256u);

    // Paths reaching this point are sparse and incoherent. Finish them locally so queue traffic
    // remains bounded; retain sun NEE but never sample the area-light tree.
    [[dont_unroll]]
    while (path.bounce < maximumBounces) {
        primeSetNumericalContext(
                PRIME_NUMERICAL_STAGE_TRACE, path.bounce);
        SurfaceInteraction surface = primeTraceSurfaceWithoutReorder(
                path.traceOrigin, path.rayDirection);
        if (!primeIntegrateWavefrontSurface(
                path,
                integrator,
                volumeStack,
                denoiserState,
                result,
                surface,
                true)) {
            break;
        }
    }
    primeSetWavefrontActive(record, false);
    primeWavefrontPaths.records[recordIndex] = record;
    primeWriteRealtimeOutput(pixel, primeCameraSample(), result);
}

void main() {
    switch (primeWavefrontShaderRecord.stage) {
        case PRIME_WAVEFRONT_STAGE_HEAD:
            primeWavefrontHead();
            break;
        case PRIME_WAVEFRONT_STAGE_STEP:
            primeWavefrontStep(false);
            break;
        case PRIME_WAVEFRONT_STAGE_TRANSITION:
            primeWavefrontStep(true);
            break;
        case PRIME_WAVEFRONT_STAGE_TAIL:
            primeWavefrontTail();
            break;
    }
}
