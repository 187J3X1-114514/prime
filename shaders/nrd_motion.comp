#version 460
#extension GL_GOOGLE_include_directive : require

#include "default_material.glsl"
#include "nrd_common.glsl"
#include "prime_nrd_motion_contract.glsl"

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 0, binding = 0, rgba16f) uniform writeonly image2D primeMotion;
layout(set = 0, binding = 1, r32f) uniform image2D primeViewZ;
layout(set = 0, binding = 2, rgba32f) uniform readonly image2D primePrimaryPosition;
layout(set = 0, binding = 3, rgba16f) uniform writeonly image2D primeReprojectionError;
layout(set = 0, binding = 4, r32f) uniform writeonly image2D primeFsrDepth;
layout(set = 0, binding = 5, rgba16f) uniform image2D primeNoisyDiffuse;
layout(set = 0, binding = 6, rgba16f) uniform image2D primeNoisySpecular;
layout(set = 0, binding = 7, rgb10_a2) uniform image2D primeNormalRoughness;
layout(set = 0, binding = 8, rgba16f) uniform image2D primeMaterial;
layout(set = 0, binding = 9, rgba16f) uniform image2D primeSpecularMaterial;
layout(set = 0, binding = 10, rgba16f) uniform image2D primeDiffuseDirection;
layout(set = 0, binding = 11, rgba16f) uniform image2D primeSpecularDirection;

layout(set = 0, binding = 12, rgba16f) uniform writeonly image2D primeReflectionMotion;
layout(set = 0, binding = 13, r32f) uniform image2D primeReflectionViewZ;
layout(set = 0, binding = 14, rgba32f) uniform readonly image2D primeReflectionPosition;
layout(set = 0, binding = 15, rgba16f) uniform image2D primeReflectionNoisyDiffuse;
layout(set = 0, binding = 16, rgba16f) uniform image2D primeReflectionNoisySpecular;
layout(set = 0, binding = 17, rgb10_a2) uniform image2D primeReflectionNormalRoughness;
layout(set = 0, binding = 18, rgba16f) uniform image2D primeReflectionMaterial;
layout(set = 0, binding = 19, rgba16f) uniform image2D primeReflectionSpecularMaterial;
layout(set = 0, binding = 20, rgba16f) uniform image2D primeReflectionDiffuseDirection;
layout(set = 0, binding = 21, rgba16f) uniform image2D primeReflectionSpecularDirection;
layout(set = 0, binding = 22, rgba32f) uniform readonly image2D primeDisplayPosition;
layout(set = 0, binding = 23, rgba16f) uniform writeonly image2D primeFsrMotion;

const float PRIME_MOTION_SKY_VIEW_Z = 65504.0;
const float PRIME_FSR_NEAR_PLANE = 0.05;
const uint PRIME_DIAGNOSTIC_REPROJECTION_ERROR = 2u;

vec3 primeMotionRayDirection(vec2 screenUv) {
    vec2 clipXY = screenUv * vec2(2.0, -2.0) + vec2(-1.0, 1.0);
    vec4 nearPoint = primeMotionPush.currentClipToWorld * vec4(clipXY, 1.0, 1.0);
    vec4 farPoint = primeMotionPush.currentClipToWorld * vec4(clipXY, 0.0, 1.0);
    return normalize(farPoint.xyz / farPoint.w - nearPoint.xyz / nearPoint.w);
}

vec2 primeMotionSampleUv(ivec2 pixel, ivec2 extent) {
    return (vec2(pixel) + vec2(0.5) + primeMotionPush.currentJitterPixels)
            / vec2(extent);
}

vec4 primeLoadMaterial(ivec2 pixel, bool reflection) {
    return reflection
            ? imageLoad(primeReflectionMaterial, pixel)
            : imageLoad(primeMaterial, pixel);
}

vec4 primeLoadSpecularMaterial(ivec2 pixel, bool reflection) {
    return reflection
            ? imageLoad(primeReflectionSpecularMaterial, pixel)
            : imageLoad(primeSpecularMaterial, pixel);
}

vec4 primeLoadPosition(ivec2 pixel, bool reflection) {
    return reflection
            ? imageLoad(primeReflectionPosition, pixel)
            : imageLoad(primePrimaryPosition, pixel);
}

vec4 primeLoadDiffuse(ivec2 pixel, bool reflection) {
    return reflection
            ? imageLoad(primeReflectionNoisyDiffuse, pixel)
            : imageLoad(primeNoisyDiffuse, pixel);
}

vec4 primeLoadSpecular(ivec2 pixel, bool reflection) {
    return reflection
            ? imageLoad(primeReflectionNoisySpecular, pixel)
            : imageLoad(primeNoisySpecular, pixel);
}

vec4 primeLoadPackedNormal(ivec2 pixel, bool reflection) {
    return reflection
            ? imageLoad(primeReflectionNormalRoughness, pixel)
            : imageLoad(primeNormalRoughness, pixel);
}

vec3 primeLoadDiffuseDirection(ivec2 pixel, bool reflection) {
    return reflection
            ? imageLoad(primeReflectionDiffuseDirection, pixel).xyz
            : imageLoad(primeDiffuseDirection, pixel).xyz;
}

vec3 primeLoadSpecularDirection(ivec2 pixel, bool reflection) {
    return reflection
            ? imageLoad(primeReflectionSpecularDirection, pixel).xyz
            : imageLoad(primeSpecularDirection, pixel).xyz;
}

void primeStoreMotion(ivec2 pixel, bool reflection, vec4 value) {
    if (reflection) imageStore(primeReflectionMotion, pixel, value);
    else imageStore(primeMotion, pixel, value);
}

void primeStoreViewZ(ivec2 pixel, bool reflection, float value) {
    if (reflection) imageStore(primeReflectionViewZ, pixel, vec4(value));
    else imageStore(primeViewZ, pixel, vec4(value));
}

void primeStoreDiffuse(ivec2 pixel, bool reflection, vec4 value) {
    if (reflection) imageStore(primeReflectionNoisyDiffuse, pixel, value);
    else imageStore(primeNoisyDiffuse, pixel, value);
}

void primeStoreSpecular(ivec2 pixel, bool reflection, vec4 value) {
    if (reflection) imageStore(primeReflectionNoisySpecular, pixel, value);
    else imageStore(primeNoisySpecular, pixel, value);
}

void primeStoreNormal(ivec2 pixel, bool reflection, vec4 value) {
    if (reflection) imageStore(primeReflectionNormalRoughness, pixel, value);
    else imageStore(primeNormalRoughness, pixel, value);
}

void primeStoreMaterial(ivec2 pixel, bool reflection, vec4 value) {
    if (reflection) imageStore(primeReflectionMaterial, pixel, value);
    else imageStore(primeMaterial, pixel, value);
}

void primeStoreSpecularMaterial(ivec2 pixel, bool reflection, vec4 value) {
    if (reflection) imageStore(primeReflectionSpecularMaterial, pixel, value);
    else imageStore(primeSpecularMaterial, pixel, value);
}

void primeStoreDiffuseDirection(ivec2 pixel, bool reflection, vec4 value) {
    if (reflection) imageStore(primeReflectionDiffuseDirection, pixel, value);
    else imageStore(primeDiffuseDirection, pixel, value);
}

void primeStoreSpecularDirection(ivec2 pixel, bool reflection, vec4 value) {
    if (reflection) imageStore(primeReflectionSpecularDirection, pixel, value);
    else imageStore(primeSpecularDirection, pixel, value);
}

void primeClearBranch(ivec2 pixel, bool reflection) {
    primeStoreDiffuse(pixel, reflection, vec4(0.0));
    primeStoreSpecular(pixel, reflection, vec4(0.0));
    primeStoreDiffuseDirection(pixel, reflection, vec4(0.0));
    primeStoreSpecularDirection(pixel, reflection, vec4(0.0));
    primeStoreNormal(pixel, reflection, vec4(
            0.5, 0.5, PRIME_DEFAULT_REFERENCE_LINEAR_ROUGHNESS * 0.5 + 0.5, 0.0));
    primeStoreViewZ(pixel, reflection, PRIME_MOTION_SKY_VIEW_Z);
    primeStoreMotion(pixel, reflection, vec4(0.0));
    primeStoreMaterial(pixel, reflection, vec4(1.0, 1.0, 1.0, -1.0));
    primeStoreSpecularMaterial(pixel, reflection, vec4(1.0, 1.0, 1.0, 0.0));
}

void primePrepareBranch(
        ivec2 pixel,
        ivec2 extent,
        vec2 currentSampleUv,
        vec3 cameraForward,
        bool reflection) {
    vec4 rawMaterial = primeLoadMaterial(pixel, reflection);
    float primaryDistance = rawMaterial.a;
    if (!primeNrdIsFinite(primaryDistance) || primaryDistance < 0.0) {
        primeClearBranch(pixel, reflection);
        return;
    }

    vec4 rawPosition = primeLoadPosition(pixel, reflection);
    vec3 position = rawPosition.xyz;
    bool directional = reflection && rawPosition.w > 0.5;
    float currentViewZ = directional
            ? dot(primeMotionRayDirection(currentSampleUv) * primaryDistance, cameraForward)
            : dot(position, cameraForward);
    currentViewZ = primeNrdIsFinite(currentViewZ) && currentViewZ > 0.0
            ? min(currentViewZ, PRIME_MOTION_SKY_VIEW_Z)
            : PRIME_MOTION_SKY_VIEW_Z;

    // Finish matrix work before loading material and lighting vectors. Position and clip
    // temporaries then die before demodulation, keeping the two largest live ranges disjoint.
    vec4 previousClip = primeMotionPush.previousWorldToClip
            * vec4(position, directional ? 0.0 : 1.0);
    bool validPreviousClip = abs(previousClip.w) > 1.0e-6
            && !any(isnan(previousClip)) && !any(isinf(previousClip));
    vec2 previousUv = vec2(0.0);
    if (validPreviousClip) {
        previousUv = previousClip.xy / previousClip.w
                * vec2(0.5, -0.5) + vec2(0.5);
        primeStoreMotion(pixel, reflection, vec4(primeNrdSanitizeMotion(vec3(
                (previousUv - currentSampleUv) * vec2(extent),
                directional ? 0.0 : abs(previousClip.w) - currentViewZ)), 0.0));
    } else {
        primeStoreMotion(pixel, reflection, vec4(0.0));
    }
    if (validPreviousClip
            && !reflection
            && primeMotionPush.diagnosticMode == PRIME_DIAGNOSTIC_REPROJECTION_ERROR) {
        vec4 exactPreviousClip = primeMotionPush.previousRenderedWorldToClip
                * vec4(position, directional ? 0.0 : 1.0);
        vec3 error = vec3(1.0);
        if (abs(exactPreviousClip.w) > 1.0e-6
                && !any(isnan(exactPreviousClip)) && !any(isinf(exactPreviousClip))) {
            vec2 exactUv = exactPreviousClip.xy / exactPreviousClip.w
                    * vec2(0.5) + vec2(0.5);
            vec2 pixels = (previousUv - exactUv) * vec2(extent);
            error = vec3(max(pixels.x, 0.0), max(pixels.y, 0.0), 0.0)
                    + vec3(max(-pixels.y, 0.0), max(-pixels.x, 0.0), max(-pixels.x, 0.0));
            float depthError = directional
                    ? 0.0
                    : abs(abs(previousClip.w) - abs(exactPreviousClip.w));
            error = (error + depthError) * 0.25;
        }
        imageStore(primeReprojectionError, pixel, vec4(clamp(error, 0.0, 1.0), 1.0));
    }

    vec4 rawSpecularMaterial = primeLoadSpecularMaterial(pixel, reflection);
    vec3 normal;
    float roughness;
    primeNrdUnpackNormalRoughness(
            primeLoadPackedNormal(pixel, reflection), normal, roughness);
    // Raygen owns this private pre-NRD contract: these albedos, hit distances, packed normals and
    // direction moments are already finite and range-limited. Revalidating them here doubles the
    // full-screen scalar work and extends every raw vector's lifetime.
    vec3 diffuseAlbedo = rawMaterial.rgb;
    vec3 specularAlbedo = rawSpecularMaterial.rgb;
    vec4 rawDiffuse = primeLoadDiffuse(pixel, reflection);
    vec4 rawSpecular = primeLoadSpecular(pixel, reflection);
    float diffuseHitT = rawDiffuse.a;
    float specularHitT = rawSpecular.a;
    vec3 diffuse = primeNrdDemodulateSanitized(rawDiffuse.rgb, diffuseAlbedo);
    vec3 specular = primeNrdDemodulateSanitized(rawSpecular.rgb, specularAlbedo);
    primeNrdClampSanitizedRadiancePair(diffuse, specular, PRIME_NRD_FP16_MAX);
    primeStoreDiffuse(pixel, reflection, primeNrdPackSanitizedRadianceAndHitDistance(
            diffuse,
            diffuseHitT <= 0.0 ? 0.0
                    : primeNrdNormalizedSanitizedHitDistance(
                            diffuseHitT, currentViewZ, 1.0)));
    vec3 diffuseDirection = primeLoadDiffuseDirection(pixel, reflection);
    primeStoreDiffuseDirection(pixel, reflection, vec4(
            diffuseDirection * primeNrdY(diffuse), 0.0));
    primeStoreSpecular(pixel, reflection, primeNrdPackSanitizedRadianceAndHitDistance(
            specular,
            specularHitT <= 0.0 ? 0.0
                    : primeNrdNormalizedSanitizedHitDistance(
                            specularHitT, currentViewZ, roughness)));
    vec3 specularDirection = primeLoadSpecularDirection(pixel, reflection);
    primeStoreSpecularDirection(pixel, reflection, vec4(
            specularDirection * primeNrdY(specular), 0.0));
    primeStoreViewZ(pixel, reflection, currentViewZ);
    float composition = reflection
            ? 0.0
            : primeFsrTransparencyAndCompositionMask(
                    floatBitsToUint(imageLoad(primeDisplayPosition, pixel).w));
    primeStoreSpecularMaterial(pixel, reflection, vec4(specularAlbedo, composition));
}

void primePrepareFsrGuide(
        ivec2 pixel,
        ivec2 extent,
        vec4 display,
        vec2 currentSampleUv,
        vec3 cameraForward) {
    vec3 position = display.xyz;
    if (all(equal(position, vec3(0.0)))) {
        vec3 rayDirection = primeMotionRayDirection(currentSampleUv);
        vec4 previousClip = primeMotionPush.previousWorldToClip * vec4(rayDirection, 0.0);
        vec2 motion = vec2(0.0);
        if (abs(previousClip.w) > 1.0e-6
                && !any(isnan(previousClip)) && !any(isinf(previousClip))) {
            vec2 previousUv = previousClip.xy / previousClip.w
                    * vec2(0.5, -0.5) + vec2(0.5);
            motion = previousUv - currentSampleUv;
        }
        imageStore(primeFsrMotion, pixel, vec4(primeNrdSanitizeMotion(vec3(motion, 0.0)), 0.0));
        imageStore(primeFsrDepth, pixel, vec4(0.0));
        return;
    }

    float viewZ = dot(position, cameraForward);
    viewZ = primeNrdIsFinite(viewZ) && viewZ > 0.0
            ? min(viewZ, PRIME_MOTION_SKY_VIEW_Z) : PRIME_MOTION_SKY_VIEW_Z;
    imageStore(primeFsrDepth, pixel, vec4(PRIME_FSR_NEAR_PLANE / viewZ));
    vec4 previousClip = primeMotionPush.previousWorldToClip * vec4(position, 1.0);
    vec3 motion = vec3(0.0);
    if (abs(previousClip.w) > 1.0e-6
            && !any(isnan(previousClip)) && !any(isinf(previousClip))) {
        vec2 previousUv = previousClip.xy / previousClip.w
                * vec2(0.5, -0.5) + vec2(0.5);
        motion = vec3(previousUv - currentSampleUv, abs(previousClip.w) - viewZ);
    }
    imageStore(primeFsrMotion, pixel, vec4(primeNrdSanitizeMotion(motion), 0.0));
}

void main() {
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    ivec2 extent = imageSize(primeViewZ);
    if (any(greaterThanEqual(pixel, extent))) return;
    if (primeMotionPush.diagnosticMode == PRIME_DIAGNOSTIC_REPROJECTION_ERROR) {
        // Invalid or sky reprojections have no error sample. Overwrite the shared diagnostic
        // target so switching from raw numerical views cannot expose stale metadata.
        imageStore(primeReprojectionError, pixel, vec4(0.0, 0.0, 0.0, 1.0));
    }
    vec2 currentSampleUv = primeMotionSampleUv(pixel, extent);
    vec4 display = imageLoad(primeDisplayPosition, pixel);
    bool sky = all(equal(display.xyz, vec3(0.0)));
    // Surface branches and the FSR depth guide share the same center ray. Sky only needs its
    // per-pixel direction, avoiding an otherwise unused matrix reconstruction.
    vec3 cameraForward = sky
            ? vec3(0.0, 0.0, 1.0)
            : primeMotionRayDirection(vec2(0.5));
    primePrepareBranch(pixel, extent, currentSampleUv, cameraForward, false);
    primePrepareBranch(pixel, extent, currentSampleUv, cameraForward, true);
    primePrepareFsrGuide(pixel, extent, display, currentSampleUv, cameraForward);
}
