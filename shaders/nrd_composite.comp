#version 460
#extension GL_GOOGLE_include_directive : require

#define PRIME_COLOR_WORKING_SPACE_LINEAR_REC2020_D65 1
#define PRIME_COLOR_TEXTURE_ENCODING_SRGB 1
#define PRIME_COLOR_DISPLAY_ENCODING_SRGB 1
#define PRIME_COLOR_DISPLAY_SPACE_REC709_D65 1
#define PRIME_COLOR_DISPLAY_TRANSFORM_OKLAB_DRT 1
#include "display_transform.glsl"
#include "atmosphere.glsl"
#include "nrd_common.glsl"

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 0, binding = 0, rgba8) uniform writeonly image2D primeCompositeOutput;
layout(set = 0, binding = 1, rgba16f) uniform readonly image2D primeDenoisedDiffuse;
layout(set = 0, binding = 2, rgba16f) uniform readonly image2D primeCompositeMaterial;
layout(set = 0, binding = 3, rgba32f) uniform readonly image2D primeStableAccumulation;
layout(set = 0, binding = 4, rgba16f) uniform readonly image3D primeCompositeAerialRadiance;
layout(set = 0, binding = 5, rgba16f) uniform readonly image3D primeCompositeAerialTransmittance;
layout(set = 0, binding = 6, rgba8) uniform readonly image2D primeNrdValidation;
layout(set = 0, binding = 7, rgba16f) uniform readonly image2D primeReprojectionError;
layout(set = 0, binding = 8, rgba16f) uniform readonly image2D primeMotionDiagnostic;

layout(push_constant) uniform PrimeCompositePushConstants {
    uvec2 outputExtent;
    uint diagnosticMode;
} primeCompositePush;

const uint PRIME_DIAGNOSTIC_OFF = 0u;
const uint PRIME_DIAGNOSTIC_NRD_VALIDATION = 1u;
const uint PRIME_DIAGNOSTIC_REPROJECTION_ERROR = 2u;
const uint PRIME_DIAGNOSTIC_MOTION = 3u;

ATM_DECLARE_SAMPLE_3D(primeCompositeSampleAerialRadiance, primeCompositeAerialRadiance)
ATM_DECLARE_SAMPLE_3D(primeCompositeSampleAerialTransmittance, primeCompositeAerialTransmittance)

vec3 primeCompositeSurfaceDiffuse(vec4 material, vec3 denoisedSignal) {
    // A negative primary distance is raygen's immutable miss marker. Sky radiance lives entirely
    // in primeStableAccumulation and must never consume REBLUR output: NRD treats its out-of-range
    // view-Z as invalid and is not required to erase surface history when a pixel becomes sky.
    if (material.a < 0.0) {
        return vec3(0.0);
    }
    return primeNrdYCoCgToLinear(denoisedSignal) * material.rgb;
}

void primeCompositeApplyAerial(uvec2 pixel, float primaryDistance, inout vec3 radiance) {
    if (primaryDistance < 0.0) {
        return;
    }
    float distanceKm = primaryDistance * ATM_WORLD_UNIT_SCALE_KM;
    ivec3 dimensions = imageSize(primeCompositeAerialRadiance);
    float firstSliceDepth = 0.5 / float(max(dimensions.z, 1));
    float firstSliceDistanceKm = ATM_AERIAL_MAX_DISTANCE_KM * firstSliceDepth * firstSliceDepth;
    float normalizedDepth = max(firstSliceDepth, sqrt(clamp(
            distanceKm / max(ATM_AERIAL_MAX_DISTANCE_KM, 1.0e-6), 0.0, 1.0)));
    float nearWeight = clamp(distanceKm / max(firstSliceDistanceKm, 1.0e-6), 0.0, 1.0);
    vec2 screenUv = (vec2(pixel) + vec2(0.5)) / vec2(primeCompositePush.outputExtent);
    vec3 uvw = vec3(screenUv, normalizedDepth);
    vec3 inscatter = max(primeCompositeSampleAerialRadiance(uvw).rgb, vec3(0.0));
    vec3 transmittance = clamp(
            primeCompositeSampleAerialTransmittance(uvw).rgb, vec3(0.0), vec3(1.0));
    if (any(isnan(inscatter)) || any(isinf(inscatter))) {
        inscatter = vec3(0.0);
    }
    if (any(isnan(transmittance)) || any(isinf(transmittance))) {
        transmittance = vec3(1.0);
    }
    radiance = radiance * mix(vec3(1.0), transmittance, nearWeight)
            + inscatter * nearWeight;
}

void main() {
    uvec2 pixel = gl_GlobalInvocationID.xy;
    if (any(greaterThanEqual(pixel, primeCompositePush.outputExtent))) {
        return;
    }
    if (primeCompositePush.diagnosticMode == PRIME_DIAGNOSTIC_NRD_VALIDATION) {
        imageStore(
                primeCompositeOutput,
                ivec2(pixel),
                vec4(imageLoad(primeNrdValidation, ivec2(pixel)).rgb, 1.0));
        return;
    }
    if (primeCompositePush.diagnosticMode == PRIME_DIAGNOSTIC_REPROJECTION_ERROR) {
        imageStore(
                primeCompositeOutput,
                ivec2(pixel),
                vec4(imageLoad(primeReprojectionError, ivec2(pixel)).rgb, 1.0));
        return;
    }
    if (primeCompositePush.diagnosticMode == PRIME_DIAGNOSTIC_MOTION) {
        vec3 motion = imageLoad(primeMotionDiagnostic, ivec2(pixel)).xyz;
        vec2 motionPixels = motion.xy * vec2(primeCompositePush.outputExtent);
        vec3 positiveColor = max(motionPixels.x, 0.0) * vec3(1.0, 0.0, 0.0)
                + max(motionPixels.y, 0.0) * vec3(0.0, 1.0, 0.0);
        vec3 negativeColor = max(-motionPixels.x, 0.0) * vec3(0.0, 1.0, 1.0)
                + max(-motionPixels.y, 0.0) * vec3(1.0, 0.0, 1.0);
        vec3 motionColor = (positiveColor + negativeColor + abs(motion.z)) * 0.25;
        imageStore(
                primeCompositeOutput,
                ivec2(pixel),
                vec4(clamp(motionColor, vec3(0.0), vec3(1.0)), 1.0));
        return;
    }
    vec4 material = imageLoad(primeCompositeMaterial, ivec2(pixel));
    vec3 diffuse = primeCompositeSurfaceDiffuse(
            material,
            imageLoad(primeDenoisedDiffuse, ivec2(pixel)).rgb);
    vec3 radiance = diffuse + imageLoad(primeStableAccumulation, ivec2(pixel)).rgb;
    primeCompositeApplyAerial(pixel, material.a, radiance);
    if (any(isnan(radiance)) || any(isinf(radiance))) {
        radiance = vec3(0.0);
    }
    imageStore(
            primeCompositeOutput,
            ivec2(pixel),
            vec4(primeDisplayTransformToSrgb(max(radiance, vec3(0.0))), 1.0));
}
