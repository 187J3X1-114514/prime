#version 460
#extension GL_GOOGLE_include_directive : require
#include "hit_common.glsl"

void main() {
    PrimitiveRecord primitive = primePrimitive();
    vec3 normal = primeUnpackOctahedralNormal(primitive.normal);
    float textureLodValue = primeRayConeTextureLod(primitive, normal);
    float opacity = primeEvaluateOpacity(primeInterpolateUv(primitive), textureLodValue);
    if (opacity < PRIME_CUTOUT_ALPHA_THRESHOLD) {
        ignoreIntersectionEXT;
    }
}
