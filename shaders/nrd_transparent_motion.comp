#version 460
#extension GL_GOOGLE_include_directive : require

#include "default_material.glsl"
#include "nrd_common.glsl"

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 0, binding = 0, rgba16f) uniform writeonly image2D primeMotion;
layout(set = 0, binding = 1, r32f) uniform writeonly image2D primeViewZ;
layout(set = 0, binding = 2, rgba32f) uniform readonly image2D primeGuidePosition;
layout(set = 0, binding = 3, rgba16f) uniform readonly image2D primeInterface;
layout(set = 0, binding = 4, rgba16f) uniform readonly image2D primePathThroughput;
layout(set = 0, binding = 5, rgba16f) uniform image2D primeNoisyDiffuse;
layout(set = 0, binding = 6, rgba16f) uniform image2D primeNoisySpecular;
layout(set = 0, binding = 7, rgb10_a2) uniform writeonly image2D primeNormalRoughness;
layout(set = 0, binding = 8, rgba16f) uniform image2D primeMetadata;
layout(set = 0, binding = 9, rgba16f) uniform image2D primeGuideMaterial;

layout(push_constant) uniform PrimeTransparentMotionPushConstants {
    mat4 currentClipToWorld;
    mat4 previousWorldToClip;
    // Opaque preparation uses this slot for its independent reprojection diagnostic matrix.
    // Transparent preparation only needs column one xy for the current centered source-pixel
    // jitter. Raygen has already solved the complete delta chain into current and previous virtual
    // positions; keeping this shared 192-byte ABI avoids a second compute pipeline layout.
    mat4 previousRenderedWorldToClipOrTransparentState;
} primeMotionPush;

const float PRIME_TRANSPARENT_SKY_VIEW_Z = 65504.0;

vec2 primeTransparentSignNotZero(vec2 value) {
    return vec2(value.x >= 0.0 ? 1.0 : -1.0, value.y >= 0.0 ? 1.0 : -1.0);
}

vec3 primeUnpackTransparentDirection(float packedValue) {
    vec2 encoded = unpackSnorm2x16(floatBitsToUint(packedValue));
    vec3 normal = vec3(encoded, 1.0 - abs(encoded.x) - abs(encoded.y));
    if (normal.z < 0.0) {
        normal.xy = (1.0 - abs(normal.yx))
                * primeTransparentSignNotZero(normal.xy);
    }
    return normalize(normal);
}

vec3 primeTransparentMotionRayDirection(vec2 screenUv) {
    vec2 clipXY = screenUv * vec2(2.0, -2.0) + vec2(-1.0, 1.0);
    vec4 nearPoint = primeMotionPush.currentClipToWorld * vec4(clipXY, 1.0, 1.0);
    vec4 farPoint = primeMotionPush.currentClipToWorld * vec4(clipXY, 0.0, 1.0);
    return normalize(farPoint.xyz / farPoint.w - nearPoint.xyz / nearPoint.w);
}

void primeStoreInvalidTransparentGuide(ivec2 pixel, vec3 rawRadiance) {
    imageStore(primeNoisyDiffuse, pixel, vec4(0.0));
    imageStore(primeNoisySpecular, pixel, vec4(0.0));
    imageStore(
            primeNormalRoughness,
            pixel,
            primeNrdPackNormalRoughness(vec3(0.0, 0.0, 1.0), 1.0));
    imageStore(primeViewZ, pixel, vec4(PRIME_TRANSPARENT_SKY_VIEW_Z));
    imageStore(primeMotion, pixel, vec4(0.0));
    imageStore(primeMetadata, pixel, vec4(rawRadiance, -1.0));
}

void main() {
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    ivec2 extent = imageSize(primeViewZ);
    if (any(greaterThanEqual(pixel, extent))) {
        return;
    }

    vec4 metadata = imageLoad(primeMetadata, pixel);
    vec4 rawDiffuse = imageLoad(primeNoisyDiffuse, pixel);
    vec4 rawSpecular = imageLoad(primeNoisySpecular, pixel);
    vec4 guidePositionData = imageLoad(primeGuidePosition, pixel);
    vec4 guide = imageLoad(primeGuideMaterial, pixel);
    vec4 interfaceData = imageLoad(primeInterface, pixel);
    vec4 pathThroughput = imageLoad(primePathThroughput, pixel);
    if (metadata.a < 0.0) {
        // Deterministic atmosphere/sun misses bypass NRD and remain directly summable.
        imageStore(primeNoisyDiffuse, pixel, vec4(0.0));
        imageStore(primeNoisySpecular, pixel, vec4(0.0));
        imageStore(
                primeNormalRoughness,
                pixel,
                primeNrdPackNormalRoughness(vec3(0.0, 0.0, 1.0), 1.0));
        imageStore(primeViewZ, pixel, vec4(PRIME_TRANSPARENT_SKY_VIEW_Z));
        imageStore(primeMotion, pixel, vec4(0.0));
        return;
    }

    vec3 currentVirtualPosition = guidePositionData.xyz;
    vec3 previousVirtualPosition = currentVirtualPosition + interfaceData.xyz;
    vec3 virtualNormal = normalize(guide.rgb);
    vec3 psrNormal = virtualNormal;
    vec3 psrViewDirection = primeUnpackTransparentDirection(guidePositionData.w);
    float virtualRoughness = clamp(guide.a, 0.0, 1.0);
    vec2 currentCameraJitter =
            primeMotionPush.previousRenderedWorldToClipOrTransparentState[1].xy;
    // Raygen traces pixel + 0.5 + jitter. Virtual reflection/refraction geometry therefore
    // projects to this sampled UV, not to the pixel centre. Using the centre would inject the
    // Halton offset into motion even for a perfectly static camera and scene.
    vec2 currentSampleUv = (vec2(pixel) + vec2(0.5) + currentCameraJitter)
            / vec2(extent);
    vec3 cameraForward = primeTransparentMotionRayDirection(vec2(0.5));
    float currentViewZ = dot(currentVirtualPosition, cameraForward);
    if (!(currentViewZ > 0.0)
            || currentViewZ >= PRIME_TRANSPARENT_SKY_VIEW_Z
            || any(isnan(currentVirtualPosition))
            || any(isinf(currentVirtualPosition))) {
        primeStoreInvalidTransparentGuide(
                pixel,
                (rawDiffuse.rgb + rawSpecular.rgb) * pathThroughput.rgb);
        return;
    }

    vec3 diffuseMaterialFactor;
    vec3 specularMaterialFactor;
    primeNrdMaterialFactors(
            psrNormal,
            psrViewDirection,
            metadata.rgb,
            vec3(primeMaterialDielectricF0(
                    uint(max(round(pathThroughput.a), 0.0)))),
            virtualRoughness,
            diffuseMaterialFactor,
            specularMaterialFactor);
    float normalizedDiffuseHitDistance = rawDiffuse.a <= 0.0
            ? 0.0
            : primeNrdNormalizedHitDistance(rawDiffuse.a, currentViewZ, 1.0);
    float normalizedSpecularHitDistance = rawSpecular.a <= 0.0
            ? 0.0
            : primeNrdNormalizedHitDistance(
                    rawSpecular.a, currentViewZ, virtualRoughness);
    imageStore(
            primeNoisyDiffuse,
            pixel,
            primeNrdPackRadianceAndHitDistance(
                    rawDiffuse.rgb / diffuseMaterialFactor,
                    normalizedDiffuseHitDistance));
    imageStore(
            primeNoisySpecular,
            pixel,
            primeNrdPackRadianceAndHitDistance(
                    rawSpecular.rgb / specularMaterialFactor,
                    normalizedSpecularHitDistance));
    imageStore(
            primeNormalRoughness,
            pixel,
            primeNrdPackNormalRoughness(virtualNormal, virtualRoughness));
    imageStore(primeViewZ, pixel, vec4(currentViewZ));
    // All data associated with the primary hit is replaced by PSR data. Material factors and
    // delta-chain throughput remain outside the denoiser and are multiplied back in composite.
    imageStore(primeMetadata, pixel, vec4(diffuseMaterialFactor, metadata.a));
    imageStore(primeGuideMaterial, pixel, vec4(specularMaterialFactor, guide.a));

    vec4 previousClip = primeMotionPush.previousWorldToClip
            * vec4(previousVirtualPosition, 1.0);
    if (!(abs(previousClip.w) > 1.0e-6)
            || any(isnan(previousClip))
            || any(isinf(previousClip))) {
        imageStore(primeMotion, pixel, vec4(0.0));
        return;
    }
    vec2 previousNdc = previousClip.xy / previousClip.w;
    vec2 previousUv = previousNdc * vec2(0.5, -0.5) + vec2(0.5);
    float previousViewZ = abs(previousClip.w);
    // NRD's immutable screen-space convention is previous = current + motion.
    imageStore(
            primeMotion,
            pixel,
            vec4(previousUv - currentSampleUv, previousViewZ - currentViewZ, 0.0));
}
