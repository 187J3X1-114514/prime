#version 460
#define PRIME_REALTIME_ABI 1
#define PRIME_SHARC_ABI 1
#define SHARC_UPDATE 1
#define SHARC_QUERY 0
#extension GL_GOOGLE_include_directive : require
#extension GL_EXT_control_flow_attributes : require
#extension GL_EXT_buffer_reference : require
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#extension GL_EXT_shader_atomic_int64 : require
#extension GL_EXT_shader_16bit_storage : require

#include "common.glsl"
#include "atmosphere_rt.glsl"
#include "nrd_common.glsl"
#include "shadow_payload.glsl"

layout(location = 0) rayPayloadEXT TracePayload primePayload;
layout(location = 1) rayPayloadEXT PrimeShadowPayload primeShadowPayload;

#include "sampling.glsl"
#include "transparent_checkerboard.glsl"
#include "bsdf.glsl"
#include "lights.glsl"
#include "sharc.glsl"
#include "integrator.glsl"
#include "camera.glsl"

float primeSharcLuminance(vec3 value) {
    return dot(value, vec3(0.2627, 0.6780, 0.0593));
}

void main() {
    uvec2 phase = uvec2(
            primeSharcFrame.updatePhase % 5u,
            primeSharcFrame.updatePhase / 5u);
    uvec2 pixel = gl_LaunchIDEXT.xy * 5u + phase;
    if (any(greaterThanEqual(pixel, primePush.outputExtent))) {
        return;
    }

    PathState path = primeCameraPath(pixel, 0u, primeRealtimeCameraSample());
    PrimeRcVolumeStack volumeStack =
            (primePush.path.z & PRIME_PATH_CAMERA_IN_WATER_MASK) != 0u
            ? primeCameraWaterVolumeStack()
            : primeEmptyVolumeStack();
    IntegratorRecord integrator;
    integrator.sunDirectionIntensity = vec4(
            primePush.sunDirection,
            ATM_SPACE_SUN_INTENSITY * primeSunRadianceMultiplier());
    integrator.environmentRadiance = vec4(0.0);

    SharcParameters parameters = primeSharcParameters();
    SharcState state;
    SharcInit(state);
    uint maximumBounces = primeMaximumBounces();
    for (uint bounce = 0u; bounce < maximumBounces; ++bounce) {
        SurfaceInteraction surface = primeTraceSurfaceWithoutReorder(
                path.traceOrigin, path.rayDirection);
        if (surface.hitKind == PRIME_HIT_NONE) {
            SharcUpdateMiss(
                    parameters,
                    state,
                    primeEvaluateEnvironmentContribution(path, integrator));
            return;
        }
        if (!primeKnownHitKind(surface)) {
            return;
        }

        if (volumeStack.count > 0u) {
            PrimeRcVolume medium = volumeStack.values[volumeStack.count - 1u];
            vec3 transmittance = primeSegmentTransmittance(
                    medium.extinction, surface.t);
            if (all(equal(transmittance, vec3(0.0)))) {
                return;
            }
            SharcSetThroughput(state, transmittance);
        }

        path.throughput = vec3(1.0);
        vec3 viewDirection = -path.rayDirection;
        float surfaceLinearRoughness = primeSurfaceLinearRoughness(surface);
        bool pureDeltaInterface = primeMaterialIsTransmissive(surface.materialFlags)
                && surfaceLinearRoughness == 0.0;
        PrimePreparedSampleBase preparedSample = primePrepareSampleBase(
                primeMakeSampleBase(path, path.bounce + 1u));

        vec3 diffuseDirect = vec3(0.0);
        vec3 specularDirect = vec3(0.0);
        if (!pureDeltaInterface) {
            PrimePrimarySunSample sun = primeEstimatePrimaryDirectSun(
                    integrator,
                    surface,
                    viewDirection,
                    primeSobolSample2D(
                            preparedSample,
                            PRIME_SAMPLE_EFFECT_DIRECT_SUN,
                            PRIME_SAMPLE_DIMENSION_PRIMARY),
                    volumeStack,
                    false);
            diffuseDirect = sun.lighting.diffuse * sun.visibility;
            specularDirect = sun.lighting.specular * sun.visibility;
            PrimeDirectLightingSplit nonsun = primeEstimatePrimaryNonsunDirect(
                    surface,
                    viewDirection,
                    preparedSample,
                    volumeStack,
                    false);
            diffuseDirect += nonsun.diffuse;
            specularDirect += nonsun.specular;
        }
        vec3 emissive = primeEvaluateLocalHitEmission(
                path, surface, path.bounce > 0u);
        vec3 direct = diffuseDirect + specularDirect;
        float directLuminance = primeSharcLuminance(
                diffuseDirect + specularDirect);
        float directionWeight = (1.0 - surfaceLinearRoughness)
                * primeSharcLuminance(specularDirect)
                / max(directLuminance, 1.0e-6);
        SharcHitData hit = primeSharcHitData(
                surface.position,
                surface.geometricNormal,
                viewDirection,
                directionWeight,
                primeSharcMaterialDemodulation(surface),
                emissive);
        float resamplingRandom = primeHashSample1D(
                preparedSample,
                PRIME_SAMPLE_EFFECT_RUSSIAN_ROULETTE,
                PRIME_SAMPLE_DIMENSION_SECONDARY);
        if (!SharcUpdateHit(
                parameters, state, hit, direct, resamplingRandom)) {
            return;
        }

        PrimePathScatter scatter = primeSamplePathSurface(
                surface,
                viewDirection,
                primeSobolSample3D(
                        preparedSample,
                        PRIME_SAMPLE_EFFECT_SCATTER_BSDF,
                        PRIME_SAMPLE_DIMENSION_PRIMARY),
                volumeStack);
        BsdfSample bsdf = scatter.bsdf;
        if (!primeHasScatter(bsdf)) {
            return;
        }
        volumeStack = scatter.volumeStack;
        if (!primeAdvancePath(
                path,
                surface,
                bsdf,
                preparedSample,
                pureDeltaInterface,
                surfaceLinearRoughness)) {
            return;
        }
        SharcSetThroughput(state, path.throughput);
        SharcSetRadianceDirectionWeight(state, directionWeight);
        path.throughput = vec3(1.0);
        path.bounce++;
    }
}
