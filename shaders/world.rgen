#version 460
#extension GL_GOOGLE_include_directive : require
#extension GL_EXT_control_flow_attributes : require
#if defined(PRIME_ENABLE_SER)
#extension GL_EXT_buffer_reference_uvec2 : require
#extension GL_EXT_shader_invocation_reorder : require
#endif
#include "common.glsl"
#include "atmosphere_rt.glsl"
#include "nrd_common.glsl"

layout(location = 0) rayPayloadEXT TracePayload primePayload;
layout(location = 1) rayPayloadEXT uint primeShadowHitDistanceBits;

#include "sampling.glsl"
#include "bsdf.glsl"
#include "lights.glsl"
#include "integrator.glsl"
#include "camera.glsl"
#include "world_output.glsl"

void main() {
    uvec2 pixel = gl_LaunchIDEXT.xy;
    primeSetNumericalContext(PRIME_NUMERICAL_STAGE_CAMERA, 0u);
    IntegratorRecord integrator;
    integrator.sunDirectionIntensity = vec4(
            primePush.sunDirection,
            ATM_SPACE_SUN_INTENSITY * primeSunRadianceMultiplier());
    integrator.environmentRadiance = vec4(0.0);
    vec2 cameraSample = primeCameraSample();
    PathState path = primeCameraPath(pixel, 0u, cameraSample);

    // This entry is dispatched only by traceScreenshot. Realtime uses the bounded wavefront
    // entry, so retaining its guide-heavy megakernel here only duplicates driver compilation.
    PrimeReferenceResult reference = primeIntegrateReference(path, integrator);
    primeApplyAerialPerspective(
            pixel,
            cameraSample,
            reference.primaryDistance,
            reference.radiance);
    vec4 previous = imageLoad(primeAccumulation, ivec2(pixel));
    uint64_t zeroBasedSample = (uint64_t(primeSampleEpoch()) << 16u)
            | uint64_t(primePush.path.x & 0xffffu);
    float sampleCount = float(zeroBasedSample + uint64_t(1));
    vec3 mean = previous.rgb + (reference.radiance - previous.rgb) / sampleCount;
    imageStore(primeAccumulation, ivec2(pixel), vec4(mean, 1.0));
}
