#version 460
#extension GL_GOOGLE_include_directive : require

#include "atmosphere.glsl"
#include "default_material.glsl"
#include "nrd_common.glsl"

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 0, binding = 0, rgba16f) uniform readonly image2D rrNoisyDiffuse;
layout(set = 0, binding = 1, rgba16f) uniform readonly image2D rrNoisySpecular;
layout(set = 0, binding = 2, rgba16f) uniform image2D rrDiffuseMaterial;
layout(set = 0, binding = 3, rgba16f) uniform image2D rrSpecularMaterial;
layout(set = 0, binding = 4, rgb10_a2) uniform readonly image2D rrPackedNormalRoughness;
layout(set = 0, binding = 5, r32f) uniform writeonly image2D rrLinearViewZ;
layout(set = 0, binding = 6, rgba32f) uniform readonly image2D rrPrimaryPosition;
layout(set = 0, binding = 7, rgba16f) uniform readonly image2D rrSunLighting;
layout(set = 0, binding = 8, rgba32f) uniform readonly image2D rrStableRadiance;
layout(set = 0, binding = 9, rgba16f) uniform readonly image3D rrAerialRadiance;
layout(set = 0, binding = 10, rgba16f) uniform readonly image3D rrAerialTransmittance;
layout(set = 0, binding = 11, rgba16f) uniform writeonly image2D rrInputColor;
layout(set = 0, binding = 12, rgba16f) uniform writeonly image2D rrColorBeforeTransparency;
layout(set = 0, binding = 13, rgba16f) uniform writeonly image2D rrMotion;
layout(set = 0, binding = 14, rgba16f) uniform writeonly image2D rrNormalRoughness;
layout(set = 0, binding = 15, r16f) uniform writeonly image2D rrSpecularHitDistance;

layout(push_constant) uniform PrimeRrPreparePushConstants {
    mat4 currentClipToWorld;
    mat4 previousWorldToClip;
    mat4 currentWorldToView;
    float sunRadianceMultiplier;
    vec2 currentJitterPixels;
} rrPush;

const float PRIME_RR_SKY_VIEW_Z = 65504.0;

ATM_DECLARE_SAMPLE_3D(rrSampleAerialRadiance, rrAerialRadiance)
ATM_DECLARE_SAMPLE_3D(rrSampleAerialTransmittance, rrAerialTransmittance)

vec3 rrRayDirection(vec2 screenUv) {
    vec2 clipXY = screenUv * vec2(2.0, -2.0) + vec2(-1.0, 1.0);
    vec4 nearPoint = rrPush.currentClipToWorld * vec4(clipXY, 1.0, 1.0);
    vec4 farPoint = rrPush.currentClipToWorld * vec4(clipXY, 0.0, 1.0);
    return normalize(farPoint.xyz / farPoint.w - nearPoint.xyz / nearPoint.w);
}

vec2 rrMotionVector(ivec2 pixel, ivec2 extent, vec3 position, bool sky) {
    // The primary point was traced through pixel center + the current camera jitter. Projecting
    // that point with a non-jittered matrix therefore lands at this sample UV, not at pixel center.
    // Subtracting pixel center would leak the current Halton offset into every static motion vector.
    vec2 currentSampleUv = (vec2(pixel) + vec2(0.5) + rrPush.currentJitterPixels)
            / vec2(extent);
    vec4 previousClip = sky
            ? rrPush.previousWorldToClip * vec4(rrRayDirection(currentSampleUv), 0.0)
            : rrPush.previousWorldToClip * vec4(position, 1.0);
    if (!(abs(previousClip.w) > 1.0e-6)
            || any(isnan(previousClip))
            || any(isinf(previousClip))) {
        return vec2(0.0);
    }
    vec2 previousNdc = previousClip.xy / previousClip.w;
    vec2 previousUv = previousNdc * vec2(0.5, -0.5) + vec2(0.5);
    // NGX receives current-frame to previous-frame motion without jitter in normalized UV units.
    // Static geometry projects back to currentSampleUv, so its vector is zero. The bridge supplies
    // renderWidth/renderHeight as MV scales to convert actual camera motion to pixel space.
    return previousUv - currentSampleUv;
}

void rrApplyAerial(ivec2 pixel, ivec2 extent, float primaryDistance, inout vec3 radiance) {
    if (!primeNrdIsFinite(primaryDistance) || primaryDistance < 0.0) {
        return;
    }
    float distanceKm = primaryDistance * ATM_WORLD_UNIT_SCALE_KM;
    ivec3 dimensions = imageSize(rrAerialRadiance);
    float firstSliceDepth = 0.5 / float(max(dimensions.z, 1));
    float firstSliceDistanceKm = ATM_AERIAL_MAX_DISTANCE_KM * firstSliceDepth * firstSliceDepth;
    float normalizedDepth = max(firstSliceDepth, sqrt(clamp(
            distanceKm / max(ATM_AERIAL_MAX_DISTANCE_KM, 1.0e-6), 0.0, 1.0)));
    float nearWeight = clamp(distanceKm / max(firstSliceDistanceKm, 1.0e-6), 0.0, 1.0);
    vec2 screenUv = (vec2(pixel) + vec2(0.5)) / vec2(extent);
    vec3 uvw = vec3(screenUv, normalizedDepth);
    vec3 inscatter = max(rrSampleAerialRadiance(uvw).rgb, vec3(0.0));
    vec3 transmittance = clamp(
            rrSampleAerialTransmittance(uvw).rgb, vec3(0.0), vec3(1.0));
    if (any(isnan(inscatter)) || any(isinf(inscatter))) {
        inscatter = vec3(0.0);
    }
    if (any(isnan(transmittance)) || any(isinf(transmittance))) {
        transmittance = vec3(1.0);
    }
    radiance = radiance * mix(vec3(1.0), transmittance, nearWeight)
            + inscatter * nearWeight * rrPush.sunRadianceMultiplier;
}

void main() {
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    ivec2 extent = imageSize(rrInputColor);
    if (any(greaterThanEqual(pixel, extent))) {
        return;
    }

    vec4 material = imageLoad(rrDiffuseMaterial, pixel);
    vec4 specularMaterial = imageLoad(rrSpecularMaterial, pixel);
    uint materialFlags = primeNrdIsFinite(specularMaterial.a)
            ? uint(clamp(round(specularMaterial.a), 0.0, PRIME_NRD_FP16_MAX))
            : 0u;
    bool sky = !primeNrdIsFinite(material.a) || material.a < 0.0;
    bool transparent = !sky
            && (materialFlags & PRIME_MATERIAL_FLAG_TRANSMISSIVE) != 0u;
    vec4 primary = imageLoad(rrPrimaryPosition, pixel);
    vec4 noisyDiffuse = imageLoad(rrNoisyDiffuse, pixel);
    vec4 noisySpecular = imageLoad(rrNoisySpecular, pixel);
    vec4 sun = imageLoad(rrSunLighting, pixel);

    vec3 normal;
    float roughness;
    primeNrdUnpackNormalRoughness(
            imageLoad(rrPackedNormalRoughness, pixel), normal, roughness);
    normal = sky
            ? vec3(0.0, 0.0, 1.0)
            : primeNrdSafeNormalize(normal, vec3(0.0, 0.0, 1.0));
    roughness = sky
            ? PRIME_DEFAULT_REFERENCE_LINEAR_ROUGHNESS
            : primeNrdSanitizeUnit(roughness, PRIME_DEFAULT_REFERENCE_LINEAR_ROUGHNESS);
    imageStore(rrNormalRoughness, pixel, vec4(normal, roughness));

    // The SDK's neutral sky fallback is 0.5 for both albedos. A value of one tells RR that all
    // noisy sky energy is fully explained by material reflectance and over-constrains reconstruction.
    vec3 diffuseAlbedo = sky
            ? vec3(0.5)
            : (transparent ? vec3(0.0) : primeNrdSanitizeAlbedo(material.rgb));
    vec3 specularAlbedo = sky
            ? vec3(0.5)
            : primeNrdSanitizeAlbedo(specularMaterial.rgb);
    imageStore(rrDiffuseMaterial, pixel, vec4(diffuseAlbedo, material.a));
    imageStore(rrSpecularMaterial, pixel, vec4(specularAlbedo, specularMaterial.a));
    imageStore(
            rrSpecularHitDistance,
            pixel,
            vec4(sky ? 0.0 : primeNrdSanitizeHitDistance(noisySpecular.a)));

    float viewZ = PRIME_RR_SKY_VIEW_Z;
    if (!sky) {
        vec4 viewPosition = rrPush.currentWorldToView * vec4(primary.xyz, 1.0);
        viewZ = abs(viewPosition.z);
        if (!(viewZ > 0.0) || isnan(viewZ) || isinf(viewZ)) {
            viewZ = PRIME_RR_SKY_VIEW_Z;
        }
    }
    imageStore(rrLinearViewZ, pixel, vec4(viewZ));
    imageStore(
            rrMotion,
            pixel,
            vec4(primeNrdSanitizeMotion(
                    vec3(rrMotionVector(pixel, extent, primary.xyz, sky), 0.0)), 0.0));

    vec3 surface = sky
            ? vec3(0.0)
            : primeNrdSanitizeRadiance(noisyDiffuse.rgb)
                    + primeNrdSanitizeRadiance(noisySpecular.rgb)
                    + primeNrdSanitizeRadiance(sun.rgb)
                            * primeNrdSanitizeUnit(sun.a, 0.0);
    vec3 stable = primeNrdClampRadiance(
            imageLoad(rrStableRadiance, pixel).rgb, PRIME_NRD_FP16_MAX);
    vec3 inputRadiance = surface + stable;
    rrApplyAerial(pixel, extent, material.a, inputRadiance);
    inputRadiance = primeNrdClampRadiance(inputRadiance, PRIME_NRD_FP16_MAX);

    vec3 beforeRadiance = inputRadiance;
    if (transparent) {
        // The fixed primary-interface split writes its complete transmitted continuation into the
        // raw diffuse lane. Reuse that exact sample for NGX instead of tracing a guide path.
        beforeRadiance = primeNrdSanitizeRadiance(noisyDiffuse.rgb);
        rrApplyAerial(pixel, extent, material.a, beforeRadiance);
        beforeRadiance = primeNrdClampRadiance(beforeRadiance, PRIME_NRD_FP16_MAX);
    }
    // Opaque surfaces and sky use the same final variable, guaranteeing identical FP16 stores.
    imageStore(rrInputColor, pixel, vec4(inputRadiance, 1.0));
    imageStore(rrColorBeforeTransparency, pixel, vec4(beforeRadiance, 1.0));
}
