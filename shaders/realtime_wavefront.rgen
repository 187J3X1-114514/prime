#version 460
#define PRIME_REALTIME_ABI 1
#extension GL_GOOGLE_include_directive : require
#extension GL_EXT_control_flow_attributes : require
#if defined(PRIME_ENABLE_SUBGROUP_QUEUE)
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_shader_subgroup_ballot : require
#endif
#if defined(PRIME_ENABLE_SER)
#extension GL_EXT_buffer_reference_uvec2 : require
#extension GL_EXT_shader_invocation_reorder : require
#endif
#include "common.glsl"
#include "atmosphere_rt.glsl"
#include "nrd_common.glsl"
#include "shadow_payload.glsl"

layout(location = 0) rayPayloadEXT TracePayload primePayload;
layout(location = 1) rayPayloadEXT PrimeShadowPayload primeShadowPayload;

#include "sampling.glsl"
#include "bsdf.glsl"
#include "lights.glsl"

#include "integrator.glsl"
#include "camera.glsl"
#include "wavefront_output.glsl"
#include "wavefront_state.glsl"

const uint PRIME_WAVEFRONT_STAGE_HEAD = 0u;
const uint PRIME_WAVEFRONT_STAGE_STEP = 1u;
const uint PRIME_WAVEFRONT_STAGE_TAIL = 2u;
const uint PRIME_WAVEFRONT_STAGE_RESOLVE = 3u;
layout(constant_id = 0) const uint primeWavefrontSpecializedStage =
        PRIME_WAVEFRONT_STAGE_HEAD;

layout(shaderRecordEXT, std430) buffer PrimeWavefrontShaderRecord {
    uint control;
} primeWavefrontShaderRecord;

void primeInitializeTransparentWavefront(
        uvec2 pixel,
        PathState path,
        PrimeRcVolumeStack volumeStack,
        IntegratorRecord integrator,
        SurfaceInteraction surface,
        uint maximumBounces) {
    PrimeIntegrationResult initialResult = primeEmptyIntegrationResult();
    if (!primeApplySegmentMedium(path, surface, volumeStack)) {
        PrimeDenoiserState emptyState = primeInitialDenoiserState();
        PrimeWavefrontPathRecord emptyRecord = primeMakeWavefrontRecord(
                path,
                volumeStack,
                emptyState,
                initialResult.guides.primaryMaterialFlags,
                false);
        primeWavefrontPaths.records[primeWavefrontIndex(pixel, 0u)] = emptyRecord;
        primeWavefrontPaths.records[primeWavefrontIndex(pixel, 1u)] = emptyRecord;
        primeStoreWavefrontArea(pixel, initialResult.guides);
        primeStoreWavefrontIntermediate(pixel, initialResult);
        return;
    }

    vec3 viewDirection = -path.rayDirection;
    primeAccumulate(
            initialResult.reflectionSpecularRadiance,
            primeEvaluateHitEmission(path, surface, false));
    float surfaceLinearRoughness = primeSurfaceLinearRoughness(surface);
    bool pureDeltaInterface = surfaceLinearRoughness == 0.0;
    PrimePreparedSampleBase preparedSample =
            primePrepareSampleBase(primeMakeSampleBase(path, path.bounce + 1u));
    if (!pureDeltaInterface) {
        primeSetNumericalContext(
                PRIME_NUMERICAL_STAGE_DIRECT_LIGHT, path.bounce);
        PrimePrimarySunSample sun = primeEstimatePrimaryDirectSun(
                integrator,
                surface,
                viewDirection,
                primeSobolSample2D(
                        preparedSample,
                        PRIME_SAMPLE_EFFECT_DIRECT_SUN,
                        PRIME_SAMPLE_DIMENSION_PRIMARY),
                volumeStack,
                true);
        primeAccumulate(
                initialResult.radiance.diffuse,
                path.throughput * sun.lighting.diffuse * sun.visibility);
        primeAccumulate(
                initialResult.reflectionSpecularRadiance,
                path.throughput * sun.lighting.specular * sun.visibility);
        PrimeDirectLightingSplit nonsun = primeEstimatePrimaryNonsunDirect(
                surface,
                viewDirection,
                preparedSample,
                volumeStack,
                true);
        initialResult.guides.primaryAreaDiffuse =
                path.throughput * nonsun.diffuse;
        initialResult.guides.primaryAreaSpecular =
                path.throughput * nonsun.specular;
        primeAccumulate(
                initialResult.radiance.diffuse,
                initialResult.guides.primaryAreaDiffuse);
        primeAccumulate(
                initialResult.reflectionSpecularRadiance,
                initialResult.guides.primaryAreaSpecular);
        if (any(greaterThan(
                initialResult.guides.primaryAreaDiffuse, vec3(0.0)))
                || any(greaterThan(
                        initialResult.guides.primaryAreaSpecular, vec3(0.0)))) {
            initialResult.guides.primaryAreaDirection = nonsun.direction;
        }
    }

    primeSetNumericalContext(
            PRIME_NUMERICAL_STAGE_BSDF_SAMPLE, path.bounce);
    PrimeTransmissivePrimarySample primarySample =
            primeSampleMinecraftTransmissionPrimary(
            surface.baseColor,
            primeSurfaceOpacity(surface),
            primeSurfaceOutwardShadingNormal(surface),
            surface.materialFlags,
            surface.labPbrNormal,
            surface.labPbrSpecular,
            viewDirection,
            primeSobolSample3D(
                    preparedSample,
                    PRIME_SAMPLE_EFFECT_SCATTER_BSDF,
                    PRIME_SAMPLE_DIMENSION_PRIMARY),
            surface.t,
            volumeStack);
    PrimeDenoiseAlbedos albedos = primarySample.albedos;
    vec3 shadingNormal = primeSurfaceShadingNormal(surface, viewDirection);
    initialResult.guides.primaryDistance =
            length(surface.position - primePush.cameraPosition);
    initialResult.guides.primaryPosition =
            surface.position - primePush.cameraPosition;
    initialResult.guides.primaryAlbedo = albedos.diffuse;
    initialResult.guides.primaryNormal = shadingNormal;
    initialResult.guides.primaryHitKind = surface.hitKind;
    initialResult.guides.primaryMaterialFlags = surface.materialFlags;
    initialResult.guides.primarySpecularAlbedo = albedos.specular;
    initialResult.guides.primaryLinearRoughness = surfaceLinearRoughness;
    initialResult.transparentPrimary = true;

    uint guideMode = primeTransparentGuideMode();
    bool transmissionGuideEnabled =
            guideMode == PRIME_PATH_TRANSPARENT_GUIDE_MODE_NRD
            || guideMode == PRIME_PATH_TRANSPARENT_GUIDE_MODE_DLSS_RR;
    bool reflectionGuideEnabled =
            guideMode == PRIME_PATH_TRANSPARENT_GUIDE_MODE_NRD;
    primeStoreWavefrontVisibleScratch(pixel, initialResult.guides);
    primeStoreWavefrontArea(pixel, initialResult.guides);
    PrimeTransmissiveBsdfSample branches[2] =
            PrimeTransmissiveBsdfSample[2](
                    primarySample.paths.transmission,
                    primarySample.paths.reflection);

    for (uint branch = 0u; branch < 2u; ++branch) {
        bool transmissionBranch = branch == 0u;
        bool guideEnabled = transmissionBranch
                ? transmissionGuideEnabled
                : reflectionGuideEnabled;
        PrimeTransmissiveBsdfSample selected = branches[branch];
        BsdfSample bsdf = selected.bsdfSample;
        PrimeTransparentBranchResult branchResult;
        branchResult.diffuseRadiance = transmissionBranch
                ? initialResult.radiance.diffuse
                : initialResult.reflectionDiffuseRadiance;
        branchResult.specularRadiance = transmissionBranch
                ? initialResult.radiance.specular
                : initialResult.reflectionSpecularRadiance;
        // Until a later finite non-delta surface replaces the branch guide, the visible interface
        // itself is the exact fallback. This removes the need for a third 96-byte guide record.
        branchResult.guides = initialResult.guides;
        branchResult.firstHitDistance = 0.0;
        branchResult.anchorDistance = -1.0;
        branchResult.directionalGuide = false;
        PrimeQueuedPsrState psrState = primeEmptyQueuedPsrState();
        bool hasScatter = primeHasScatter(bsdf);
        bool hasGuide = guideEnabled
                && hasScatter
                && (bsdf.eventFlags & PRIME_BSDF_EVENT_DELTA) == 0u;
        bool diffusePath = transmissionBranch;
        uint guideBounce = path.bounce;

        if (hasScatter) {
            primeRecordDirection(bsdf.direction);
            primeRecordNonnegative(bsdf.response);
            primeRecordNonnegative(bsdf.pdf);
            primeRecordNonnegative(bsdf.relativeEta);
            if (transmissionBranch) {
                initialResult.guides.diffuseDirection = bsdf.direction;
                branchResult.guides.diffuseDirection = bsdf.direction;
            } else {
                initialResult.guides.specularDirection = bsdf.direction;
                branchResult.guides.specularDirection = bsdf.direction;
            }
        }
        if (hasGuide) {
            primeSetQueuedPsrGuide(
                    branchResult.guides,
                    surface,
                    shadingNormal,
                    surfaceLinearRoughness,
                    albedos,
                    path.throughput,
                    path.physicalOrigin,
                    psrState);
            if (transmissionBranch) {
                branchResult.anchorDistance = primeQueuedPsrAnchorDistance(
                        psrState, surface.position, surface.geometricNormal);
            }
        } else if (guideEnabled && hasScatter
                && (bsdf.eventFlags & PRIME_BSDF_EVENT_DELTA) != 0u) {
            primeAppendQueuedPsrDelta(
                    psrState, path.physicalOrigin, surface, bsdf);
        }
        if (transmissionBranch) {
            branchResult.guides.primaryAreaDiffuse =
                    initialResult.guides.primaryAreaDiffuse;
        } else {
            branchResult.guides.primaryAreaSpecular =
                    initialResult.guides.primaryAreaSpecular;
        }
        branchResult.guides.primaryAreaDirection =
                initialResult.guides.primaryAreaDirection;

        PathState branchPath = path;
        branchPath.sampleDimension = transmissionBranch ? 1u : 0u;
        bool branchPureDelta = transmissionBranch || pureDeltaInterface;
        bool continuation = hasScatter
                && (transmissionBranch
                        || !primeSuppressesPrimaryTransparentReflection());
        if (continuation) {
            continuation = primeAdvancePath(
                    branchPath,
                    surface,
                    bsdf,
                    preparedSample,
                    branchPureDelta);
        }
        if (continuation) {
            branchPath.bounce = path.bounce + 1u;
            continuation = branchPath.bounce < maximumBounces;
        }
        PrimeWavefrontPathRecord record =
                primeMakeTransparentWavefrontRecord(
                branchPath,
                selected.volumeStack,
                branchResult,
                psrState,
                transmissionBranch,
                guideEnabled,
                hasGuide,
                diffusePath,
                guideBounce,
                continuation);
        uint pathIndex = primeWavefrontIndex(pixel, branch);
        primeWavefrontPaths.records[pathIndex] = record;
        if (continuation) {
            primeAppendWavefrontPath(0u, pathIndex);
        }
        primeStoreTransparentBranchIntermediate(
                pixel, transmissionBranch, branchResult);
    }
}

void primeWavefrontHead() {
    uvec2 pixel = gl_LaunchIDEXT.xy;
    uint recordIndex = primeWavefrontIndex(pixel);
    uint maximumBounces = primeMaximumBounces();
    primeSetNumericalContext(PRIME_NUMERICAL_STAGE_CAMERA, 0u);

    if (maximumBounces == 0u) {
        vec2 cameraSample = primeRealtimeCameraSample();
        PathState path = primeCameraPath(pixel, 0u, cameraSample);
        PrimeRcVolumeStack volumeStack =
                (primePush.path.z & PRIME_PATH_CAMERA_IN_WATER_MASK) != 0u
                ? primeCameraWaterVolumeStack()
                : primeEmptyVolumeStack();
        PrimeDenoiserState denoiserState = primeInitialDenoiserState();
        PrimeIntegrationResult result = primeEmptyIntegrationResult();
        PrimeWavefrontPathRecord record = primeMakeWavefrontRecord(
                path,
                volumeStack,
                denoiserState,
                result.guides.primaryMaterialFlags,
                false);
        primeWavefrontPaths.records[primeWavefrontIndex(pixel, 0u)] = record;
        primeWavefrontPaths.records[primeWavefrontIndex(pixel, 1u)] = record;
        primeStoreWavefrontArea(pixel, result.guides);
        primeStoreWavefrontIntermediate(pixel, result);
        return;
    }

    vec2 traceCameraSample = primeRealtimeCameraSample();
    vec3 traceDirection = primeCameraRayDirection(pixel, traceCameraSample);
    primeSetNumericalContext(PRIME_NUMERICAL_STAGE_TRACE, 0u);
    SurfaceInteraction surface =
            primeTraceSurface(primePush.cameraPosition, traceDirection);

    // Build transport, medium and denoiser state only after SER has executed the primary hit.
    // This keeps the largest realtime records out of the implementation's reorder spill set.
    vec2 cameraSample = primeRealtimeCameraSample();
    PathState path = primeCameraPath(pixel, 0u, cameraSample);
    IntegratorRecord integrator;
    integrator.sunDirectionIntensity = vec4(
            primePush.sunDirection,
            ATM_SPACE_SUN_INTENSITY * primeSunRadianceMultiplier());
    integrator.environmentRadiance = vec4(0.0);
    PrimeRcVolumeStack volumeStack =
            (primePush.path.z & PRIME_PATH_CAMERA_IN_WATER_MASK) != 0u
            ? primeCameraWaterVolumeStack()
            : primeEmptyVolumeStack();
    PrimeDenoiserState denoiserState = primeInitialDenoiserState();
    PrimeIntegrationResult result = primeEmptyIntegrationResult();
    if (surface.hitKind == PRIME_HIT_SURFACE
            && primeMaterialIsTransmissive(surface.materialFlags)) {
        primeInitializeTransparentWavefront(
                pixel,
                path,
                volumeStack,
                integrator,
                surface,
                maximumBounces);
        return;
    }

    bool continuation = primeIntegrateWavefrontSurface(
            path,
            integrator,
            volumeStack,
            denoiserState,
            result,
            surface);
    continuation = continuation && path.bounce < maximumBounces;
    PrimeWavefrontPathRecord record = primeMakeWavefrontRecord(
            path,
            volumeStack,
            denoiserState,
            result.guides.primaryMaterialFlags,
            continuation);
    uint pathIndex = primeWavefrontIndex(pixel, 0u);
    primeWavefrontPaths.records[pathIndex] = record;
    if (continuation) {
        primeAppendWavefrontPath(0u, pathIndex);
    }
    primeSetWavefrontActive(record.transport, false);
    primeWavefrontPaths.records[primeWavefrontIndex(pixel, 1u)] = record;
    primeStoreWavefrontArea(pixel, result.guides);
    primeStoreWavefrontIntermediate(pixel, result);
}

void primeWavefrontStep(uint sourceQueue) {
    uint recordIndex =
            primeWavefrontQueuedPath(sourceQueue, gl_LaunchIDEXT.x);
    uvec2 pixel = primeWavefrontPixel(recordIndex);
    uint packedDiagnostic = floatBitsToUint(
            primeWavefrontPaths.records[recordIndex]
                    .transport.throughputAndNumericalFlags.w);
    primeRawNumericalFlags =
            packedDiagnostic & PRIME_WAVEFRONT_NUMERICAL_FLAGS_MASK;
    primeRawNumericalFirstContext =
            (packedDiagnostic >> PRIME_WAVEFRONT_NUMERICAL_CONTEXT_SHIFT)
                    & PRIME_WAVEFRONT_NUMERICAL_CONTEXT_MASK;
    uint bounce = floatBitsToUint(
            primeWavefrontPaths.records[recordIndex]
                    .transport.traceOriginAndPathControl.w)
            & PRIME_WAVEFRONT_BYTE_MASK;
    vec3 traceOrigin = primeWavefrontPaths.records[recordIndex]
            .transport.traceOriginAndPathControl.xyz;
    vec3 rayDirection = primeWavefrontPaths.records[recordIndex]
            .transport.rayDirectionAndDenoiserControl.xyz;
    uint traceControl = floatBitsToUint(
            primeWavefrontPaths.records[recordIndex]
                    .transport.rayDirectionAndDenoiserControl.w);
    uint pathClass = (traceControl & PRIME_WAVEFRONT_TRANSPARENT_BRANCH) == 0u
            ? 0u
            : (traceControl & PRIME_WAVEFRONT_TRANSMISSION_BRANCH) == 0u
                    ? 1u
                    : 2u;
    primeSetNumericalContext(PRIME_NUMERICAL_STAGE_TRACE, bounce);
    SurfaceInteraction surface = primeTraceSurfaceClassified(
            traceOrigin, rayDirection, pathClass);

    // Reload after SER so transport and image-backed signal state are not live at the reorder
    // point. Cold area-light and PSR lanes remain untouched unless their path class needs them.
    PrimeWavefrontTransportRecord record =
            primeLoadWavefrontTransportRecord(recordIndex);
    PathState path = primeWavefrontPath(pixel, record);
    PrimeRcVolumeStack volumeStack = primeWavefrontVolumeStack(record);
    uint control = floatBitsToUint(record.rayDirectionAndDenoiserControl.w);
    IntegratorRecord integrator;
    integrator.sunDirectionIntensity = vec4(
            primePush.sunDirection,
            ATM_SPACE_SUN_INTENSITY * primeSunRadianceMultiplier());
    integrator.environmentRadiance = vec4(0.0);
    uint maximumBounces = primeMaximumBounces();
    bool queueContinuation;

    if (primeWavefrontTransparentBranch(control)) {
        bool hadGuide =
                (control & PRIME_WAVEFRONT_REACHED_NON_DELTA) != 0u;
        bool guideEnabled =
                (control & PRIME_WAVEFRONT_GUIDE_ENABLED) != 0u;
        bool needsPsr = guideEnabled && !hadGuide;
        bool transmissionBranch = primeWavefrontTransmissionBranch(control);
        PrimeTransparentBranchResult branchResult =
                primeLoadTransparentBranchActiveIntermediate(
                        pixel, transmissionBranch, control);
        PrimeQueuedPsrState psrState =
                needsPsr
                        ? primeLoadWavefrontPsrState(recordIndex, record)
                        : primeEmptyQueuedPsrState();
        bool hasGuide =
                hadGuide;
        bool diffusePath =
                (control & PRIME_WAVEFRONT_DIFFUSE_PATH) != 0u;
        uint guideBounce =
                (control >> PRIME_WAVEFRONT_PRIMARY_BOUNCE_SHIFT)
                        & PRIME_WAVEFRONT_BYTE_MASK;
        bool directionalGuide = primeWavefrontDirectionalGuide(control);
        bool hadDirectionalGuide = directionalGuide;
        bool continuation = primeIntegrateTransparentWavefrontSurface(
                path,
                integrator,
                volumeStack,
                branchResult,
                psrState,
                hasGuide,
                diffusePath,
                guideBounce,
                directionalGuide,
                surface,
                transmissionBranch,
                guideEnabled);
        continuation = continuation && path.bounce < maximumBounces;
        PrimeWavefrontTransportRecord updatedRecord =
                primeMakeUpdatedTransparentWavefrontRecord(
                path,
                volumeStack,
                branchResult,
                psrState,
                hasGuide,
                diffusePath,
                guideBounce,
                directionalGuide,
                control,
                continuation);
        primeStoreWavefrontTransportRecord(recordIndex, updatedRecord);
        if (continuation && guideEnabled && !hasGuide) {
            primeStoreWavefrontPsrState(recordIndex, psrState);
        }
        primeStoreTransparentBranchActiveIntermediate(
                pixel,
                transmissionBranch,
                !hadGuide && hasGuide,
                !hadDirectionalGuide && directionalGuide,
                branchResult);
        queueContinuation = continuation;
    } else {
        bool guideWasPending =
                (control & PRIME_WAVEFRONT_REACHED_NON_DELTA) == 0u;
        PrimeIntegrationResult result =
                primeLoadWavefrontActiveIntermediate(pixel, control);
        PrimeDenoiserState denoiserState =
                primeWavefrontDenoiserState(control, result);
        bool continuation = primeIntegrateWavefrontSurface(
                path,
                integrator,
                volumeStack,
                denoiserState,
                result,
                surface);
        continuation = continuation && path.bounce < maximumBounces;
        PrimeWavefrontTransportRecord updatedRecord =
                primeMakeUpdatedWavefrontRecord(
                        path,
                        volumeStack,
                        denoiserState,
                        control,
                        0u,
                        continuation);
        primeStoreWavefrontTransportRecord(recordIndex, updatedRecord);
        primeStoreWavefrontActiveIntermediate(
                pixel, guideWasPending, result);
        queueContinuation = continuation;
    }
    primeAppendWavefrontContinuation(
            sourceQueue ^ 1u, recordIndex, queueContinuation);
}

void primeWavefrontTail(uint sourceQueue) {
    uint recordIndex =
            primeWavefrontQueuedPath(sourceQueue, gl_LaunchIDEXT.x);
    uvec2 pixel = primeWavefrontPixel(recordIndex);
    PrimeWavefrontTransportRecord record =
            primeLoadWavefrontTransportRecord(recordIndex);
    primeRestoreWavefrontDiagnostic(record);

    PathState path = primeWavefrontPath(pixel, record);
    PrimeRcVolumeStack volumeStack = primeWavefrontVolumeStack(record);
    uint control = floatBitsToUint(record.rayDirectionAndDenoiserControl.w);
    IntegratorRecord integrator;
    integrator.sunDirectionIntensity = vec4(
            primePush.sunDirection,
            ATM_SPACE_SUN_INTENSITY * primeSunRadianceMultiplier());
    integrator.environmentRadiance = vec4(0.0);
    uint maximumBounces = primeMaximumBounces();

    if (primeWavefrontTransparentBranch(control)) {
        bool hadGuide =
                (control & PRIME_WAVEFRONT_REACHED_NON_DELTA) != 0u;
        bool guideEnabled =
                (control & PRIME_WAVEFRONT_GUIDE_ENABLED) != 0u;
        bool needsPsr = guideEnabled && !hadGuide;
        bool transmissionBranch = primeWavefrontTransmissionBranch(control);
        PrimeTransparentBranchResult branchResult =
                primeLoadTransparentBranchActiveIntermediate(
                        pixel, transmissionBranch, control);
        PrimeQueuedPsrState psrState =
                needsPsr
                        ? primeLoadWavefrontPsrState(recordIndex, record)
                        : primeEmptyQueuedPsrState();
        bool hasGuide =
                hadGuide;
        bool diffusePath =
                (control & PRIME_WAVEFRONT_DIFFUSE_PATH) != 0u;
        uint guideBounce =
                (control >> PRIME_WAVEFRONT_PRIMARY_BOUNCE_SHIFT)
                        & PRIME_WAVEFRONT_BYTE_MASK;
        bool directionalGuide = primeWavefrontDirectionalGuide(control);
        bool hadDirectionalGuide = directionalGuide;
        [[dont_unroll]]
        while (path.bounce < maximumBounces) {
            primeSetNumericalContext(
                    PRIME_NUMERICAL_STAGE_TRACE, path.bounce);
            SurfaceInteraction surface = primeTraceSurfaceWithoutReorder(
                    path.traceOrigin, path.rayDirection);
            if (!primeIntegrateTransparentWavefrontSurface(
                    path,
                    integrator,
                    volumeStack,
                    branchResult,
                    psrState,
                    hasGuide,
                    diffusePath,
                    guideBounce,
                    directionalGuide,
                    surface,
                    transmissionBranch,
                    guideEnabled)) {
                break;
            }
        }
        PrimeWavefrontTransportRecord updatedRecord =
                primeMakeUpdatedTransparentWavefrontRecord(
                path,
                volumeStack,
                branchResult,
                psrState,
                hasGuide,
                diffusePath,
                guideBounce,
                directionalGuide,
                control,
                false);
        primeStoreWavefrontTransportRecord(recordIndex, updatedRecord);
        primeStoreTransparentBranchActiveIntermediate(
                pixel,
                transmissionBranch,
                !hadGuide && hasGuide,
                !hadDirectionalGuide && directionalGuide,
                branchResult);
        return;
    }

    bool guideWasPending =
            (control & PRIME_WAVEFRONT_REACHED_NON_DELTA) == 0u;
    PrimeIntegrationResult result =
            primeLoadWavefrontActiveIntermediate(pixel, control);
    PrimeDenoiserState denoiserState =
            primeWavefrontDenoiserState(control, result);
    // Paths reaching this point are sparse and incoherent. Finish them locally so queue traffic
    // remains bounded while preserving the same light-sampling policy as the queued rounds.
    [[dont_unroll]]
    while (path.bounce < maximumBounces) {
        primeSetNumericalContext(
                PRIME_NUMERICAL_STAGE_TRACE, path.bounce);
        SurfaceInteraction surface = primeTraceSurfaceWithoutReorder(
                path.traceOrigin, path.rayDirection);
        if (!primeIntegrateWavefrontSurface(
                path,
                integrator,
                volumeStack,
                denoiserState,
                result,
                surface)) {
            break;
        }
    }
    PrimeWavefrontTransportRecord updatedRecord =
            primeMakeUpdatedWavefrontRecord(
                    path,
                    volumeStack,
                    denoiserState,
                    control,
                    0u,
                    false);
    primeStoreWavefrontTransportRecord(recordIndex, updatedRecord);
    primeStoreWavefrontActiveIntermediate(
            pixel, guideWasPending, result);
}

void primeWavefrontResolve() {
    uvec2 pixel = gl_LaunchIDEXT.xy;
    PrimeWavefrontTransportRecord primaryRecord =
            primeWavefrontPaths.records[primeWavefrontIndex(pixel, 0u)].transport;
    uint primaryDiagnostic =
            floatBitsToUint(primaryRecord.throughputAndNumericalFlags.w);
    primeRawNumericalFlags =
            primaryDiagnostic & PRIME_WAVEFRONT_NUMERICAL_FLAGS_MASK;
    primeRawNumericalFirstContext =
            (primaryDiagnostic >> PRIME_WAVEFRONT_NUMERICAL_CONTEXT_SHIFT)
                    & PRIME_WAVEFRONT_NUMERICAL_CONTEXT_MASK;
    bool transparentPrimary = primeWavefrontPixelTransparent(pixel);
    if (transparentPrimary) {
        uint secondaryDiagnostic = floatBitsToUint(
                primeWavefrontPaths.records[primeWavefrontIndex(pixel, 1u)]
                        .transport.throughputAndNumericalFlags.w);
        uint secondaryFlags =
                secondaryDiagnostic & PRIME_WAVEFRONT_NUMERICAL_FLAGS_MASK;
        if (primeRawNumericalFlags == 0u && secondaryFlags != 0u) {
            primeRawNumericalFirstContext =
                    (secondaryDiagnostic
                            >> PRIME_WAVEFRONT_NUMERICAL_CONTEXT_SHIFT)
                            & PRIME_WAVEFRONT_NUMERICAL_CONTEXT_MASK;
        }
        primeRawNumericalFlags |= secondaryFlags;
    }
    PrimeIntegrationResult result = transparentPrimary
            ? primeResolveTransparentWavefrontResult(pixel)
            : primeLoadWavefrontIntermediate(
                    pixel,
                    primaryRecord);
    vec2 cameraSample = primeRealtimeCameraSample();
    primeWriteRealtimeOutput(pixel, cameraSample, result);
}

void main() {
    uint sourceQueue = (primeWavefrontShaderRecord.control >> 8u) & 1u;
    switch (primeWavefrontSpecializedStage) {
        case PRIME_WAVEFRONT_STAGE_HEAD:
            primeWavefrontHead();
            break;
        case PRIME_WAVEFRONT_STAGE_STEP:
            primeWavefrontStep(sourceQueue);
            break;
        case PRIME_WAVEFRONT_STAGE_TAIL:
            primeWavefrontTail(sourceQueue);
            break;
        case PRIME_WAVEFRONT_STAGE_RESOLVE:
            primeWavefrontResolve();
            break;
    }
}
