#version 460
#extension GL_GOOGLE_include_directive : require

#include "default_material.glsl"
#include "display_transform.glsl"

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 0, binding = 0, rgba16f) uniform readonly image2D rrDebugInputColor;
layout(set = 0, binding = 1, rgba16f) uniform readonly image2D rrDebugMotion;
layout(set = 0, binding = 2, rg16f) uniform readonly image2D rrDebugSpecularMotion;
layout(set = 0, binding = 3, r32f) uniform readonly image2D rrDebugDepth;
layout(set = 0, binding = 4, rgba16f) uniform readonly image2D rrDebugNormalRoughness;
layout(set = 0, binding = 5, rgba16f) uniform readonly image2D rrDebugDiffuseAlbedo;
layout(set = 0, binding = 6, rgba16f) uniform readonly image2D rrDebugSpecularAlbedo;
layout(set = 0, binding = 7, rgba16f) uniform readonly image2D rrDebugNoisySpecular;
layout(set = 0, binding = 8, rgba16f) uniform readonly image2D rrDebugOutput;
layout(set = 0, binding = 9, rgba8) uniform image2D rrDebugDisplay;
layout(std430, set = 0, binding = 10) readonly buffer PrimeAutoExposureState {
    float exposureEv;
    uint initialized;
    float targetEv;
    float measuredLogLuminance;
} primeAutoExposureState;

layout(push_constant) uniform PrimeRrDebugPushConstants {
    uint view;
    uint fullscreen;
    uint jitterPhase;
    uint jitterPhaseCount;
    float oklabOverexposure;
    float finalExposureMultiplier;
} rrDebugPush;

const uint RR_OVERVIEW = 1u;
const uint RR_INPUT_COLOR = 2u;
const uint RR_MOTION = 3u;
const uint RR_SPECULAR_MOTION = 4u;
const uint RR_DEPTH = 5u;
const uint RR_JITTER = 6u;
const uint RR_NORMALS = 7u;
const uint RR_ROUGHNESS = 8u;
const uint RR_DIFFUSE_ALBEDO = 9u;
const uint RR_SPECULAR_ALBEDO = 10u;
const uint RR_SPECULAR_HIT_DISTANCE = 11u;
const uint RR_OUTPUT = 12u;
const vec3 RR_INVALID = vec3(1.0, 0.0, 1.0);

bool rrFinite(float value) {
    return !isnan(value) && !isinf(value);
}

bool rrFinite(vec2 value) {
    return !any(isnan(value)) && !any(isinf(value));
}

bool rrFinite(vec3 value) {
    return !any(isnan(value)) && !any(isinf(value));
}

float rrHalton(uint index, uint base) {
    float result = 0.0;
    float fraction = 1.0;
    uint value = index;
    while (value > 0u) {
        fraction /= float(base);
        result += fraction * float(value % base);
        value /= base;
    }
    return result;
}

ivec2 rrSourcePixel(vec2 uv, ivec2 size) {
    return clamp(ivec2(uv * vec2(size)), ivec2(0), size - ivec2(1));
}

vec3 rrHdr(vec3 radiance) {
    if (!rrFinite(radiance)) return RR_INVALID;
    return primeDisplayTransformToSrgb(
            max(radiance, vec3(0.0)),
            exp2(primeAutoExposureState.exposureEv)
                    * rrDebugPush.finalExposureMultiplier,
            rrDebugPush.oklabOverexposure);
}

vec3 rrJitterPlot(vec2 uv) {
    vec3 color = vec3(0.025);
    float axes = min(abs(uv.x - 0.5), abs(uv.y - 0.5));
    if (axes < 0.003) color = vec3(0.16);
    uint count = max(rrDebugPush.jitterPhaseCount, 32u);
    for (uint index = 1u; index <= count; ++index) {
        vec2 point = vec2(rrHalton(index, 2u), rrHalton(index, 3u));
        float radius = length((uv - point) * vec2(1.0));
        if (radius < 0.012) {
            color = index == rrDebugPush.jitterPhase
                    ? vec3(1.0, 0.32, 0.05)
                    : vec3(0.25, 0.72, 1.0);
        }
    }
    return color;
}

vec3 rrMotionColor(vec2 motion, ivec2 size) {
    vec2 motionPixels = motion * vec2(size);
    if (!rrFinite(motionPixels)) return RR_INVALID;
    vec3 positive = max(motionPixels.x, 0.0) * vec3(1.0, 0.0, 0.0)
            + max(motionPixels.y, 0.0) * vec3(0.0, 1.0, 0.0);
    vec3 negative = max(-motionPixels.x, 0.0) * vec3(0.0, 1.0, 1.0)
            + max(-motionPixels.y, 0.0) * vec3(1.0, 0.0, 1.0);
    return clamp((positive + negative) * 0.08, 0.0, 1.0);
}

vec3 rrPanel(uint panel, vec2 uv) {
    ivec2 lowSize = imageSize(rrDebugInputColor);
    ivec2 fullSize = imageSize(rrDebugOutput);
    ivec2 lowPixel = rrSourcePixel(uv, lowSize);
    ivec2 fullPixel = rrSourcePixel(uv, fullSize);
    vec4 inputColor = imageLoad(rrDebugInputColor, lowPixel);
    if (panel == RR_INPUT_COLOR) return rrHdr(inputColor.rgb);
    if (panel == RR_MOTION) {
        return rrMotionColor(imageLoad(rrDebugMotion, lowPixel).xy, lowSize);
    }
    if (panel == RR_SPECULAR_MOTION) {
        return rrMotionColor(imageLoad(rrDebugSpecularMotion, lowPixel).xy, lowSize);
    }
    if (panel == RR_DEPTH) {
        float depth = imageLoad(rrDebugDepth, lowPixel).x;
        if (!rrFinite(depth)) return RR_INVALID;
        float mapped = clamp(log2(1.0 + max(depth, 0.0)) / 16.0, 0.0, 1.0);
        return vec3(mapped);
    }
    if (panel == RR_JITTER) return rrJitterPlot(uv);
    vec4 normalRoughness = imageLoad(rrDebugNormalRoughness, lowPixel);
    if (!rrFinite(normalRoughness.xyz) || !rrFinite(normalRoughness.a)) return RR_INVALID;
    if (panel == RR_NORMALS) return clamp(normalRoughness.xyz * 0.5 + 0.5, 0.0, 1.0);
    if (panel == RR_ROUGHNESS) return vec3(clamp(normalRoughness.a, 0.0, 1.0));
    if (panel == RR_DIFFUSE_ALBEDO) {
        vec3 albedo = imageLoad(rrDebugDiffuseAlbedo, lowPixel).rgb;
        if (!rrFinite(albedo)) return RR_INVALID;
        albedo = max(albedo, vec3(0.0));
        return clamp(primeEncodeSrgb(primeLinearRec2020ToLinearBt709(albedo)), 0.0, 1.0);
    }
    if (panel == RR_SPECULAR_ALBEDO) {
        vec3 albedo = imageLoad(rrDebugSpecularAlbedo, lowPixel).rgb;
        if (!rrFinite(albedo)) return RR_INVALID;
        albedo = max(albedo, vec3(0.0));
        return clamp(primeEncodeSrgb(primeLinearRec2020ToLinearBt709(albedo)), 0.0, 1.0);
    }
    if (panel == RR_SPECULAR_HIT_DISTANCE) {
        float hitDistance = imageLoad(rrDebugNoisySpecular, lowPixel).a;
        if (!rrFinite(hitDistance)) return RR_INVALID;
        float mapped = clamp(log2(1.0 + max(hitDistance, 0.0)) / 16.0, 0.0, 1.0);
        return vec3(mapped, mapped * mapped, 1.0 - mapped);
    }
    return rrHdr(imageLoad(rrDebugOutput, fullPixel).rgb);
}

void main() {
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    ivec2 extent = imageSize(rrDebugDisplay);
    if (any(greaterThanEqual(pixel, extent))) return;

    ivec2 panelOrigin;
    ivec2 panelExtent;
    if (rrDebugPush.fullscreen != 0u) {
        panelOrigin = ivec2(0);
        panelExtent = extent;
    } else if (rrDebugPush.view == RR_OVERVIEW) {
        panelExtent = max(ivec2(360, 260), ivec2(vec2(extent) * vec2(0.46, 0.44)));
        panelExtent = min(panelExtent, extent);
        // Prime's Vulkan main target is presented with image row zero at the bottom of the
        // window. Anchor against the opposite image edge so the panel appears top-right.
        panelOrigin = ivec2(extent.x - panelExtent.x, extent.y - panelExtent.y);
    } else {
        panelExtent = max(ivec2(300, 180), ivec2(vec2(extent) * vec2(0.40, 0.36)));
        panelExtent = min(panelExtent, extent);
        panelOrigin = ivec2(extent.x - panelExtent.x, extent.y - panelExtent.y);
    }
    if (any(lessThan(pixel, panelOrigin))
            || any(greaterThanEqual(pixel, panelOrigin + panelExtent))) return;

    ivec2 local = pixel - panelOrigin;
    vec3 color;
    if (rrDebugPush.view == RR_OVERVIEW) {
        const uint panels[10] = uint[10](
                RR_INPUT_COLOR,
                RR_MOTION,
                RR_SPECULAR_MOTION,
                RR_DEPTH,
                RR_NORMALS,
                RR_ROUGHNESS,
                RR_DIFFUSE_ALBEDO,
                RR_SPECULAR_ALBEDO,
                RR_SPECULAR_HIT_DISTANCE,
                RR_OUTPUT);
        ivec2 cellExtent = max(panelExtent / ivec2(5, 2), ivec2(1));
        ivec2 cell = clamp(local / cellExtent, ivec2(0), ivec2(4, 1));
        uint index = uint(cell.y * 5 + cell.x);
        vec2 uv = (vec2(local - cell * cellExtent) + 0.5) / vec2(cellExtent);
        color = rrPanel(panels[index], uv);
        if (local.x % cellExtent.x < 2 || local.y % cellExtent.y < 2) color = vec3(0.85);
    } else {
        vec2 uv = (vec2(local) + 0.5) / vec2(panelExtent);
        color = rrPanel(rrDebugPush.view, uv);
    }
    imageStore(rrDebugDisplay, pixel, vec4(color, 1.0));
}
