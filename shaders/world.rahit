#version 460
#extension GL_GOOGLE_include_directive : require
#include "hit_common.glsl"

void main() {
    PrimitiveRecord primitive = primePrimitive();
    if (primeMaterialIsTransmissive(primePrimitiveFlags(primitive))) {
        // A transmission surface is a real path vertex, not alpha coverage. In particular, a
        // straight NEE shadow segment must not silently pass through another refractive boundary:
        // that would omit its Fresnel/refraction terms and create biased light leaks. Accept the
        // intersection for both radiance and shadow rays; only cutout coverage may be ignored.
        return;
    }
    vec3 normal = primeUnpackOctahedralNormal(primitive.normal);
    float textureLodValue = primeRayConeTextureLod(primitive, normal);
    float opacity = primeEvaluateOpacity(primeInterpolateUv(primitive), textureLodValue);
    if (opacity < PRIME_CUTOUT_ALPHA_THRESHOLD) {
        ignoreIntersectionEXT;
    }
}
