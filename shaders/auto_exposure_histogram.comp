#version 460
#extension GL_GOOGLE_include_directive : require
#extension GL_EXT_samplerless_texture_functions : require

#include "auto_exposure.glsl"

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(set = 0, binding = 0) uniform texture2D primeAutoExposureInput;
layout(set = 0, binding = 1, rgba16f) uniform readonly image2D
        primeAutoExposureAlbedo;
layout(set = 0, binding = 2, rgb10_a2) uniform readonly image2D
        primeAutoExposureNormalRoughness;
layout(std430, set = 0, binding = 3) buffer PrimeAutoExposureHistogram {
    uint bins[256];
    uint validCount;
} primeAutoExposureHistogram;

layout(push_constant) uniform PrimeAutoExposureHistogramPushConstants {
    uvec2 inputExtent;
    uint accumulatedMetering;
    uint reserved;
} primeAutoExposureHistogramPush;

shared uint primeWorkgroupBins[256];
shared uint primeWorkgroupValidCount;

uint primeAutoExposureBin(float luminance) {
    float logLuminance = clamp(
            log2(max(luminance, exp2(PRIME_AUTO_EXPOSURE_MIN_LOG_LUMINANCE))),
            PRIME_AUTO_EXPOSURE_MIN_LOG_LUMINANCE,
            PRIME_AUTO_EXPOSURE_MAX_LOG_LUMINANCE);
    return min(
            uint(floor(
                    (logLuminance - PRIME_AUTO_EXPOSURE_MIN_LOG_LUMINANCE)
                            * (256.0 / PRIME_AUTO_EXPOSURE_LOG_LUMINANCE_RANGE))),
            255u);
}

void main() {
    uint localIndex = gl_LocalInvocationIndex;
    primeWorkgroupBins[localIndex] = 0u;
    if (localIndex == 0u) {
        primeWorkgroupValidCount = 0u;
    }
    barrier();

    uvec2 blockOrigin = gl_WorkGroupID.xy * 64u + gl_LocalInvocationID.xy * 4u;
    for (uint y = 0u; y < 4u; ++y) {
        for (uint x = 0u; x < 4u; ++x) {
            uvec2 pixel = blockOrigin + uvec2(x, y);
            if (any(greaterThanEqual(pixel, primeAutoExposureHistogramPush.inputExtent))) {
                continue;
            }
            vec3 radiance = texelFetch(primeAutoExposureInput, ivec2(pixel), 0).rgb;
            if (any(isnan(radiance)) || any(isinf(radiance))) {
                continue;
            }
            float luminance;
            if (primeAutoExposureHistogramPush.accumulatedMetering != 0u) {
                luminance =
                        texelFetch(primeAutoExposureInput, ivec2(pixel), 0).a;
            } else {
                ivec2 guideExtent = imageSize(primeAutoExposureAlbedo);
                ivec2 guidePixel = min(
                        ivec2(
                                (vec2(pixel) + 0.5)
                                        * vec2(guideExtent)
                                        / vec2(primeAutoExposureHistogramPush.inputExtent)),
                        guideExtent - 1);
                vec4 material =
                        imageLoad(primeAutoExposureAlbedo, guidePixel);
                vec4 normalRoughness =
                        imageLoad(primeAutoExposureNormalRoughness, guidePixel);
                if (any(isnan(material))
                        || any(isinf(material))
                        || any(isnan(normalRoughness))
                        || any(isinf(normalRoughness))) {
                    continue;
                }
                uint materialClass =
                        uint(round(clamp(normalRoughness.a, 0.0, 1.0) * 3.0));
                float confidence = primeAutoExposureMaterialConfidence(
                        materialClass,
                        material.a);
                luminance = primeAutoExposureMeteredLuminance(
                        radiance,
                        material.rgb,
                        confidence);
            }
            if (isnan(luminance) || isinf(luminance)) {
                continue;
            }
            atomicAdd(
                    primeWorkgroupBins[
                            primeAutoExposureBin(luminance)],
                    1u);
            atomicAdd(primeWorkgroupValidCount, 1u);
        }
    }
    barrier();

    uint count = primeWorkgroupBins[localIndex];
    if (count != 0u) {
        atomicAdd(
                primeAutoExposureHistogram.bins[localIndex],
                count);
    }
    if (localIndex == 0u && primeWorkgroupValidCount != 0u) {
        atomicAdd(
                primeAutoExposureHistogram.validCount,
                primeWorkgroupValidCount);
    }
}
