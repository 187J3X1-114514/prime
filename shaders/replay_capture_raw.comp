#version 460

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 0, binding = 0, r32f) uniform readonly image2D primeViewZ;
layout(set = 0, binding = 1, rgba32f) uniform readonly image2D primePrimaryPosition;
layout(set = 0, binding = 2, rgba16f) uniform readonly image2D primeNoisyDiffuse;
layout(set = 0, binding = 3, rgba16f) uniform readonly image2D primeNoisySpecular;
layout(set = 0, binding = 4, rgb10_a2) uniform readonly image2D primeNormalRoughness;
layout(set = 0, binding = 5, rgba16f) uniform readonly image2D primeMaterial;
layout(set = 0, binding = 6, rgba16f) uniform readonly image2D primeSpecularMaterial;
layout(set = 0, binding = 7, rgba16f) uniform readonly image2D primeDiffuseDirection;
layout(set = 0, binding = 8, rgba16f) uniform readonly image2D primeSpecularDirection;
layout(set = 0, binding = 9, rgba32f) uniform readonly image2D primeReflectionPosition;
layout(set = 0, binding = 10, rgba16f) uniform readonly image2D primeReflectionNoisyDiffuse;
layout(set = 0, binding = 11, rgba16f) uniform readonly image2D primeReflectionNoisySpecular;
layout(set = 0, binding = 12, rgb10_a2) uniform readonly image2D primeReflectionNormalRoughness;
layout(set = 0, binding = 13, rgba16f) uniform readonly image2D primeReflectionMaterial;
layout(set = 0, binding = 14, rgba16f) uniform readonly image2D primeReflectionSpecularMaterial;
layout(set = 0, binding = 15, rgba16f) uniform readonly image2D primeReflectionDiffuseDirection;
layout(set = 0, binding = 16, rgba16f) uniform readonly image2D primeReflectionSpecularDirection;
layout(set = 0, binding = 17, rgba32f) uniform readonly image2D primeDisplayPosition;
layout(set = 0, binding = 18, std430) writeonly buffer PrimeReplayCapture {
    uvec4 values[];
} primeCapture;

layout(push_constant) uniform PrimeReplayCapturePush {
    uvec2 extent;
} primePush;

void primeStore(uint signal, uint pixel, vec4 value) {
    uint pixelCount = primePush.extent.x * primePush.extent.y;
    primeCapture.values[signal * pixelCount + pixel] = floatBitsToUint(value);
}

void main() {
    uvec2 pixel = gl_GlobalInvocationID.xy;
    if (any(greaterThanEqual(pixel, primePush.extent))) return;
    ivec2 coordinate = ivec2(pixel);
    uint linearPixel = pixel.y * primePush.extent.x + pixel.x;
    primeStore(0u, linearPixel, imageLoad(primeViewZ, coordinate));
    primeStore(1u, linearPixel, imageLoad(primePrimaryPosition, coordinate));
    primeStore(2u, linearPixel, imageLoad(primeNoisyDiffuse, coordinate));
    primeStore(3u, linearPixel, imageLoad(primeNoisySpecular, coordinate));
    primeStore(4u, linearPixel, imageLoad(primeNormalRoughness, coordinate));
    primeStore(5u, linearPixel, imageLoad(primeMaterial, coordinate));
    primeStore(6u, linearPixel, imageLoad(primeSpecularMaterial, coordinate));
    primeStore(7u, linearPixel, imageLoad(primeDiffuseDirection, coordinate));
    primeStore(8u, linearPixel, imageLoad(primeSpecularDirection, coordinate));
    primeStore(9u, linearPixel, imageLoad(primeReflectionPosition, coordinate));
    primeStore(10u, linearPixel, imageLoad(primeReflectionNoisyDiffuse, coordinate));
    primeStore(11u, linearPixel, imageLoad(primeReflectionNoisySpecular, coordinate));
    primeStore(12u, linearPixel, imageLoad(primeReflectionNormalRoughness, coordinate));
    primeStore(13u, linearPixel, imageLoad(primeReflectionMaterial, coordinate));
    primeStore(14u, linearPixel, imageLoad(primeReflectionSpecularMaterial, coordinate));
    primeStore(15u, linearPixel, imageLoad(primeReflectionDiffuseDirection, coordinate));
    primeStore(16u, linearPixel, imageLoad(primeReflectionSpecularDirection, coordinate));
    primeStore(17u, linearPixel, imageLoad(primeDisplayPosition, coordinate));
}
