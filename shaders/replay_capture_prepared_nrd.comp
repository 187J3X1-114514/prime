#version 460

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 0, binding = 0, rgba16f) uniform readonly image2D primeMotion;
layout(set = 0, binding = 1, rgb10_a2) uniform readonly image2D primeNormalRoughness;
layout(set = 0, binding = 2, r32f) uniform readonly image2D primeViewZ;
layout(set = 0, binding = 3, rgba16f) uniform readonly image2D primeNoisyDiffuse;
layout(set = 0, binding = 4, rgba16f) uniform readonly image2D primeNoisySpecular;
layout(set = 0, binding = 5, rgba16f) uniform readonly image2D primeDiffuseSh1;
layout(set = 0, binding = 6, rgba16f) uniform readonly image2D primeSpecularSh1;
layout(set = 0, binding = 7, rgba16f) uniform readonly image2D primeReflectionMotion;
layout(set = 0, binding = 8, rgb10_a2) uniform readonly image2D primeReflectionNormalRoughness;
layout(set = 0, binding = 9, r32f) uniform readonly image2D primeReflectionViewZ;
layout(set = 0, binding = 10, rgba16f) uniform readonly image2D primeReflectionNoisyDiffuse;
layout(set = 0, binding = 11, rgba16f) uniform readonly image2D primeReflectionNoisySpecular;
layout(set = 0, binding = 12, rgba16f) uniform readonly image2D primeReflectionDiffuseSh1;
layout(set = 0, binding = 13, rgba16f) uniform readonly image2D primeReflectionSpecularSh1;
layout(set = 0, binding = 14, r16f) uniform readonly image2D primeSunPenumbra;
layout(set = 0, binding = 15, r32f) uniform readonly image2D primeFsrDepth;
layout(set = 0, binding = 16, rgba16f) uniform readonly image2D primeFsrMotion;
layout(set = 0, binding = 17, std430) writeonly buffer PrimeReplayCapture {
    uvec4 values[];
} primeCapture;

layout(push_constant) uniform PrimeReplayCapturePush {
    uvec2 extent;
} primePush;

void primeStore(uint signal, uint pixel, vec4 value) {
    uint pixelCount = primePush.extent.x * primePush.extent.y;
    primeCapture.values[signal * pixelCount + pixel] = floatBitsToUint(value);
}

void main() {
    uvec2 pixel = gl_GlobalInvocationID.xy;
    if (any(greaterThanEqual(pixel, primePush.extent))) return;
    ivec2 coordinate = ivec2(pixel);
    uint linearPixel = pixel.y * primePush.extent.x + pixel.x;
    primeStore(0u, linearPixel, imageLoad(primeMotion, coordinate));
    primeStore(1u, linearPixel, imageLoad(primeNormalRoughness, coordinate));
    primeStore(2u, linearPixel, imageLoad(primeViewZ, coordinate));
    primeStore(3u, linearPixel, imageLoad(primeNoisyDiffuse, coordinate));
    primeStore(4u, linearPixel, imageLoad(primeNoisySpecular, coordinate));
    primeStore(5u, linearPixel, imageLoad(primeDiffuseSh1, coordinate));
    primeStore(6u, linearPixel, imageLoad(primeSpecularSh1, coordinate));
    primeStore(7u, linearPixel, imageLoad(primeReflectionMotion, coordinate));
    primeStore(8u, linearPixel, imageLoad(primeReflectionNormalRoughness, coordinate));
    primeStore(9u, linearPixel, imageLoad(primeReflectionViewZ, coordinate));
    primeStore(10u, linearPixel, imageLoad(primeReflectionNoisyDiffuse, coordinate));
    primeStore(11u, linearPixel, imageLoad(primeReflectionNoisySpecular, coordinate));
    primeStore(12u, linearPixel, imageLoad(primeReflectionDiffuseSh1, coordinate));
    primeStore(13u, linearPixel, imageLoad(primeReflectionSpecularSh1, coordinate));
    primeStore(14u, linearPixel, imageLoad(primeSunPenumbra, coordinate));
    primeStore(15u, linearPixel, imageLoad(primeFsrDepth, coordinate));
    primeStore(16u, linearPixel, imageLoad(primeFsrMotion, coordinate));
}
