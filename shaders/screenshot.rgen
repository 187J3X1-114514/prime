#version 460
#extension GL_GOOGLE_include_directive : require

#define PRIME_SCREENSHOT_MODE 1

#include "common.glsl"
#include "atmosphere_rt.glsl"
#include "nrd_common.glsl"

layout(location = 0) rayPayloadEXT TracePayload primePayload;
layout(location = 1) rayPayloadEXT uint primeShadowHitDistanceBits;

#include "sampling.glsl"
#include "bsdf.glsl"
#include "lights.glsl"
#include "integrator.glsl"
#include "camera.glsl"

void main() {
    uvec2 pixel = gl_LaunchIDEXT.xy;
    IntegratorRecord integrator;
    integrator.sunDirectionIntensity = vec4(
            primePush.sunDirection,
            ATM_SPACE_SUN_INTENSITY * primeSunRadianceMultiplier());
    integrator.environmentRadiance = vec4(0.0);
    vec2 cameraSample = primeCameraSample();
    PathState path = primeCameraPath(pixel, 0u, cameraSample);
    PrimeIntegrationResult sampleResult = primeIntegrate(path, integrator);

    // The interactive renderer splits these terms only because NRD needs separate signals.
    // Screenshot mode consumes the complete one-path estimator before any temporal filtering;
    // adding the mutually exclusive estimator partitions is mathematically identical to the
    // unsplit path contribution and retains transparent volume-stack transport.
    vec3 sampleRadiance = primeResolveIntegrationRadiance(sampleResult);
    primeApplyAerialPerspective(
            pixel,
            cameraSample,
            sampleResult.guides.primaryDistance,
            sampleRadiance);
    vec4 previous = imageLoad(primeAccumulation, ivec2(pixel));
    // Alpha stores the negated rejection count, not the accepted count. The latter would stop
    // incrementing at 2^24; the pushed 48-bit ordinal remains exact and can subtract rejections.
    const float maxRejectedSamples = 16777216.0;
    float rejectedSamples = max(-previous.a, 0.0);
    if (!sampleResult.validSample
            || any(isnan(sampleRadiance))
            || any(isinf(sampleRadiance))) {
        // A failed estimator sample must change neither the mean nor its accepted-sample count.
        if (rejectedSamples < maxRejectedSamples) {
            imageStore(primeAccumulation, ivec2(pixel),
                    vec4(previous.rgb, -(rejectedSamples + 1.0)));
        }
        return;
    }
    // Once the exact f32 rejection counter is exhausted, freezing is safer than silently using
    // an incorrect denominator. Reaching it requires more than 16 million failures at one pixel.
    if (rejectedSamples >= maxRejectedSamples) return;

    uint64_t zeroBasedSample = (uint64_t(primePush.path.y) << 16u)
            | uint64_t(primePush.path.x & 0xffffu);
    float sampleCount = float(
            zeroBasedSample + uint64_t(1) - uint64_t(rejectedSamples));
    vec3 mean = previous.rgb + (sampleRadiance - previous.rgb) / sampleCount;
    imageStore(primeAccumulation, ivec2(pixel), vec4(mean, previous.a));
}
