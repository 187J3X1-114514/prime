#version 460
#extension GL_EXT_samplerless_texture_functions : require
#extension GL_GOOGLE_include_directive : require

#include "numerical.glsl"

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 0, binding = 0) uniform texture2D primeNativeDebugInput;
layout(set = 0, binding = 1, rgba8) uniform writeonly image2D primeNativeDebugOutput;

layout(push_constant) uniform PrimeNativeDebugPresentPushConstants {
    uvec2 sourceExtent;
    uvec2 outputExtent;
    uint presentation;
} primeNativeDebugPush;

vec3 primeNumericalCategoryColor(uint flags) {
    if (flags == 0u) return vec3(0.0);
    uint nonFinite = flags & (PRIME_NUMERICAL_NAN
            | PRIME_NUMERICAL_POSITIVE_INFINITY
            | PRIME_NUMERICAL_NEGATIVE_INFINITY);
    if (nonFinite == PRIME_NUMERICAL_NAN) return vec3(1.0, 0.0, 1.0);
    if (nonFinite == PRIME_NUMERICAL_POSITIVE_INFINITY) return vec3(1.0, 0.0, 0.0);
    if (nonFinite == PRIME_NUMERICAL_NEGATIVE_INFINITY) return vec3(0.0, 1.0, 1.0);
    if (nonFinite != 0u) return vec3(1.0);
    if ((flags & PRIME_NUMERICAL_FINITE_NEGATIVE) != 0u) return vec3(0.0, 0.25, 1.0);
    if ((flags & PRIME_NUMERICAL_INVALID_DIRECTION) != 0u) return vec3(1.0, 0.0, 0.5);
    if ((flags & PRIME_NUMERICAL_ABOVE_UNIT) != 0u) return vec3(0.5, 0.0, 1.0);
    return vec3(1.0, 1.0, 0.0);
}

vec3 primeNumericalStageColor(uint stage) {
    switch (stage) {
        case PRIME_NUMERICAL_STAGE_CAMERA: return vec3(0.75, 0.75, 0.75);
        case PRIME_NUMERICAL_STAGE_TRACE: return vec3(0.35, 0.35, 0.35);
        case PRIME_NUMERICAL_STAGE_SURFACE: return vec3(0.1, 0.9, 0.25);
        case PRIME_NUMERICAL_STAGE_MEDIUM: return vec3(0.0, 0.8, 0.8);
        case PRIME_NUMERICAL_STAGE_EMISSION: return vec3(1.0, 0.9, 0.1);
        case PRIME_NUMERICAL_STAGE_DIRECT_LIGHT: return vec3(1.0, 0.45, 0.05);
        case PRIME_NUMERICAL_STAGE_BSDF_EVALUATE: return vec3(0.15, 0.45, 1.0);
        case PRIME_NUMERICAL_STAGE_BSDF_SAMPLE: return vec3(0.75, 0.1, 1.0);
        case PRIME_NUMERICAL_STAGE_PATH_ADVANCE: return vec3(1.0, 0.1, 0.1);
        case PRIME_NUMERICAL_STAGE_TRANSPARENT_BRANCH: return vec3(0.1, 1.0, 0.65);
        case PRIME_NUMERICAL_STAGE_GUIDE: return vec3(0.45, 0.2, 1.0);
        case PRIME_NUMERICAL_STAGE_ACCUMULATION: return vec3(1.0, 0.2, 0.55);
        case PRIME_NUMERICAL_STAGE_FINAL_OUTPUT: return vec3(1.0);
        default: return vec3(0.5);
    }
}

void main() {
    uvec2 pixel = gl_GlobalInvocationID.xy;
    if (any(greaterThanEqual(pixel, primeNativeDebugPush.outputExtent))) return;
    uvec2 sourcePixel = min(
            (pixel * primeNativeDebugPush.sourceExtent)
                    / primeNativeDebugPush.outputExtent,
            primeNativeDebugPush.sourceExtent - uvec2(1u));
    vec4 source = texelFetch(primeNativeDebugInput, ivec2(sourcePixel), 0);
    vec3 color = source.rgb;
    if (primeNativeDebugPush.presentation == 1u) {
        color = primeNumericalCategoryColor(uint(round(source.r)));
    } else if (primeNativeDebugPush.presentation == 2u) {
        uint flags = uint(round(source.r));
        uint stage = uint(round(source.g));
        bool nonFinite = (flags & (PRIME_NUMERICAL_NAN
                | PRIME_NUMERICAL_POSITIVE_INFINITY
                | PRIME_NUMERICAL_NEGATIVE_INFINITY)) != 0u;
        color = flags == 0u
                ? vec3(0.0)
                : primeNumericalStageColor(stage) * (nonFinite ? 1.0 : 0.65);
    }
    imageStore(primeNativeDebugOutput, ivec2(pixel), vec4(color, 1.0));
}
