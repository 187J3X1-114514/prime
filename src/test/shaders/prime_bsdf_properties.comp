#version 460
#extension GL_GOOGLE_include_directive : require

#define PRIME_RC_TRANSMISSION_GGX_SET 0
#define PRIME_RC_TRANSMISSION_GGX_BINDING 2
#define PRIME_COLOR_WORKING_SPACE_LINEAR_REC2020_D65 1
#define PRIME_COLOR_TEXTURE_ENCODING_SRGB 1
#define PRIME_COLOR_DISPLAY_ENCODING_SRGB 1
#define PRIME_COLOR_DISPLAY_SPACE_REC709_D65 1
#include "prime_test_abi.glsl"
#include "numerical.glsl"

uint primeAdapterDiagnosticFlags = 0u;

void primeAdapterRecord(uint flags) {
    primeAdapterDiagnosticFlags |= flags;
}

void primeRecordNonFinite(float value) {
    primeAdapterRecord(primeClassifyNonFinite(value));
}

void primeRecordNonFinite(vec3 value) {
    primeAdapterRecord(primeClassifyNonFinite(value));
}

void primeRecordNonnegative(float value) {
    primeAdapterRecord(primeClassifyNonnegative(value));
}

void primeRecordNonnegative(vec3 value) {
    primeAdapterRecord(primeClassifyNonnegative(value));
}

void primeRecordRadiance(vec3 value) {
    primeAdapterRecord(primeClassifyRadiance(value));
}

void primeRecordUnit(float value) {
    primeAdapterRecord(primeClassifyUnit(value));
}

void primeRecordUnit(vec3 value) {
    primeAdapterRecord(primeClassifyUnit(value));
}

void primeRecordDirection(vec3 value) {
    primeAdapterRecord(primeClassifyDirection(value));
}

#include "bsdf.glsl"

struct SurfaceInteraction {
    vec3 baseColor;
    uint materialFlags;
    float t;
    uint opacity;
    uint shadingNormal;
    uint labPbrNormal;
    uint labPbrSpecular;
};

vec3 primeSurfaceOutwardShadingNormal(SurfaceInteraction surface) {
    return vec3(0.0, 0.0, 1.0);
}

float primeSurfaceOpacity(SurfaceInteraction surface) {
    return clamp(uintBitsToFloat(surface.opacity), 0.0, 1.0);
}

#include "offline_bsdf.glsl"

const uint PRIME_ADAPTER_INPUT_WORDS = 7u;
const uint PRIME_ADAPTER_WITNESS_WORDS = 12u;

const uint PRIME_ADAPTER_OPAQUE = 0u;
const uint PRIME_ADAPTER_TRANSMISSION = 1u;
const uint PRIME_ADAPTER_FOLIAGE = 2u;
const uint PRIME_ADAPTER_PRIMARY_SPLIT = 3u;
const uint PRIME_ADAPTER_COMPLETE_TRANSMISSION = 4u;

struct PrimeAdapterResult {
    uint mask;
    BsdfSample first;
    BsdfSample second;
    BsdfEvaluation sampledEvaluation;
    BsdfEvaluation probeEvaluation;
    PrimeDenoiseAlbedos albedos;
    uvec2 stackCounts;
};

float primeAdapterFloat(uvec4 encoded[7], uint index) {
    uint flatIndex = index + 4u;
    return uintBitsToFloat(encoded[flatIndex / 4u][flatIndex % 4u]);
}

PrimeRcVolumeStack primeAdapterStack(uint count) {
    PrimeRcVolumeStack stack = primeEmptyVolumeStack();
    PrimeRcVolume volume;
    volume.extinction = vec3(0.01, 0.02, 0.04);
    volume.albedo = vec3(0.0);
    volume.anisotropy = 0.0;
    volume.ior = 1.333;
    primeRcStackPush(stack, volume);
    volume.extinction = vec3(0.02, 0.01, 0.005);
    volume.ior = 1.5;
    primeRcStackPush(stack, volume);
    stack.count = min(count, PRIME_RC_MAX_VOLUME_STACK_SIZE);
    return stack;
}

void primeAdapterClassify(inout uint mask, float value) {
    mask |= primeTestClassify(value);
}

void primeAdapterClassify(inout uint mask, vec3 value) {
    mask |= primeTestClassify(value);
}

bool primeAdapterZero(vec3 value) {
    return all(equal(value, vec3(0.0)));
}

bool primeAdapterSameSample(BsdfSample first, BsdfSample second) {
    return all(equal(first.direction, second.direction))
            && all(equal(first.response, second.response))
            && first.pdf == second.pdf
            && first.relativeEta == second.relativeEta
            && first.eventFlags == second.eventFlags;
}

bool primeAdapterSameStack(
        PrimeRcVolumeStack first,
        PrimeRcVolumeStack second) {
    if (first.count != second.count) return false;
    for (uint index = 0u; index < first.count; index++) {
        PrimeRcVolume a = first.values[index];
        PrimeRcVolume b = second.values[index];
        if (!all(equal(a.extinction, b.extinction))
                || !all(equal(a.albedo, b.albedo))
                || a.anisotropy != b.anisotropy
                || a.ior != b.ior) {
            return false;
        }
    }
    return true;
}

uint primeAdapterExpectedTransparentStackCount(
        PrimeRcState state,
        uint materialFlags,
        PrimeRcVolumeStack stack) {
    if (state.geometryThinWalled != 0u) {
        return stack.count;
    }
    if (state.entering != 0u) {
        return min(stack.count + 1u, PRIME_RC_MAX_VOLUME_STACK_SIZE);
    }
    return stack.count > 0u ? stack.count - 1u : 0u;
}

float primeAdapterExpectedInterfaceIor(
        PrimeRcState state,
        uint materialFlags,
        PrimeRcVolumeStack stack) {
    return state.specularFresnel.ior;
}

float primeAdapterExpectedRelativeIor(
        PrimeRcState state,
        uint materialFlags,
        PrimeRcVolumeStack stack) {
    float interfaceIor =
            primeAdapterExpectedInterfaceIor(state, materialFlags, stack);
    return state.entering != 0u ? interfaceIor : 1.0 / interfaceIor;
}

bool primeAdapterCanRefract(
        PrimeRcState state,
        uint materialFlags,
        vec3 outwardNormal,
        vec3 viewDirection,
        PrimeRcVolumeStack stack) {
    if (state.geometryThinWalled != 0u) return true;
    float relativeIor =
            primeAdapterExpectedRelativeIor(state, materialFlags, stack);
    float cosine = dot(outwardNormal, viewDirection);
    float sineSquared = max(0.0, 1.0 - cosine * cosine);
    return 1.0 - sineSquared / (relativeIor * relativeIor) > 0.0;
}

vec3 primeAdapterExpectedRefraction(
        PrimeRcState state,
        uint materialFlags,
        vec3 outwardNormal,
        vec3 viewDirection,
        PrimeRcVolumeStack stack) {
    float relativeIor =
            primeAdapterExpectedRelativeIor(state, materialFlags, stack);
    vec3 interfaceNormal = state.entering != 0u
            ? outwardNormal
            : -outwardNormal;
    return refract(-viewDirection, interfaceNormal, 1.0 / relativeIor);
}

bool primeAdapterSnellConsistent(
        BsdfSample sampleValue,
        vec3 outwardNormal,
        vec3 viewDirection) {
    float incidentSine = length(
            viewDirection - dot(outwardNormal, viewDirection) * outwardNormal);
    float transmittedSine = length(
            sampleValue.direction
                    - dot(outwardNormal, sampleValue.direction) * outwardNormal);
    return primeTestClose(
            incidentSine,
            sampleValue.relativeEta * transmittedSine,
            2.0e-5,
            2.0e-5);
}

void primeAdapterCheckEvaluation(
        inout uint mask, BsdfEvaluation evaluation) {
    primeAdapterClassify(mask, evaluation.response);
    primeAdapterClassify(mask, evaluation.pdf);
    if (any(lessThan(evaluation.response, vec3(0.0))) || evaluation.pdf < 0.0) {
        mask |= PRIME_TEST_FAILURE_RANGE;
    }
}

void primeAdapterCheckTransmissionMaterial(
        inout uint mask,
        PrimeRcState state,
        vec3 baseColor,
        uint materialFlags,
        uint packedNormal,
        uint packedSpecular) {
    if ((materialFlags & PRIME_MATERIAL_FLAG_WATER) != 0u) {
        return;
    }
    PrimeTranslatedLabPbrMaterial translated = primeDecodeAndTranslateLabPbr(
            packedNormal, packedSpecular, materialFlags);
    float expectedRoughness = primeMaterialIsRoughGlass(materialFlags)
            ? translated.perceptualRoughness
            : 0.0;
    vec3 expectedColor = primeMaterialIsColorlessGlass(materialFlags)
            ? vec3(1.0)
            : primeGlassVolumeTransmittance(
                    baseColor, PRIME_STAINED_GLASS_ABSORPTION_OPACITY);
    if (!primeTestClose(
                    state.material.specular.roughness,
                    expectedRoughness,
                    0.0,
                    0.0)
            || !primeTestClose(
                    state.material.transmission.color,
                    expectedColor,
                    0.0,
                    0.0)) {
        mask |= PRIME_TEST_FAILURE_STATE;
    }
}

void primeAdapterCheckMinimumRoughness(
        inout uint mask,
        PrimeRcMaterial original,
        PrimeRcMaterial clamped,
        float minimumLinearRoughness) {
    float expected = max(original.specular.roughness, minimumLinearRoughness);
    if (!primeTestClose(clamped.specular.roughness, expected, 0.0, 0.0)) {
        mask |= PRIME_TEST_FAILURE_STATE;
    }
}

void primeAdapterCheckSample(
        inout uint mask,
        BsdfSample sampleValue,
        vec3 outwardNormal,
        vec3 viewDirection) {
    const uint knownEvents = PRIME_BSDF_EVENT_REFLECTION
            | PRIME_BSDF_EVENT_TRANSMISSION
            | PRIME_BSDF_EVENT_DIFFUSE
            | PRIME_BSDF_EVENT_GLOSSY
            | PRIME_BSDF_EVENT_DELTA;
    if (sampleValue.eventFlags == 0u) {
        if (!primeAdapterZero(sampleValue.direction)
                || !primeAdapterZero(sampleValue.response)
                || sampleValue.pdf != 0.0
                || sampleValue.relativeEta != 1.0) {
            mask |= PRIME_TEST_FAILURE_EVENT;
        }
        return;
    }

    primeAdapterClassify(mask, sampleValue.direction);
    primeAdapterClassify(mask, sampleValue.response);
    primeAdapterClassify(mask, sampleValue.pdf);
    primeAdapterClassify(mask, sampleValue.relativeEta);
    if ((sampleValue.eventFlags & ~knownEvents) != 0u
            || ((sampleValue.eventFlags & PRIME_BSDF_EVENT_REFLECTION) != 0u)
                    == ((sampleValue.eventFlags & PRIME_BSDF_EVENT_TRANSMISSION) != 0u)
            || sampleValue.pdf <= 0.0
            || sampleValue.relativeEta <= 0.0
            || any(lessThan(sampleValue.response, vec3(0.0)))) {
        mask |= PRIME_TEST_FAILURE_EVENT;
    }
    uint lobe = sampleValue.eventFlags
            & (PRIME_BSDF_EVENT_DIFFUSE
                    | PRIME_BSDF_EVENT_GLOSSY
                    | PRIME_BSDF_EVENT_DELTA);
    if (lobe == 0u || (lobe & (lobe - 1u)) != 0u) {
        mask |= PRIME_TEST_FAILURE_EVENT;
    }
    if (!primeTestClose(length(sampleValue.direction), 1.0, 8.0e-5, 8.0e-5)) {
        mask |= PRIME_TEST_FAILURE_UNIT_LENGTH;
    }
    float sideProduct = dot(outwardNormal, viewDirection)
            * dot(outwardNormal, sampleValue.direction);
    bool reflected = (sampleValue.eventFlags & PRIME_BSDF_EVENT_REFLECTION) != 0u;
    if ((reflected && sideProduct <= 0.0) || (!reflected && sideProduct >= 0.0)) {
        mask |= PRIME_TEST_FAILURE_HEMISPHERE;
    }
}

void primeAdapterProperties(
        uint kind, uvec4 encoded[7], out PrimeAdapterResult result) {
    result.mask = 0u;
    result.first = primeInvalidBsdfSample();
    result.second = primeInvalidBsdfSample();
    result.sampledEvaluation = primeInvalidBsdfEvaluation();
    result.probeEvaluation = primeInvalidBsdfEvaluation();
    result.albedos.diffuse = vec3(0.0);
    result.albedos.specular = vec3(0.0);
    result.stackCounts = uvec2(0u);

    uint materialFlags = encoded[0].y;
    uint packedNormal = encoded[0].z;
    uint packedSpecular = encoded[0].w;
    vec3 baseColor = vec3(
            primeAdapterFloat(encoded, 0u),
            primeAdapterFloat(encoded, 1u),
            primeAdapterFloat(encoded, 2u));
    float opacity = primeAdapterFloat(encoded, 3u);
    vec3 outwardNormal = normalize(vec3(
            primeAdapterFloat(encoded, 4u),
            primeAdapterFloat(encoded, 5u),
            primeAdapterFloat(encoded, 6u)));
    float rayT = primeAdapterFloat(encoded, 7u);
    vec3 viewDirection = normalize(vec3(
            primeAdapterFloat(encoded, 8u),
            primeAdapterFloat(encoded, 9u),
            primeAdapterFloat(encoded, 10u)));
    uint stackCount = min(encoded[3].w, PRIME_RC_MAX_VOLUME_STACK_SIZE);
    vec3 firstSample = vec3(
            primeAdapterFloat(encoded, 12u),
            primeAdapterFloat(encoded, 13u),
            primeAdapterFloat(encoded, 14u));
    vec3 secondSample = vec3(
            primeAdapterFloat(encoded, 15u),
            primeAdapterFloat(encoded, 16u),
            primeAdapterFloat(encoded, 17u));
    vec3 probeDirection = normalize(vec3(
            primeAdapterFloat(encoded, 18u),
            primeAdapterFloat(encoded, 19u),
            primeAdapterFloat(encoded, 20u)));
    PrimeRcVolumeStack stack = primeAdapterStack(stackCount);

    if (kind == PRIME_ADAPTER_OPAQUE) {
        result.first = primeSampleOpaque(
                baseColor,
                outwardNormal,
                packedNormal,
                packedSpecular,
                materialFlags,
                viewDirection,
                firstSample,
                rayT,
                stack);
        if (result.first.eventFlags != 0u) {
            PrimeBsdfComponents components = primeEvaluateOpaqueComponents(
                    baseColor,
                    outwardNormal,
                    packedNormal,
                    packedSpecular,
                    materialFlags,
                    viewDirection,
                    result.first.direction,
                    rayT,
                    stack);
            result.sampledEvaluation.response =
                    components.diffuseResponse + components.specularResponse;
            result.sampledEvaluation.pdf = components.pdf;
        }
        PrimeBsdfComponents probe = primeEvaluateOpaqueComponents(
                baseColor,
                outwardNormal,
                packedNormal,
                packedSpecular,
                materialFlags,
                viewDirection,
                probeDirection,
                rayT,
                stack);
        result.probeEvaluation.response =
                probe.diffuseResponse + probe.specularResponse;
        result.probeEvaluation.pdf = probe.pdf;
        PrimeRcState state = primeOpaqueState(
                baseColor,
                outwardNormal,
                packedNormal,
                packedSpecular,
                materialFlags,
                viewDirection,
                rayT,
                stack);
        const float minimumLinearRoughness = 0.4;
        primeAdapterCheckMinimumRoughness(
                result.mask,
                primeOpaqueMaterial(
                        baseColor,
                        outwardNormal,
                        packedNormal,
                        packedSpecular,
                        materialFlags),
                primeOpaqueMaterialWithMinimumRoughness(
                        baseColor,
                        outwardNormal,
                        packedNormal,
                        packedSpecular,
                        materialFlags,
                        minimumLinearRoughness),
                minimumLinearRoughness);
        result.albedos = primeDenoiseAlbedosFromState(
                state, viewDirection, PRIME_DENOISE_CLOSURE_OPAQUE);
    } else if (kind == PRIME_ADAPTER_FOLIAGE) {
        result.first = primeSampleMinecraftFoliage(
                baseColor,
                outwardNormal,
                packedNormal,
                packedSpecular,
                materialFlags,
                viewDirection,
                firstSample,
                rayT,
                stack);
        if (result.first.eventFlags != 0u) {
            result.sampledEvaluation = primeEvaluateMinecraftFoliage(
                    baseColor,
                    outwardNormal,
                    packedNormal,
                    packedSpecular,
                    materialFlags,
                    viewDirection,
                    result.first.direction,
                    rayT,
                    stack);
        }
        result.probeEvaluation = primeEvaluateMinecraftFoliage(
                baseColor,
                outwardNormal,
                packedNormal,
                packedSpecular,
                materialFlags,
                viewDirection,
                probeDirection,
                rayT,
                stack);
        PrimeRcState state = primeMinecraftFoliageState(
                baseColor,
                outwardNormal,
                packedNormal,
                packedSpecular,
                materialFlags,
                viewDirection,
                rayT,
                stack);
        const float minimumLinearRoughness = 0.4;
        primeAdapterCheckMinimumRoughness(
                result.mask,
                primeMinecraftFoliageMaterial(
                        baseColor,
                        outwardNormal,
                        packedNormal,
                        packedSpecular,
                        materialFlags),
                primeMinecraftFoliageMaterialWithMinimumRoughness(
                        baseColor,
                        outwardNormal,
                        packedNormal,
                        packedSpecular,
                        materialFlags,
                        minimumLinearRoughness),
                minimumLinearRoughness);
        result.albedos = primeDenoiseAlbedosFromState(
                state, viewDirection, PRIME_DENOISE_CLOSURE_FOLIAGE);
    } else if (kind == PRIME_ADAPTER_TRANSMISSION) {
        PrimeRcState state = primeMinecraftTransmissionState(
                baseColor,
                opacity,
                outwardNormal,
                materialFlags,
                packedNormal,
                packedSpecular,
                viewDirection,
                rayT,
                stack);
        const float minimumLinearRoughness = 0.4;
        primeAdapterCheckMinimumRoughness(
                result.mask,
                primeMinecraftTransmissionMaterial(
                        baseColor,
                        opacity,
                        outwardNormal,
                        materialFlags,
                        packedNormal,
                        packedSpecular),
                primeMinecraftTransmissionMaterialWithMinimumRoughness(
                        baseColor,
                        opacity,
                        outwardNormal,
                        materialFlags,
                        packedNormal,
                        packedSpecular,
                        minimumLinearRoughness),
                minimumLinearRoughness);
        primeAdapterCheckTransmissionMaterial(
                result.mask,
                state,
                baseColor,
                materialFlags,
                packedNormal,
                packedSpecular);
        PrimeTransmissiveBsdfSample sampled =
                primeSampleMinecraftTransparentContinuation(
                baseColor,
                opacity,
                outwardNormal,
                materialFlags,
                packedNormal,
                packedSpecular,
                viewDirection,
                rayT,
                stack);
        result.first = sampled.bsdfSample;
        result.stackCounts.x = sampled.volumeStack.count;
        PrimeTransmissiveBsdfSample repeated =
                primeSampleMinecraftTransparentContinuation(
                baseColor,
                opacity,
                outwardNormal,
                materialFlags,
                packedNormal,
                packedSpecular,
                viewDirection,
                rayT,
                stack);
        result.albedos.diffuse = state.transmissionTint;
        result.albedos.specular = vec3(0.0);
        bool thinWalled = state.geometryThinWalled != 0u;
        bool canRefract = primeAdapterCanRefract(
                state,
                materialFlags,
                outwardNormal,
                viewDirection,
                stack);
        bool totalInternalReflection = !thinWalled && !canRefract;
        uint expectedEvents = totalInternalReflection
                ? PRIME_BSDF_EVENT_REFLECTION | PRIME_BSDF_EVENT_DELTA
                : PRIME_BSDF_EVENT_TRANSMISSION | PRIME_BSDF_EVENT_DELTA;
        vec3 expectedDirection = thinWalled
                ? -viewDirection
                : (totalInternalReflection
                        ? reflect(-viewDirection, outwardNormal)
                        : primeAdapterExpectedRefraction(
                                state,
                                materialFlags,
                                outwardNormal,
                                viewDirection,
                                stack));
        float expectedRelativeIor = thinWalled || totalInternalReflection
                ? 1.0
                : primeAdapterExpectedRelativeIor(
                        state, materialFlags, stack);
        vec3 expectedResponse = totalInternalReflection
                ? vec3(1.0)
                : state.transmissionTint
                        / primeRcSquare(expectedRelativeIor);
        uint expectedStackCount = totalInternalReflection
                ? stack.count
                : primeAdapterExpectedTransparentStackCount(
                        state, materialFlags, stack);
        if (!primeAdapterSameSample(result.first, repeated.bsdfSample)
                || !primeAdapterSameStack(sampled.volumeStack, repeated.volumeStack)) {
            result.mask |= PRIME_TEST_FAILURE_STATE;
        }
        if (!primeTestClose(
                result.first.direction, expectedDirection, 2.0e-6, 2.0e-6)) {
            result.mask |= PRIME_TEST_FAILURE_HEMISPHERE;
        }
        if (!primeTestClose(
                result.first.response, expectedResponse, 2.0e-6, 2.0e-6)) {
            result.mask |= PRIME_TEST_FAILURE_VALUE;
        }
        if (result.first.pdf != 1.0) result.mask |= PRIME_TEST_FAILURE_PDF;
        if (!primeTestClose(
                result.first.relativeEta, expectedRelativeIor, 2.0e-6, 2.0e-6)) {
            result.mask |= PRIME_TEST_FAILURE_ROUND_TRIP;
        }
        if (result.first.eventFlags != expectedEvents) {
            result.mask |= PRIME_TEST_FAILURE_EVENT;
        }
        if (sampled.volumeStack.count != expectedStackCount) {
            result.mask |= PRIME_TEST_FAILURE_INDEX;
        }
        if (!thinWalled
                && !totalInternalReflection
                && !primeAdapterSnellConsistent(
                        result.first, outwardNormal, viewDirection)) {
            result.mask |= PRIME_TEST_FAILURE_IDENTITY;
        }
    } else if (kind == PRIME_ADAPTER_PRIMARY_SPLIT) {
        PrimeTransmissivePrimarySample sampled =
                primeSampleMinecraftTransmissionPrimary(
                baseColor,
                opacity,
                outwardNormal,
                materialFlags,
                packedNormal,
                packedSpecular,
                viewDirection,
                firstSample,
                rayT,
                stack);
        result.first = sampled.paths.reflection.bsdfSample;
        result.second = sampled.paths.transmission.bsdfSample;
        result.stackCounts = uvec2(
                sampled.paths.reflection.volumeStack.count,
                sampled.paths.transmission.volumeStack.count);
        result.albedos = sampled.albedos;
        PrimeRcState state = primeMinecraftTransmissionState(
                baseColor,
                opacity,
                outwardNormal,
                materialFlags,
                packedNormal,
                packedSpecular,
                viewDirection,
                rayT,
                stack);
        primeAdapterCheckTransmissionMaterial(
                result.mask,
                state,
                baseColor,
                materialFlags,
                packedNormal,
                packedSpecular);
        vec3 localView =
                primeRcOnbToLocal(state.material.geometry.onb, viewDirection);
        PrimeMinecraftMirrorSplit mirror =
                primeMinecraftMirrorSplit(state, localView);
        PrimeTransmissivePrimarySample repeated =
                primeSampleMinecraftTransmissionPrimary(
                        baseColor,
                        opacity,
                        outwardNormal,
                        materialFlags,
                        packedNormal,
                        packedSpecular,
                        viewDirection,
                        secondSample,
                        rayT,
                        stack);
        bool thinWalled = state.geometryThinWalled != 0u;
        bool canRefract = primeAdapterCanRefract(
                state,
                materialFlags,
                outwardNormal,
                viewDirection,
                stack);
        bool validTransmission = thinWalled || canRefract;
        PrimeRcMicrofacet transmissionMicrofacet =
                primeMinecraftTransmissionMicrofacet(state);
        bool smoothTransmission = primeMinecraftTransmissionIsDelta(state);
        vec3 expectedDirection = thinWalled
                ? -viewDirection
                : primeAdapterExpectedRefraction(
                        state,
                        materialFlags,
                        outwardNormal,
                        viewDirection,
                        stack);
        float expectedRelativeIor = thinWalled
                ? 1.0
                : primeAdapterExpectedRelativeIor(
                        state, materialFlags, stack);
        uint expectedStackCount = primeAdapterExpectedTransparentStackCount(
                state, materialFlags, stack);
        if ((smoothTransmission
                        && !primeAdapterSameSample(
                                result.second,
                                repeated.paths.transmission.bsdfSample))
                || (smoothTransmission
                        && !primeAdapterSameStack(
                                sampled.paths.transmission.volumeStack,
                                repeated.paths.transmission.volumeStack))
                || !primeAdapterSameStack(
                        sampled.paths.reflection.volumeStack, stack)
                || !all(equal(
                        result.albedos.diffuse,
                        primeMinecraftPrimaryTransmissionAlbedo(
                                state, materialFlags)))
                || !all(equal(result.albedos.specular, mirror.reflectance))) {
            result.mask |= PRIME_TEST_FAILURE_IDENTITY;
        }
        if (!smoothTransmission) {
            state.samplingFlags = PRIME_RC_FLAG_TRANSMISSION;
            PrimeRcSampleResult reference = primeRcPrimeTransmissionSample(
                    localView, firstSample, state, stack);
            BsdfSample expected = primeInvalidBsdfSample();
            if (primeRcHasSample(reference.bsdfSample)) {
                expected.direction = primeRcOnbToWorld(
                        state.material.geometry.onb, reference.bsdfSample.wo);
                expected.response = reference.bsdfSample.throughput.value;
                expected.pdf = reference.bsdfSample.pdf;
                expected.relativeEta = reference.bsdfSample.eta;
                expected.eventFlags = primeRcToBsdfEventFlags(
                        reference.bsdfSample.throughput.flags);
                expected = primeSanitizeBsdfSample(expected);
            }
            PrimeRcVolumeStack expectedStack = expected.eventFlags == 0u
                    ? stack
                    : reference.volumeStack;
            if (!primeAdapterSameSample(result.second, expected)
                    || !primeAdapterSameStack(
                            sampled.paths.transmission.volumeStack,
                            expectedStack)) {
                result.mask |= PRIME_TEST_FAILURE_IDENTITY;
            }
            if (result.second.eventFlags != 0u) {
                BsdfEvaluation evaluated =
                        primeEvaluateMinecraftTransparentTransmission(
                                baseColor,
                                opacity,
                                outwardNormal,
                                materialFlags,
                                packedNormal,
                                packedSpecular,
                                viewDirection,
                                result.second.direction,
                                rayT,
                                stack);
                vec3 localScatter = primeRcOnbToLocal(
                        state.material.geometry.onb, result.second.direction);
                bool stableReconstruction = min(
                                transmissionMicrofacet.alpha.x,
                                transmissionMicrofacet.alpha.y) >= 5.0e-3
                        && abs(localView.z) >= 1.0e-1
                        && abs(localScatter.z) >= 5.0e-2;
                if (stableReconstruction
                        && (!primeTestClose(
                                        result.second.response,
                                        evaluated.response,
                                        3.0e-6,
                                        2.0e-3)
                                || !primeTestClose(
                                        result.second.pdf,
                                        evaluated.pdf,
                                        3.0e-6,
                                        2.0e-3))) {
                    result.mask |= PRIME_TEST_FAILURE_PDF;
                }
            }
        } else if (validTransmission) {
            uint expectedEvents = PRIME_BSDF_EVENT_TRANSMISSION
                    | PRIME_BSDF_EVENT_DELTA;
            vec3 expectedResponse = (vec3(1.0) - mirror.reflectance)
                    * state.transmissionTint
                    / primeRcSquare(expectedRelativeIor);
            if (!primeTestClose(
                    result.second.direction, expectedDirection, 2.0e-6, 2.0e-6)) {
                result.mask |= PRIME_TEST_FAILURE_HEMISPHERE;
            }
            if (!primeTestClose(
                    result.second.response,
                    expectedResponse,
                    2.0e-6,
                    2.0e-6)) {
                result.mask |= PRIME_TEST_FAILURE_VALUE;
            }
            if (result.second.pdf != 1.0) result.mask |= PRIME_TEST_FAILURE_PDF;
            if (!primeTestClose(
                    result.second.relativeEta,
                    expectedRelativeIor,
                    2.0e-6,
                    2.0e-6)) {
                result.mask |= PRIME_TEST_FAILURE_ROUND_TRIP;
            }
            if (result.second.eventFlags != expectedEvents) {
                result.mask |= PRIME_TEST_FAILURE_EVENT;
            }
            if (sampled.paths.transmission.volumeStack.count != expectedStackCount) {
                result.mask |= PRIME_TEST_FAILURE_INDEX;
            }
            if (!thinWalled
                    && !primeAdapterSnellConsistent(
                            result.second, outwardNormal, viewDirection)) {
                result.mask |= PRIME_TEST_FAILURE_IDENTITY;
            }
        } else if (result.second.eventFlags != 0u
                || !primeAdapterZero(result.second.direction)
                || !primeAdapterZero(result.second.response)
                || result.second.pdf != 0.0
                || result.second.relativeEta != 1.0
                || !primeAdapterSameStack(
                        sampled.paths.transmission.volumeStack, stack)) {
            result.mask |= PRIME_TEST_FAILURE_IDENTITY;
        }
        if (result.first.eventFlags != 0u
                && (result.first.eventFlags & PRIME_BSDF_EVENT_DELTA) == 0u) {
            result.sampledEvaluation =
                    primeEvaluateMinecraftTransparentReflection(
                    baseColor,
                    opacity,
                    outwardNormal,
                    materialFlags,
                    packedNormal,
                    packedSpecular,
                    viewDirection,
                    result.first.direction,
                    rayT,
                    stack);
            vec3 localScatter =
                    primeRcOnbToLocal(state.material.geometry.onb, result.first.direction);
            bool stableReconstruction =
                    min(
                            state.specularMicrofacet.alpha.x,
                            state.specularMicrofacet.alpha.y) >= 5.0e-3
                    && abs(localView.z) >= 1.0e-1
                    && abs(localScatter.z) >= 5.0e-2;
            if (stableReconstruction
                    && !primeTestClose(
                            result.first.response,
                            result.sampledEvaluation.response,
                            3.0e-6,
                            2.0e-3)) {
                result.mask |= PRIME_TEST_FAILURE_VALUE;
            }
            if (stableReconstruction
                    && !primeTestClose(
                            result.first.pdf,
                            result.sampledEvaluation.pdf,
                            3.0e-6,
                            2.0e-3)) {
                result.mask |= PRIME_TEST_FAILURE_PDF;
            }
        }
        result.probeEvaluation = primeEvaluateMinecraftTransparentReflection(
                baseColor,
                opacity,
                outwardNormal,
                materialFlags,
                packedNormal,
                packedSpecular,
                viewDirection,
                probeDirection,
                rayT,
                stack);
    } else {
        PrimeRcState state = primeMinecraftTransmissionState(
                baseColor,
                opacity,
                outwardNormal,
                materialFlags,
                packedNormal,
                packedSpecular,
                viewDirection,
                rayT,
                stack);
        primeAdapterCheckTransmissionMaterial(
                result.mask,
                state,
                baseColor,
                materialFlags,
                packedNormal,
                packedSpecular);
        PrimeTransmissiveBsdfSample sampled =
                primeSampleMinecraftTransmissionCompleteFromState(
                        state,
                        baseColor,
                        opacity,
                        materialFlags,
                        viewDirection,
                        firstSample,
                        stack);
        PrimeTransmissiveBsdfSample offline =
                primeSampleOfflineMinecraftTransmissionFromState(
                        state,
                        baseColor,
                        opacity,
                        materialFlags,
                        viewDirection,
                        firstSample,
                        stack);
        result.first = sampled.bsdfSample;
        result.stackCounts.x = sampled.volumeStack.count;

        state.samplingFlags = PRIME_RC_FLAG_ALL;
        vec3 localView = primeRcOnbToLocal(
                state.material.geometry.onb, viewDirection);
        PrimeRcSampleResult reference = primeRcPrimeTransmissionSample(
                localView, firstSample, state, stack);
        BsdfSample expected = primeInvalidBsdfSample();
        if (primeRcHasSample(reference.bsdfSample)) {
            expected.direction = primeRcOnbToWorld(
                    state.material.geometry.onb, reference.bsdfSample.wo);
            expected.response = reference.bsdfSample.throughput.value;
            expected.pdf = reference.bsdfSample.pdf;
            expected.relativeEta = reference.bsdfSample.eta;
            expected.eventFlags = primeRcToBsdfEventFlags(
                    reference.bsdfSample.throughput.flags);
            expected = primeSanitizeBsdfSample(expected);
        }
        PrimeRcVolumeStack expectedStack = expected.eventFlags == 0u
                ? stack
                : reference.volumeStack;
        if (!primeAdapterSameSample(result.first, expected)
                || !primeAdapterSameStack(sampled.volumeStack, expectedStack)
                || !primeAdapterSameSample(
                        sampled.bsdfSample, offline.bsdfSample)
                || !primeAdapterSameStack(
                        sampled.volumeStack, offline.volumeStack)
                || ((result.first.eventFlags & PRIME_BSDF_EVENT_REFLECTION) != 0u
                        && !primeAdapterSameStack(sampled.volumeStack, stack))
                || primeOfflineSkipsRussianRoulette(result.first)
                || primeOfflineHasNonDeltaLobe(
                        PRIME_MATERIAL_FLAG_TRANSMISSIVE,
                        vec3(1.0),
                        0.0)
                || primeOfflineHasNonDeltaLobe(
                        PRIME_MATERIAL_FLAG_LABPBR_METAL,
                        vec3(1.0),
                        0.0)
                || !primeOfflineHasNonDeltaLobe(
                        PRIME_MATERIAL_FLAG_LABPBR_METAL,
                        vec3(1.0),
                        0.01)
                || !primeOfflineHasNonDeltaLobe(0u, vec3(1.0), 0.0)
                || !primeOfflineHasNonDeltaLobe(
                        PRIME_MATERIAL_FLAG_FOLIAGE,
                        vec3(0.0),
                        0.0)) {
            result.mask |= PRIME_TEST_FAILURE_IDENTITY;
        }
        result.probeEvaluation =
                primeEvaluateMinecraftTransmissionCompleteFromState(
                        state,
                        baseColor,
                        opacity,
                        materialFlags,
                        viewDirection,
                        probeDirection);
        if (result.first.eventFlags != 0u
                && (result.first.eventFlags & PRIME_BSDF_EVENT_DELTA) == 0u) {
            result.sampledEvaluation =
                    primeEvaluateMinecraftTransmissionCompleteFromState(
                            state,
                            baseColor,
                            opacity,
                            materialFlags,
                            viewDirection,
                            result.first.direction);
            vec3 localScatter = primeRcOnbToLocal(
                    state.material.geometry.onb, result.first.direction);
            bool stableReconstruction = min(
                    state.transmissionMicrofacet.alpha.x,
                    state.transmissionMicrofacet.alpha.y) >= 5.0e-3
                    && abs(localView.z) >= 1.0e-1
                    && abs(localScatter.z) >= 5.0e-2;
            if (stableReconstruction && (!primeTestClose(
                            result.first.response,
                            result.sampledEvaluation.response,
                            3.0e-6,
                            2.0e-3)
                    || !primeTestClose(
                            result.first.pdf,
                            result.sampledEvaluation.pdf,
                            3.0e-6,
                            2.0e-3))) {
                result.mask |= PRIME_TEST_FAILURE_PDF;
            }
        }
    }

    primeAdapterCheckSample(
            result.mask, result.first, outwardNormal, viewDirection);
    primeAdapterCheckSample(
            result.mask, result.second, outwardNormal, viewDirection);
    primeAdapterCheckEvaluation(result.mask, result.sampledEvaluation);
    primeAdapterCheckEvaluation(result.mask, result.probeEvaluation);
    primeAdapterClassify(result.mask, result.albedos.diffuse);
    primeAdapterClassify(result.mask, result.albedos.specular);
    if (any(lessThan(result.albedos.diffuse, vec3(0.0)))
            || any(greaterThan(result.albedos.diffuse, vec3(1.0)))
            || any(lessThan(result.albedos.specular, vec3(0.0)))
            || any(greaterThan(result.albedos.specular, vec3(1.0)))
            || any(greaterThan(
                    result.stackCounts, uvec2(PRIME_RC_MAX_VOLUME_STACK_SIZE)))) {
        result.mask |= PRIME_TEST_FAILURE_RANGE;
    }

    uint nonFinite = primeAdapterDiagnosticFlags
            & (PRIME_NUMERICAL_NAN
                    | PRIME_NUMERICAL_POSITIVE_INFINITY
                    | PRIME_NUMERICAL_NEGATIVE_INFINITY);
    result.mask |= nonFinite;
    if ((primeAdapterDiagnosticFlags
            & (PRIME_NUMERICAL_FINITE_NEGATIVE
                    | PRIME_NUMERICAL_INVALID_DIRECTION)) != 0u) {
        result.mask |= PRIME_TEST_FAILURE_RANGE;
    }
}

void main() {
    uint caseIndex;
    if (!primeTestBegin(caseIndex)) return;
    uint inputOffset = primeTestInputOffset(caseIndex, PRIME_ADAPTER_INPUT_WORDS);
    uvec4 encoded[7];
    for (uint word = 0u; word < PRIME_ADAPTER_INPUT_WORDS; word++) {
        encoded[word] = primeTestInput.words[inputOffset + word];
    }
    uint kind = encoded[0].x;
    PrimeAdapterResult result;
    primeAdapterProperties(kind, encoded, result);

    uint outputOffset = primeTestOutputOffset(caseIndex, primeTestOutputWords());
    primeTestOutput.words[outputOffset] = uvec4(result.mask, kind, caseIndex, 0u);
    if (!primeTestWitnessEnabled()) return;
    primeTestOutput.words[outputOffset + 1u] = uvec4(
            floatBitsToUint(result.first.direction), result.first.eventFlags);
    primeTestOutput.words[outputOffset + 2u] = uvec4(
            floatBitsToUint(result.first.response), floatBitsToUint(result.first.pdf));
    primeTestOutput.words[outputOffset + 3u] = uvec4(
            floatBitsToUint(result.first.relativeEta),
            result.second.eventFlags,
            result.stackCounts);
    primeTestOutput.words[outputOffset + 4u] = uvec4(
            floatBitsToUint(result.second.direction), 0u);
    primeTestOutput.words[outputOffset + 5u] = uvec4(
            floatBitsToUint(result.second.response), floatBitsToUint(result.second.pdf));
    primeTestOutput.words[outputOffset + 6u] = uvec4(
            floatBitsToUint(result.sampledEvaluation.response),
            floatBitsToUint(result.sampledEvaluation.pdf));
    primeTestOutput.words[outputOffset + 7u] = uvec4(
            floatBitsToUint(result.probeEvaluation.response),
            floatBitsToUint(result.probeEvaluation.pdf));
    primeTestOutput.words[outputOffset + 8u] = uvec4(
            floatBitsToUint(result.albedos.diffuse), primeAdapterDiagnosticFlags);
    primeTestOutput.words[outputOffset + 9u] = uvec4(
            floatBitsToUint(result.albedos.specular), 0u);
    primeTestOutput.words[outputOffset + 10u] = encoded[0];
    primeTestOutput.words[outputOffset + 11u] = encoded[3];
}
