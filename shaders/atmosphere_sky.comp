#version 460
#extension GL_GOOGLE_include_directive : require
#include "atmosphere.glsl"
#include "atmosphere_phase.glsl"

layout(set = 0, binding = 0, rgba16f) uniform readonly image2D transmittanceLow;
layout(set = 0, binding = 1, rgba16f) uniform readonly image2D transmittanceHigh;
layout(set = 0, binding = 2, rgba16f) uniform readonly image2D multiScatteringLow;
layout(set = 0, binding = 3, rgba16f) uniform readonly image2D multiScatteringHigh;
layout(set = 0, binding = 4, rgba16f) uniform writeonly image2D skyView;

ATM_DECLARE_SAMPLE_2D(sampleTransmittanceLow, transmittanceLow)
ATM_DECLARE_SAMPLE_2D(sampleTransmittanceHigh, transmittanceHigh)
ATM_DECLARE_SAMPLE_2D(sampleMultiScatteringLow, multiScatteringLow)
ATM_DECLARE_SAMPLE_2D(sampleMultiScatteringHigh, multiScatteringHigh)

layout(push_constant) uniform AtmospherePushConstants {
    mat4 inverseViewProjection;
    float eyeRadiusKm;
    float maximumAerialDistanceKm;
    vec2 padding;
    vec4 sunDirectionIntensity;
} atmospherePush;

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

const int SKY_STEPS = 128;

vec4 skyTransmittance(int group, float sunMu, float normalizedAltitude) {
    vec2 uv = atmTransmittanceUv(sunMu, normalizedAltitude);
    return group == 0
            ? sampleTransmittanceLow(uv)
            : sampleTransmittanceHigh(uv);
}

vec4 skyMultiScattering(int group, float sunMu, float normalizedAltitude) {
    vec2 dimensions = vec2(imageSize(multiScatteringLow));
    vec2 uv = atmMultiUv(sunMu, normalizedAltitude, dimensions);
    return group == 0
            ? sampleMultiScatteringLow(uv)
            : sampleMultiScatteringHigh(uv);
}

vec4 integrateSkyGroup(int group, vec3 origin, vec3 direction, AtmRaySegment segment) {
    vec3 sunDirection = atmospherePush.sunDirectionIntensity.xyz;
    float phaseCosine = dot(-direction, sunDirection);
    float molecularPhase = atmRayleighPhase(phaseCosine);
    vec4 radiance = vec4(0.0);
    vec4 transmittance = vec4(1.0);
    for (int index = 0; index < SKY_STEPS; ++index) {
        float u0 = float(index) / float(SKY_STEPS);
        float u1 = float(index + 1) / float(SKY_STEPS);
        float t0 = u0 * u0 * segment.maximumDistanceKm;
        float t1 = u1 * u1 * segment.maximumDistanceKm;
        float t = mix(t0, t1, 0.3);
        float stepLength = max(t1 - t0, 0.0);
        vec3 point = origin + direction * t;
        float radius = length(point);
        vec3 up = point / max(radius, 1.0e-6);
        float altitude = max(radius - ATM_BOTTOM_RADIUS_KM, 0.0);
        float normalizedAltitude = altitude / ATM_THICKNESS_KM;
        float sunMu = dot(up, sunDirection);
        bool sunOccluded = atmRaySegment(point - up * ATM_PLANET_RADIUS_OFFSET_KM,
                sunDirection).hitsGround;
        AtmCoefficients coefficients = atmCoefficients(group, altitude);
        vec4 direct = sunOccluded ? vec4(0.0)
                : skyTransmittance(group, sunMu, normalizedAltitude)
                * (coefficients.molecularScattering * molecularPhase
                + atmAerosolPhaseScattering(group, altitude, phaseCosine));
        vec4 multiple = skyMultiScattering(group, sunMu, normalizedAltitude)
                * (coefficients.aerosolScattering + coefficients.molecularScattering);
        vec4 source = atmSolarSpectrum(group) * (direct + multiple);
        vec4 stepTransmittance = exp(-stepLength * coefficients.extinction);
        vec4 safeExtinction = max(coefficients.extinction, vec4(1.0e-7));
        radiance += transmittance * (source - source * stepTransmittance) / safeExtinction;
        transmittance *= stepTransmittance;
    }
    if (segment.hitsGround) {
        vec3 ground = origin + direction * segment.groundDistanceKm;
        vec3 normal = normalize(ground);
        float sunMu = dot(normal, sunDirection);
        vec4 groundLight = skyMultiScattering(group, sunMu, 0.0);
        float cosine = max(sunMu, 0.0);
        if (cosine > 0.0) {
            groundLight += skyTransmittance(group, cosine, 0.0) * cosine * ATM_INV_PI;
        }
        radiance += atmSolarSpectrum(group) * groundLight * vec4(0.18) * transmittance;
    }
    return radiance;
}

void main() {
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    ivec2 dimensions = imageSize(skyView);
    if (any(greaterThanEqual(pixel, dimensions))) {
        return;
    }
    vec2 uv = (vec2(pixel) + vec2(0.5)) / vec2(dimensions);
    vec3 direction = atmSkyDirection(
            atmSkyUvToParameters(uv, vec2(dimensions), atmospherePush.eyeRadiusKm),
            atmospherePush.sunDirectionIntensity.xyz);
    vec3 origin = atmMoveToTop(vec3(0.0, atmospherePush.eyeRadiusKm, 0.0), direction);
    AtmRaySegment segment = atmRaySegment(origin, direction);
    if (segment.maximumDistanceKm < 0.0) {
        imageStore(skyView, pixel, vec4(0.0));
        return;
    }
    vec4 low = integrateSkyGroup(0, origin, direction, segment);
    vec4 high = integrateSkyGroup(1, origin, direction, segment);
    vec3 rec2020 = max(atmLinearRec2020FromSpectral(low, high), vec3(0.0));
    imageStore(skyView, pixel, vec4(rec2020, 1.0));
}
