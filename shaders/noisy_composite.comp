#version 460
#extension GL_GOOGLE_include_directive : require

#include "atmosphere.glsl"
#include "nrd_common.glsl"

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 0, binding = 0, rgba16f) uniform readonly image2D primeNoisyDiffuse;
layout(set = 0, binding = 1, rgba16f) uniform readonly image2D primeNoisySpecular;
layout(set = 0, binding = 2, rgba16f) uniform readonly image2D primeNoisyMaterial;
layout(set = 0, binding = 3, rgba32f) uniform readonly image2D primeNoisyStableRadiance;
layout(set = 0, binding = 4, rgba16f) uniform readonly image2D primeNoisySunLighting;
layout(set = 0, binding = 5, rgba16f) uniform readonly image3D primeNoisyAerialRadiance;
layout(set = 0, binding = 6, rgba16f) uniform readonly image3D primeNoisyAerialTransmittance;
layout(set = 0, binding = 7, rgba16f) uniform writeonly image2D primeNoisyOutput;

layout(push_constant) uniform PrimeNoisyCompositePushConstants {
    uvec2 outputExtent;
    float sunRadianceMultiplier;
} primeNoisyPush;

ATM_DECLARE_SAMPLE_3D(primeNoisySampleAerialRadiance, primeNoisyAerialRadiance)
ATM_DECLARE_SAMPLE_3D(primeNoisySampleAerialTransmittance, primeNoisyAerialTransmittance)

void primeNoisyApplyAerial(uvec2 pixel, float primaryDistance, inout vec3 radiance) {
    if (!primeNrdIsFinite(primaryDistance) || primaryDistance < 0.0) return;
    float distanceKm = primaryDistance * ATM_WORLD_UNIT_SCALE_KM;
    ivec3 dimensions = imageSize(primeNoisyAerialRadiance);
    float firstSliceDepth = 0.5 / float(max(dimensions.z, 1));
    float firstSliceDistanceKm = ATM_AERIAL_MAX_DISTANCE_KM
            * firstSliceDepth * firstSliceDepth;
    float normalizedDepth = max(firstSliceDepth, sqrt(clamp(
            distanceKm / max(ATM_AERIAL_MAX_DISTANCE_KM, 1.0e-6), 0.0, 1.0)));
    float nearWeight = clamp(
            distanceKm / max(firstSliceDistanceKm, 1.0e-6), 0.0, 1.0);
    vec2 screenUv = (vec2(pixel) + vec2(0.5)) / vec2(primeNoisyPush.outputExtent);
    vec3 uvw = vec3(screenUv, normalizedDepth);
    vec3 inscatter = max(primeNoisySampleAerialRadiance(uvw).rgb, vec3(0.0));
    vec3 transmittance = clamp(
            primeNoisySampleAerialTransmittance(uvw).rgb, vec3(0.0), vec3(1.0));
    if (any(isnan(inscatter)) || any(isinf(inscatter))) inscatter = vec3(0.0);
    if (any(isnan(transmittance)) || any(isinf(transmittance))) {
        transmittance = vec3(1.0);
    }
    radiance = radiance * mix(vec3(1.0), transmittance, nearWeight)
            + inscatter * nearWeight * primeNoisyPush.sunRadianceMultiplier;
}

void main() {
    uvec2 pixel = gl_GlobalInvocationID.xy;
    if (any(greaterThanEqual(pixel, primeNoisyPush.outputExtent))) return;

    vec4 material = imageLoad(primeNoisyMaterial, ivec2(pixel));
    if (!primeNrdIsFinite(material.a) || material.a < 0.0) {
        imageStore(
                primeNoisyOutput,
                ivec2(pixel),
                vec4(primeNrdClampRadiance(
                        imageLoad(primeNoisyStableRadiance, ivec2(pixel)).rgb,
                        PRIME_NRD_FP16_MAX), 1.0));
        return;
    }
    vec4 sun = imageLoad(primeNoisySunLighting, ivec2(pixel));
    vec3 surface = primeNrdSanitizeRadiance(
            imageLoad(primeNoisyDiffuse, ivec2(pixel)).rgb)
            + primeNrdSanitizeRadiance(
                    imageLoad(primeNoisySpecular, ivec2(pixel)).rgb)
            + primeNrdSanitizeRadiance(sun.rgb)
                    * primeNrdSanitizeUnit(sun.a, 0.0);
    vec3 stable = primeNrdClampRadiance(
            imageLoad(primeNoisyStableRadiance, ivec2(pixel)).rgb,
            PRIME_NRD_FP16_MAX);
    vec3 radiance = surface + stable;
    primeNoisyApplyAerial(pixel, material.a, radiance);
    imageStore(
            primeNoisyOutput,
            ivec2(pixel),
            vec4(primeNrdClampRadiance(radiance, PRIME_NRD_FP16_MAX), 1.0));
}
