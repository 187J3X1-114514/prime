#version 460
#extension GL_GOOGLE_include_directive : require

#include "sun_shadow_hierarchy.glsl"

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

struct PrimeSunShadowLeafCase {
    float rayDepthAtZero;
    float rayDepthRate;
    float startDistance;
    float endDistance;
    float blockerDepth;
    float bias;
};

layout(set = 0, binding = 0, std430) readonly buffer PrimeSunShadowLeafInput {
    PrimeSunShadowLeafCase values[];
} primeSunShadowLeafInput;

layout(set = 0, binding = 1, std430) writeonly buffer PrimeSunShadowLeafOutput {
    float values[];
} primeSunShadowLeafOutput;

layout(push_constant) uniform PrimeSunShadowLeafPush {
    uint count;
} primeSunShadowLeafPush;

void main() {
    uint index = gl_GlobalInvocationID.x;
    if (index >= primeSunShadowLeafPush.count) {
        return;
    }
    PrimeSunShadowLeafCase value = primeSunShadowLeafInput.values[index];
    primeSunShadowLeafOutput.values[index] =
            primeSunShadowLeafVisibleLength(
                    value.rayDepthAtZero,
                    value.rayDepthRate,
                    value.startDistance,
                    value.endDistance,
                    value.blockerDepth,
                    value.bias);
}
