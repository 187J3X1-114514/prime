#version 460
#define PRIME_OFFLINE_ABI 1
#extension GL_GOOGLE_include_directive : require
#extension GL_EXT_control_flow_attributes : require
#if defined(PRIME_ENABLE_SUBGROUP_QUEUE)
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_shader_subgroup_ballot : require
#endif
#if defined(PRIME_ENABLE_SER)
#extension GL_EXT_buffer_reference_uvec2 : require
#extension GL_EXT_shader_invocation_reorder : require
#endif

#include "common.glsl"
#include "atmosphere_rt.glsl"
#include "nrd_common.glsl"
#include "shadow_payload.glsl"

layout(location = 0) rayPayloadEXT TracePayload primePayload;
layout(location = 1) rayPayloadEXT PrimeShadowPayload primeShadowPayload;

#include "sampling.glsl"
#include "bsdf.glsl"
#include "lights.glsl"
#include "integrator.glsl"
#include "camera.glsl"
#include "offline_bsdf.glsl"
#include "offline_wavefront_state.glsl"
#include "offline_integrator.glsl"
#include "offline_output.glsl"

const uint PRIME_OFFLINE_STAGE_HEAD = 0u;
const uint PRIME_OFFLINE_STAGE_STEP = 1u;
const uint PRIME_OFFLINE_STAGE_AREA = 2u;
const uint PRIME_OFFLINE_STAGE_TAIL = 3u;
const uint PRIME_OFFLINE_STAGE_RESOLVE = 4u;
layout(constant_id = 0) const uint primeOfflineSpecializedStage =
        PRIME_OFFLINE_STAGE_HEAD;

layout(shaderRecordEXT, std430) buffer PrimeOfflineShaderRecord {
    uint control;
} primeOfflineShaderRecord;

IntegratorRecord primeOfflineIntegrator() {
    IntegratorRecord integrator;
    integrator.sunDirectionIntensity = vec4(
            primePush.sunDirection,
            ATM_SPACE_SUN_INTENSITY * primeSunRadianceMultiplier());
    integrator.environmentRadiance = vec4(0.0);
    return integrator;
}

PrimeRcVolumeStack primeOfflineInitialVolumeStack() {
    return (primePush.path.z & PRIME_PATH_CAMERA_IN_WATER_MASK) != 0u
            ? primeCameraWaterVolumeStack()
            : primeEmptyVolumeStack();
}

PrimeOfflinePathRecord primeMakeOfflineRecord(
        PathState path,
        PrimeRcVolumeStack volumeStack,
        vec3 radiance,
        float primaryDistance,
        vec3 primaryAlbedo,
        uint primaryMaterialFlags,
        PrimeOfflineAreaRequest request,
        bool enabled) {
    PrimeOfflinePathRecord record;
    record.transport = primeMakeOfflineTransport(
            path, volumeStack, enabled);
    if (request.valid && request.startingMediumCount > volumeStack.count) {
        // Deferred Area visibility starts before the BSDF event, while transport stores the
        // post-event stack. An exiting event frees exactly the old top slot; retain its RGB
        // extinction there so Area can reconstruct the pre-event medium without growing ABI.
        PrimeRcVolume startingMedium;
        startingMedium.extinction = request.startingExtinction;
        startingMedium.albedo = vec3(0.0);
        startingMedium.anisotropy = 0.0;
        startingMedium.ior = 1.0;
        uint startingIndex = request.startingMediumCount - 1u;
        if (startingIndex == 0u) {
            record.transport.medium0 = primePackWavefrontMedium(startingMedium);
        } else {
            record.transport.medium1 = primePackWavefrontMedium(startingMedium);
        }
    }
    record.radianceAndPrimaryDistance = vec4(radiance, primaryDistance);
    record.primaryAlbedoAndMaterialFlags = vec4(
            primaryAlbedo, uintBitsToFloat(primaryMaterialFlags));
    record.areaDirectionAndDistance = vec4(request.direction, request.distance);
    record.areaContributionAndValid = vec4(
            request.contribution,
            uintBitsToFloat(primeOfflineAreaControl(
                    path.previousLightNormal,
                    request.valid,
                    request.startingMediumCount)));
    return record;
}

void primeWavefrontHead() {
    uvec2 pixel = gl_LaunchIDEXT.xy;
    uint pathIndex = primeOfflineIndex(pixel);
    vec2 cameraSample = primeOfflineCameraSample();
    PathState path = primeCameraPath(pixel, 0u, cameraSample);
    PrimeRcVolumeStack volumeStack = primeOfflineInitialVolumeStack();
    vec3 radiance = vec3(0.0);
    float primaryDistance = -1.0;
    vec3 primaryAlbedo = vec3(1.0);
    uint primaryMaterialFlags = 0u;
    PrimeOfflineAreaRequest request = primeEmptyOfflineAreaRequest();
    uint maximumBounces = primeMaximumBounces();
    bool continuation = false;
    if (maximumBounces != 0u) {
        primeSetNumericalContext(PRIME_NUMERICAL_STAGE_TRACE, 0u);
        SurfaceInteraction surface = primeTraceSurface(
                primePush.cameraPosition, path.rayDirection);
        continuation = primeIntegrateOfflineSurface(
                path,
                primeOfflineIntegrator(),
                volumeStack,
                radiance,
                primaryDistance,
                primaryAlbedo,
                primaryMaterialFlags,
                surface,
                false,
                request);
        continuation = continuation && path.bounce < maximumBounces;
    }
    primeOfflinePaths.records[pathIndex] = primeMakeOfflineRecord(
            path,
            volumeStack,
            radiance,
            primaryDistance,
            primaryAlbedo,
            primaryMaterialFlags,
            request,
            continuation);
    primeAppendOfflineContinuation(0u, pathIndex, continuation);
}

void primeWavefrontStep(uint sourceQueue) {
    uint pathIndex = primeOfflineQueuedPath(sourceQueue, gl_LaunchIDEXT.x);
    PrimeOfflineTransportRecord traceRecord =
            primeOfflinePaths.records[pathIndex].transport;
    uint bounce = floatBitsToUint(traceRecord.traceOriginAndPathControl.w)
            & PRIME_OFFLINE_PATH_BYTE_MASK;
    primeSetNumericalContext(PRIME_NUMERICAL_STAGE_TRACE, bounce);
    SurfaceInteraction surface = primeTraceSurface(
            traceRecord.traceOriginAndPathControl.xyz,
            traceRecord.rayDirectionAndControl.xyz);

    PrimeOfflinePathRecord record = primeOfflinePaths.records[pathIndex];
    uvec2 pixel = primeOfflinePixel(pathIndex);
    PathState path = primeOfflinePath(
            pixel,
            record.transport,
            primeOfflinePreviousLightNormal(record));
    PrimeRcVolumeStack volumeStack = primeOfflineVolumeStack(record.transport);
    vec3 radiance = record.radianceAndPrimaryDistance.xyz;
    float primaryDistance = record.radianceAndPrimaryDistance.w;
    vec3 primaryAlbedo = record.primaryAlbedoAndMaterialFlags.xyz;
    uint primaryMaterialFlags = floatBitsToUint(
            record.primaryAlbedoAndMaterialFlags.w);
    PrimeOfflineAreaRequest request;
    bool continuation = primeIntegrateOfflineSurface(
            path,
            primeOfflineIntegrator(),
            volumeStack,
            radiance,
            primaryDistance,
            primaryAlbedo,
            primaryMaterialFlags,
            surface,
            true,
            request);
    continuation = continuation && path.bounce < primeMaximumBounces();
    primeOfflinePaths.records[pathIndex] = primeMakeOfflineRecord(
            path,
            volumeStack,
            radiance,
            primaryDistance,
            primaryAlbedo,
            primaryMaterialFlags,
            request,
            continuation);
}

void primeWavefrontArea(uint sourceQueue) {
    uint pathIndex = primeOfflineQueuedPath(sourceQueue, gl_LaunchIDEXT.x);
    PrimeOfflinePathRecord record = primeOfflinePaths.records[pathIndex];
    uint areaControl = floatBitsToUint(record.areaContributionAndValid.w);
    if ((areaControl & PRIME_OFFLINE_AREA_VALID) != 0u) {
        PrimeOfflineAreaRequest request;
        request.direction = record.areaDirectionAndDistance.xyz;
        request.distance = record.areaDirectionAndDistance.w;
        request.contribution = record.areaContributionAndValid.xyz;
        request.valid = true;
        PrimeRcVolumeStack storedMedia = primeOfflineVolumeStack(record.transport);
        request.startingMediumCount = primeOfflineAreaStartingMediumCount(record);
        request.startingExtinction = request.startingMediumCount > 0u
                ? storedMedia.values[request.startingMediumCount - 1u].extinction
                : vec3(0.0);
        PrimeShadowTrace shadow = primeTraceOfflineAreaShadow(
                record.transport.physicalOriginAndPreviousBsdfPdf.xyz,
                request,
                storedMedia);
        if (shadow.hitDistance >= PRIME_NRD_FP16_MAX) {
            record.radianceAndPrimaryDistance.xyz +=
                    request.contribution * shadow.transmittance;
        }
    }
    primeClearOfflineAreaRequest(record);
    primeOfflinePaths.records[pathIndex] = record;
    primeAppendOfflineContinuation(
            sourceQueue ^ 1u,
            pathIndex,
            primeOfflineIsActive(record));
}

void primeWavefrontTail(uint sourceQueue) {
    uint pathIndex = primeOfflineQueuedPath(sourceQueue, gl_LaunchIDEXT.x);
    PrimeOfflinePathRecord record = primeOfflinePaths.records[pathIndex];
    uvec2 pixel = primeOfflinePixel(pathIndex);
    PathState path = primeOfflinePath(
            pixel,
            record.transport,
            primeOfflinePreviousLightNormal(record));
    PrimeRcVolumeStack volumeStack = primeOfflineVolumeStack(record.transport);
    vec3 radiance = record.radianceAndPrimaryDistance.xyz;
    float primaryDistance = record.radianceAndPrimaryDistance.w;
    vec3 primaryAlbedo = record.primaryAlbedoAndMaterialFlags.xyz;
    uint primaryMaterialFlags = floatBitsToUint(
            record.primaryAlbedoAndMaterialFlags.w);
    PrimeOfflineAreaRequest request;
    [[dont_unroll]]
    while (path.bounce < primeMaximumBounces()) {
        primeSetNumericalContext(PRIME_NUMERICAL_STAGE_TRACE, path.bounce);
        SurfaceInteraction surface = primeTraceSurfaceWithoutReorder(
                path.traceOrigin, path.rayDirection);
        if (!primeIntegrateOfflineSurface(
                path,
                primeOfflineIntegrator(),
                volumeStack,
                radiance,
                primaryDistance,
                primaryAlbedo,
                primaryMaterialFlags,
                surface,
                false,
                request)) {
            break;
        }
    }
    primeOfflinePaths.records[pathIndex] = primeMakeOfflineRecord(
            path,
            volumeStack,
            radiance,
            primaryDistance,
            primaryAlbedo,
            primaryMaterialFlags,
            primeEmptyOfflineAreaRequest(),
            false);
}

void primeWavefrontResolve() {
    uvec2 pixel = gl_LaunchIDEXT.xy;
    primeWriteOfflineOutput(
            pixel,
            primeOfflineCameraSample(),
            primeOfflinePaths.records[primeOfflineIndex(pixel)]);
}

void main() {
    uint sourceQueue = (primeOfflineShaderRecord.control >> 8u) & 1u;
    switch (primeOfflineSpecializedStage) {
        case PRIME_OFFLINE_STAGE_HEAD:
            primeWavefrontHead();
            break;
        case PRIME_OFFLINE_STAGE_STEP:
            primeWavefrontStep(sourceQueue);
            break;
        case PRIME_OFFLINE_STAGE_AREA:
            primeWavefrontArea(sourceQueue);
            break;
        case PRIME_OFFLINE_STAGE_TAIL:
            primeWavefrontTail(sourceQueue);
            break;
        case PRIME_OFFLINE_STAGE_RESOLVE:
            primeWavefrontResolve();
            break;
    }
}
