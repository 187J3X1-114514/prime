#version 460
#extension GL_GOOGLE_include_directive : require

#include "atmosphere_epipolar.glsl"

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

struct PrimeEpipolarCase {
    vec2 epipoleNdc;
    vec2 screenNdc;
};

layout(set = 0, binding = 0, std430) readonly buffer PrimeEpipolarInput {
    PrimeEpipolarCase values[];
} primeEpipolarInput;

layout(set = 0, binding = 1, std430) writeonly buffer PrimeEpipolarOutput {
    vec4 values[];
} primeEpipolarOutput;

layout(push_constant) uniform PrimeEpipolarPush {
    uint count;
} primeEpipolarPush;

void main() {
    uint index = gl_GlobalInvocationID.x;
    if (index >= primeEpipolarPush.count) {
        return;
    }
    PrimeEpipolarCase value = primeEpipolarInput.values[index];
    AtmEpipolarRange range = atmEpipolarVisibleRange(
            value.epipoleNdc);
    float mappedCoordinate = atmEpipolarRangeCoordinate(
            range,
            value.epipoleNdc,
            value.screenNdc);
    AtmEpipolarSegment segment;
    if (range.parallel) {
        vec2 perpendicular = vec2(-range.axis.y, range.axis.x);
        float offset = mix(
                -range.extent,
                range.extent,
                mappedCoordinate);
        segment = atmEpipolarRaySegment(
                perpendicular * offset - range.axis * 4.0,
                range.axis);
    } else {
        float mappedAngle =
                range.start + mappedCoordinate * range.span;
        segment = atmEpipolarRaySegment(
                value.epipoleNdc,
                vec2(cos(mappedAngle), sin(mappedAngle)));
    }
    float radial = atmEpipolarRadialCoordinate(
            value.screenNdc,
            segment);
    vec2 reconstructed = mix(segment.entry, segment.exit, radial);
    float boundaryError = min(
            abs(abs(segment.exit.x) - 1.0),
            abs(abs(segment.exit.y) - 1.0));
    primeEpipolarOutput.values[index] = vec4(
            reconstructed,
            boundaryError,
            segment.valid ? 1.0 : 0.0);
}
