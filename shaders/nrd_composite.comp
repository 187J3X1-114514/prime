#version 460
#extension GL_GOOGLE_include_directive : require

#include "atmosphere.glsl"
#include "display_transform.glsl"
#include "fsr_input.glsl"
#include "nrd_common.glsl"
#include "nrd_sh.glsl"

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

// FSR consumes scene-referred linear Rec.2020 HDR. The Oklab display transform belongs strictly
// after upscaling; applying it here would make temporal interpolation operate on non-linear,
// display-referred values and violate both the integrator and FSR signal contracts.
layout(set = 0, binding = 0, rgba16f) uniform writeonly image2D primeCompositeOutput;
layout(set = 0, binding = 1, rgba16f) uniform readonly image2D primeDenoisedDiffuse;
layout(set = 0, binding = 2, rgba16f) uniform readonly image2D primeDenoisedSpecular;
layout(set = 0, binding = 3, rgba16f) uniform readonly image2D primeCompositeMaterial;
layout(set = 0, binding = 4, rgba16f) uniform readonly image2D primeCompositeSpecularMaterial;
layout(set = 0, binding = 5, rgba32f) uniform readonly image2D primeStableAccumulation;
layout(set = 0, binding = 6, rgba16f) uniform readonly image3D primeCompositeAerialRadiance;
layout(set = 0, binding = 7, rgba16f) uniform readonly image3D primeCompositeAerialTransmittance;
layout(set = 0, binding = 8, rgba8) uniform image2D primeNrdValidation;
layout(set = 0, binding = 9, rgba16f) uniform readonly image2D primeReprojectionError;
layout(set = 0, binding = 10, rgba16f) uniform readonly image2D primeMotionDiagnostic;
layout(set = 0, binding = 11, r8) uniform writeonly image2D primeFsrReactiveMask;
layout(set = 0, binding = 12, r8) uniform writeonly image2D primeFsrTransparencyCompositionMask;
layout(set = 0, binding = 13, rgba16f) uniform readonly image2D primeUnshadowedSunLighting;
layout(set = 0, binding = 14, r16f) uniform readonly image2D primeSigmaSunShadow;
layout(set = 0, binding = 15, rgba16f) uniform readonly image2D primeDenoisedDiffuseSh1;
layout(set = 0, binding = 16, rgba16f) uniform readonly image2D primeDenoisedSpecularSh1;
layout(set = 0, binding = 17, rgb10_a2) uniform readonly image2D primeCompositeNormalRoughness;
layout(set = 0, binding = 18, r32f) uniform readonly image2D primeCompositeViewZ;
layout(set = 0, binding = 19, rgba32f) uniform readonly image2D primeCompositePrimaryPosition;
layout(set = 0, binding = 20, rgba16f) uniform readonly image2D primeNoisySpecular;
layout(set = 0, binding = 21, rgba16f) uniform readonly image2D primeReflectionDenoisedDiffuse;
layout(set = 0, binding = 22, rgba16f) uniform readonly image2D primeReflectionDenoisedSpecular;
layout(set = 0, binding = 23, rgba16f) uniform readonly image2D primeReflectionCompositeMaterial;
layout(set = 0, binding = 24, rgba16f) uniform readonly image2D primeReflectionCompositeSpecularMaterial;
layout(set = 0, binding = 25, rgba16f) uniform readonly image2D primeReflectionDenoisedDiffuseSh1;
layout(set = 0, binding = 26, rgba16f) uniform readonly image2D primeReflectionDenoisedSpecularSh1;
layout(set = 0, binding = 27, rgb10_a2) uniform readonly image2D primeReflectionCompositeNormalRoughness;
layout(set = 0, binding = 28, r32f) uniform readonly image2D primeReflectionCompositeViewZ;
layout(set = 0, binding = 29, rgba32f) uniform readonly image2D primeReflectionCompositePosition;
layout(set = 0, binding = 30, rgba32f) uniform readonly image2D primeDisplayPosition;

layout(push_constant) uniform PrimeCompositePushConstants {
    uvec2 outputExtent;
    uint diagnosticMode;
    float sunRadianceMultiplier;
    vec2 currentJitterPixels;
    float displayOverexposure;
} primeCompositePush;

const uint PRIME_DIAGNOSTIC_OFF = 0u;
const uint PRIME_DIAGNOSTIC_NRD_VALIDATION = 1u;
const uint PRIME_DIAGNOSTIC_REPROJECTION_ERROR = 2u;
const uint PRIME_DIAGNOSTIC_MOTION = 3u;
const uint PRIME_DIAGNOSTIC_SPECULAR_INPUT = 4u;
const uint PRIME_DIAGNOSTIC_SPECULAR_OUTPUT = 5u;
const uint PRIME_DIAGNOSTIC_SPECULAR_REMODULATED = 6u;

#ifndef PRIME_ENABLE_FILTERED_SUN_SHADOW
#define PRIME_ENABLE_FILTERED_SUN_SHADOW 1
#endif

ATM_DECLARE_SAMPLE_3D(primeCompositeSampleAerialRadiance, primeCompositeAerialRadiance)
ATM_DECLARE_SAMPLE_3D(primeCompositeSampleAerialTransmittance, primeCompositeAerialTransmittance)

vec3 primeCompositeSurfaceSignal(
        vec4 material,
        vec3 specularAlbedo,
        vec3 diffuseSignal,
        vec3 specularSignal,
        vec3 sunSignal) {
    // A negative primary distance is raygen's immutable miss marker. Sky radiance lives entirely
    // in primeStableAccumulation and must never consume REBLUR output: NRD treats its out-of-range
    // view-Z as invalid and is not required to erase surface history when a pixel becomes sky.
    if (!primeNrdIsFinite(material.a) || material.a < 0.0) {
        return vec3(0.0);
    }
    vec3 diffuseAlbedo = primeNrdSanitizeAlbedo(material.rgb);
    vec3 safeSpecularAlbedo = primeNrdSanitizeAlbedo(specularAlbedo);
    vec3 diffuse = primeNrdSanitizeRadiance(diffuseSignal) * diffuseAlbedo;
    vec3 specular = primeNrdSanitizeRadiance(specularSignal) * safeSpecularAlbedo;
    primeNrdClampRadianceTriple(
            diffuse, specular, sunSignal, PRIME_NRD_FP16_MAX);
    return diffuse + specular + sunSignal;
}

void primeCompositeApplyAerial(uvec2 pixel, float primaryDistance, inout vec3 radiance) {
    if (!primeNrdIsFinite(primaryDistance) || primaryDistance < 0.0) {
        return;
    }
    float distanceKm = primaryDistance * ATM_WORLD_UNIT_SCALE_KM;
    ivec3 dimensions = imageSize(primeCompositeAerialRadiance);
    float firstSliceDepth = 0.5 / float(max(dimensions.z, 1));
    float firstSliceDistanceKm = ATM_AERIAL_MAX_DISTANCE_KM * firstSliceDepth * firstSliceDepth;
    float normalizedDepth = max(firstSliceDepth, sqrt(clamp(
            distanceKm / max(ATM_AERIAL_MAX_DISTANCE_KM, 1.0e-6), 0.0, 1.0)));
    float nearWeight = clamp(distanceKm / max(firstSliceDistanceKm, 1.0e-6), 0.0, 1.0);
    vec2 screenUv = (vec2(pixel) + vec2(0.5)
            + primeCompositePush.currentJitterPixels)
            / vec2(primeCompositePush.outputExtent);
    vec3 uvw = vec3(screenUv, normalizedDepth);
    vec3 inscatter = max(primeCompositeSampleAerialRadiance(uvw).rgb, vec3(0.0));
    vec3 transmittance = clamp(
            primeCompositeSampleAerialTransmittance(uvw).rgb, vec3(0.0), vec3(1.0));
    if (any(isnan(inscatter)) || any(isinf(inscatter))) {
        inscatter = vec3(0.0);
    }
    if (any(isnan(transmittance)) || any(isinf(transmittance))) {
        transmittance = vec3(1.0);
    }
    radiance = radiance * mix(vec3(1.0), transmittance, nearWeight)
            + inscatter * nearWeight * primeCompositePush.sunRadianceMultiplier;
}

ivec2 primeCompositeNeighbor(ivec2 pixel, ivec2 offset) {
    return clamp(
            pixel + offset,
            ivec2(0),
            ivec2(primeCompositePush.outputExtent) - ivec2(1));
}

vec4 primeCompositeLoadNormalRoughness(
        ivec2 pixel, bool reflection) {
    return reflection
            ? imageLoad(
                    primeReflectionCompositeNormalRoughness,
                    pixel)
            : imageLoad(primeCompositeNormalRoughness, pixel);
}

vec3 primeCompositeNormal(ivec2 pixel, bool reflection) {
    vec3 normal;
    float roughness;
    primeNrdUnpackNormalRoughness(
            primeCompositeLoadNormalRoughness(pixel, reflection),
            normal,
            roughness);
    return normal;
}

vec4 primeCompositeLoadDenoisedSh0(
        ivec2 pixel, bool reflection, bool specular) {
    if (reflection) {
        return specular
                ? imageLoad(primeReflectionDenoisedSpecular, pixel)
                : imageLoad(primeReflectionDenoisedDiffuse, pixel);
    }
    return specular
            ? imageLoad(primeDenoisedSpecular, pixel)
            : imageLoad(primeDenoisedDiffuse, pixel);
}

vec3 primeCompositeLoadDenoisedSh1(
        ivec2 pixel, bool reflection, bool specular) {
    if (reflection) {
        return specular
                ? imageLoad(primeReflectionDenoisedSpecularSh1, pixel).xyz
                : imageLoad(primeReflectionDenoisedDiffuseSh1, pixel).xyz;
    }
    return specular
            ? imageLoad(primeDenoisedSpecularSh1, pixel).xyz
            : imageLoad(primeDenoisedDiffuseSh1, pixel).xyz;
}

vec4 primeCompositeLoadMaterial(ivec2 pixel, bool reflection) {
    return reflection
            ? imageLoad(primeReflectionCompositeMaterial, pixel)
            : imageLoad(primeCompositeMaterial, pixel);
}

vec3 primeCompositeLoadSpecularAlbedo(ivec2 pixel, bool reflection) {
    return reflection
            ? imageLoad(primeReflectionCompositeSpecularMaterial, pixel).rgb
            : imageLoad(primeCompositeSpecularMaterial, pixel).rgb;
}

vec3 primeCompositeLoadPosition(ivec2 pixel, bool reflection) {
    return reflection
            ? imageLoad(primeReflectionCompositePosition, pixel).xyz
            : imageLoad(primeCompositePrimaryPosition, pixel).xyz;
}

float primeCompositeLoadViewZ(ivec2 pixel, bool reflection) {
    return reflection
            ? imageLoad(primeReflectionCompositeViewZ, pixel).x
            : imageLoad(primeCompositeViewZ, pixel).x;
}

vec3 primeCompositeSunSignal(ivec2 pixel) {
    vec4 unshadowed = imageLoad(primeUnshadowedSunLighting, pixel);
#if PRIME_ENABLE_FILTERED_SUN_SHADOW
    // The filtered shadow is stored as sqrt(visibility).
    float encodedShadow = imageLoad(primeSigmaSunShadow, pixel).x;
    float visibility = isnan(encodedShadow) || isinf(encodedShadow)
            ? primeNrdSanitizeUnit(unshadowed.a, 0.0)
            : clamp(encodedShadow * encodedShadow, 0.0, 1.0);
#else
    float visibility = primeNrdSanitizeUnit(unshadowed.a, 0.0);
#endif
    return unshadowed.rgb * visibility;
}

struct PrimeCompositeResolveGuide {
    bool valid;
    vec4 material;
    vec3 specularAlbedo;
    vec3 sun;
    uint materialId;
    vec3 normal;
    float roughness;
    vec3 view;
    float viewZ;
    vec4 neighborViewZ;
    vec3 eastNormal;
    vec3 westNormal;
    vec3 northNormal;
    vec3 southNormal;
};

struct PrimeCompositeResolvedBranch {
    vec3 surface;
    vec3 specular;
};

PrimeCompositeResolveGuide primeCompositeLoadResolveGuide(
        ivec2 pixel, bool reflection) {
    // All translated SH taps are evaluated against this one current-frame guide. Hoisting its
    // material and ReJitter neighborhood avoids reloading the same center data four times.
    PrimeCompositeResolveGuide guide;
    guide.material = primeCompositeLoadMaterial(
            pixel, reflection);
    guide.valid = primeNrdIsFinite(guide.material.a)
            && guide.material.a >= 0.0;
    if (!guide.valid) {
        return guide;
    }

    vec4 normalRoughness =
            primeCompositeLoadNormalRoughness(
                    pixel, reflection);
    primeNrdUnpackNormalRoughness(
            normalRoughness, guide.normal, guide.roughness);
    guide.materialId =
            uint(round(normalRoughness.a * 3.0));
    guide.view = primeNrdSafeNormalize(
            -primeCompositeLoadPosition(pixel, reflection),
            guide.normal);
    ivec2 east = primeCompositeNeighbor(
            pixel, ivec2(1, 0));
    ivec2 west = primeCompositeNeighbor(
            pixel, ivec2(-1, 0));
    ivec2 north = primeCompositeNeighbor(
            pixel, ivec2(0, 1));
    ivec2 south = primeCompositeNeighbor(
            pixel, ivec2(0, -1));
    guide.viewZ = primeCompositeLoadViewZ(
            pixel, reflection);
    guide.neighborViewZ = vec4(
            primeCompositeLoadViewZ(east, reflection),
            primeCompositeLoadViewZ(west, reflection),
            primeCompositeLoadViewZ(north, reflection),
            primeCompositeLoadViewZ(south, reflection));
    guide.eastNormal = primeCompositeNormal(
            east, reflection);
    guide.westNormal = primeCompositeNormal(
            west, reflection);
    guide.northNormal = primeCompositeNormal(
            north, reflection);
    guide.southNormal = primeCompositeNormal(
            south, reflection);
    guide.specularAlbedo =
            primeCompositeLoadSpecularAlbedo(
                    pixel, reflection);
    guide.sun = reflection
            ? vec3(0.0)
            : primeCompositeSunSignal(pixel);
    return guide;
}

PrimeNrdResolvedSg primeCompositeResolveSh(
        ivec2 signalPixel,
        bool reflection,
        PrimeCompositeResolveGuide guide) {
    PrimeNrdSg diffuseSg = primeNrdUnpackSg(
            primeCompositeLoadDenoisedSh0(
                    signalPixel, reflection, false),
            primeCompositeLoadDenoisedSh1(
                    signalPixel, reflection, false));
    PrimeNrdSg specularSg = primeNrdUnpackSg(
            primeCompositeLoadDenoisedSh0(
                    signalPixel, reflection, true),
            primeCompositeLoadDenoisedSh1(
                    signalPixel, reflection, true));
    return primeNrdResolveFilteredSg(
            diffuseSg,
            specularSg,
            guide.view,
            guide.roughness,
            guide.viewZ,
            guide.neighborViewZ,
            guide.normal,
            guide.eastNormal,
            guide.westNormal,
            guide.northNormal,
            guide.southNormal);
}

PrimeCompositeResolvedBranch primeCompositeResolveBranch(
        ivec2 signalPixel,
        bool reflection,
        PrimeCompositeResolveGuide guide) {
    PrimeCompositeResolvedBranch branch;
    branch.surface = vec3(0.0);
    branch.specular = vec3(0.0);
    if (!guide.valid) {
        return branch;
    }

    PrimeNrdResolvedSg resolved = primeCompositeResolveSh(
            signalPixel, reflection, guide);
    branch.surface = primeCompositeSurfaceSignal(
            guide.material,
            guide.specularAlbedo,
            resolved.diffuse,
            resolved.specular,
            guide.sun);
    branch.specular = primeNrdClampRadiance(
            primeNrdSanitizeRadiance(resolved.specular)
                    * primeNrdSanitizeAlbedo(
                            guide.specularAlbedo),
            PRIME_NRD_FP16_MAX);
    return branch;
}

PrimeCompositeResolvedBranch primeCompositeResolveBranchAt(
        ivec2 pixel, bool reflection) {
    PrimeCompositeResolveGuide guide =
            primeCompositeLoadResolveGuide(
                    pixel, reflection);
    return primeCompositeResolveBranch(
            pixel, reflection, guide);
}

float primeCompositeGuideCompatibility(
        ivec2 samplePixel,
        bool reflection,
        uint guideMaterialId,
        float guideViewZ) {
    vec4 sampleMaterial = primeCompositeLoadMaterial(
            samplePixel, reflection);
    if (!primeNrdIsFinite(sampleMaterial.a)
            || sampleMaterial.a < 0.0) {
        return 0.0;
    }

    vec4 sampleNormalRoughness =
            primeCompositeLoadNormalRoughness(
                    samplePixel, reflection);
    uint sampleMaterialId =
            uint(round(sampleNormalRoughness.a * 3.0));
    if (sampleMaterialId != guideMaterialId) {
        return 0.0;
    }

    float sampleViewZ =
            primeCompositeLoadViewZ(samplePixel, reflection);
    float threshold = PRIME_NRD_REJITTER_VIEW_Z_THRESHOLD
            * max(abs(sampleViewZ), abs(guideViewZ))
            + 1.0e-4;
    return primeNrdIsFinite(sampleViewZ)
                    && primeNrdIsFinite(guideViewZ)
                    && abs(sampleViewZ - guideViewZ) <= threshold
            ? 1.0
            : 0.0;
}

mat3 primeCompositeCompatibilityGrid(
        ivec2 guidePixel,
        bool reflection,
        PrimeCompositeResolveGuide guide) {
    // Four inverse-jittered 2x2 footprints overlap in this 3x3 tile. Evaluate each categorical
    // surface sample once instead of issuing sixteen repeated compatibility probes.
    mat3 compatibility = mat3(0.0);
    for (int y = -1; y <= 1; y++) {
        for (int x = -1; x <= 1; x++) {
            float value = x == 0 && y == 0
                    ? (primeNrdIsFinite(guide.viewZ)
                            ? 1.0 : 0.0)
                    : primeCompositeGuideCompatibility(
                            primeCompositeNeighbor(
                                    guidePixel, ivec2(x, y)),
                            reflection,
                            guide.materialId,
                            guide.viewZ);
            compatibility[x + 1][y + 1] = value;
        }
    }
    return compatibility;
}

float primeCompositeSignalCoverage(
        ivec2 signalPixel,
        ivec2 guidePixel,
        mat3 compatibility) {
    // Current guide samples already live at pixel + jitter. Sampling them at signal - jitter
    // reconstructs the categorical surface coverage aligned with NRD's stabilized signal grid.
    vec2 guidePosition = vec2(signalPixel)
            - primeCompositePush.currentJitterPixels;
    ivec2 base = ivec2(floor(guidePosition));
    vec2 weight = fract(guidePosition);
    ivec2 p00 = primeCompositeNeighbor(base, ivec2(0, 0));
    ivec2 p10 = primeCompositeNeighbor(base, ivec2(1, 0));
    ivec2 p01 = primeCompositeNeighbor(base, ivec2(0, 1));
    ivec2 p11 = primeCompositeNeighbor(base, ivec2(1, 1));
    ivec2 i00 = clamp(
            p00 - guidePixel + ivec2(1), ivec2(0), ivec2(2));
    ivec2 i10 = clamp(
            p10 - guidePixel + ivec2(1), ivec2(0), ivec2(2));
    ivec2 i01 = clamp(
            p01 - guidePixel + ivec2(1), ivec2(0), ivec2(2));
    ivec2 i11 = clamp(
            p11 - guidePixel + ivec2(1), ivec2(0), ivec2(2));
    vec4 values = vec4(
            compatibility[i00.x][i00.y],
            compatibility[i10.x][i10.y],
            compatibility[i01.x][i01.y],
            compatibility[i11.x][i11.y]);
    vec4 coverageWeight = vec4(
            (1.0 - weight.x) * (1.0 - weight.y),
            weight.x * (1.0 - weight.y),
            (1.0 - weight.x) * weight.y,
            weight.x * weight.y);
    return dot(values, coverageWeight);
}

PrimeCompositeResolvedBranch primeCompositeSampleResolvedBranch(
        ivec2 pixel, bool reflection) {
    PrimeCompositeResolveGuide guide =
            primeCompositeLoadResolveGuide(
                    pixel, reflection);
    if (!guide.valid) {
        return primeCompositeResolveBranch(
                pixel, reflection, guide);
    }
    vec2 jitter = primeCompositePush.currentJitterPixels;
    ivec2 base = pixel + ivec2(floor(jitter));
    vec2 weight = fract(jitter);
    ivec2 signal00 = primeCompositeNeighbor(
            base, ivec2(0, 0));
    ivec2 signal10 = primeCompositeNeighbor(
            base, ivec2(1, 0));
    ivec2 signal01 = primeCompositeNeighbor(
            base, ivec2(0, 1));
    ivec2 signal11 = primeCompositeNeighbor(
            base, ivec2(1, 1));
    vec4 tapWeight = vec4(
            (1.0 - weight.x) * (1.0 - weight.y),
            weight.x * (1.0 - weight.y),
            (1.0 - weight.x) * weight.y,
            weight.x * weight.y);
    mat3 compatibility = primeCompositeCompatibilityGrid(
            pixel, reflection, guide);
    tapWeight *= vec4(
            primeCompositeSignalCoverage(
                    signal00, pixel, compatibility),
            primeCompositeSignalCoverage(
                    signal10, pixel, compatibility),
            primeCompositeSignalCoverage(
                    signal01, pixel, compatibility),
            primeCompositeSignalCoverage(
                    signal11, pixel, compatibility));
    float weightSum = dot(tapWeight, vec4(1.0));
    if (!(weightSum > 1.0e-6)) {
        return primeCompositeResolveBranch(
                pixel, reflection, guide);
    }
    tapWeight /= weightSum;
    PrimeCompositeResolvedBranch p00 =
            primeCompositeResolveBranch(
                    signal00, reflection, guide);
    PrimeCompositeResolvedBranch p10 =
            primeCompositeResolveBranch(
                    signal10, reflection, guide);
    PrimeCompositeResolvedBranch p01 =
            primeCompositeResolveBranch(
                    signal01, reflection, guide);
    PrimeCompositeResolvedBranch p11 =
            primeCompositeResolveBranch(
                    signal11, reflection, guide);
    PrimeCompositeResolvedBranch branch;
    // The current guide and material already contain the FSR camera jitter. Only NRD's stabilized
    // SH signal needs translation; moving both produced the measured 1.6x-2x interior phase.
    // Resolve every translated signal tap independently against the one current guide. The
    // inverse-jittered coverage reconstruction preserves NRD's exact material classes and 1%
    // surface-depth boundary without switching whole taps as the jitter phase changes.
    branch.surface = p00.surface * tapWeight.x
            + p10.surface * tapWeight.y
            + p01.surface * tapWeight.z
            + p11.surface * tapWeight.w;
    branch.specular = p00.specular * tapWeight.x
            + p10.specular * tapWeight.y
            + p01.specular * tapWeight.z
            + p11.specular * tapWeight.w;
    return branch;
}

vec3 primeCompositeRadiance(
        uvec2 pixel,
        vec4 material,
        vec3 displayPosition) {
    if (!primeNrdIsFinite(material.a) || material.a < 0.0) {
        // Raygen's sky contract also guarantees a zero display position and no reflection guide,
        // so the old path resolved to this same stable signal without aerial sampling.
        return primeNrdClampRadiance(
                imageLoad(primeStableAccumulation, ivec2(pixel)).rgb,
                PRIME_NRD_FP16_MAX);
    }
    uint visibleMaterialFlags = floatBitsToUint(
            imageLoad(primeDisplayPosition, ivec2(pixel)).w);
    bool restoreTransparentPhase =
            primeMaterialIsTransmissive(visibleMaterialFlags);
    PrimeCompositeResolvedBranch primaryBranch =
            restoreTransparentPhase
                    ? primeCompositeSampleResolvedBranch(
                            ivec2(pixel), false)
                    : primeCompositeResolveBranchAt(
                            ivec2(pixel), false);
    PrimeCompositeResolvedBranch reflectionBranch =
            restoreTransparentPhase
                    ? primeCompositeSampleResolvedBranch(
                            ivec2(pixel), true)
                    : primeCompositeResolveBranchAt(
                            ivec2(pixel), true);
    vec3 stable = primeNrdClampRadiance(
            imageLoad(primeStableAccumulation, ivec2(pixel)).rgb,
            PRIME_NRD_FP16_MAX);
    vec3 radiance =
            primaryBranch.surface + reflectionBranch.surface + stable;
    float displayDistance = all(equal(displayPosition, vec3(0.0)))
            ? -1.0
            : length(displayPosition);
    primeCompositeApplyAerial(pixel, displayDistance, radiance);
    return primeNrdClampRadiance(radiance, PRIME_NRD_FP16_MAX);
}

vec3 primeCompositeSh0Color(vec4 sh0) {
    return primeNrdSgExtractColor(primeNrdUnpackSg(sh0, vec3(0.0)));
}

vec3 primeCompositeRemodulatedSpecular(uvec2 pixel) {
    uint visibleMaterialFlags = floatBitsToUint(
            imageLoad(primeDisplayPosition, ivec2(pixel)).w);
    PrimeCompositeResolvedBranch branch =
            primeMaterialIsTransmissive(visibleMaterialFlags)
                    ? primeCompositeSampleResolvedBranch(
                            ivec2(pixel), false)
                    : primeCompositeResolveBranchAt(
                            ivec2(pixel), false);
    return branch.specular;
}

vec3 primeCompositeDisplayDiagnostic(vec3 radiance) {
    radiance = primeNrdIsFinite(radiance) ? max(radiance, vec3(0.0)) : vec3(0.0);
    return primeDisplayTransformToSrgb(
            radiance, primeCompositePush.displayOverexposure);
}

bool primeCompositeIsValidationSceneTile(uvec2 pixel) {
    // Match NRD's 4x4 viewport selection at pixel centers. REBLUR deliberately leaves the middle
    // six tiles untouched for the application-provided beauty image.
    uvec2 viewport = min(
            (pixel * 4u + 2u) / primeCompositePush.outputExtent,
            uvec2(3u));
    return (viewport.x == 1u || viewport.x == 2u) && viewport.y >= 1u;
}

void main() {
    uvec2 pixel = gl_GlobalInvocationID.xy;
    if (any(greaterThanEqual(pixel, primeCompositePush.outputExtent))) {
        return;
    }
    vec4 displayPosition = imageLoad(primeDisplayPosition, ivec2(pixel));
    uint visibleMaterialFlags = floatBitsToUint(displayPosition.w);
    PrimeFsrMasks fsrMasks = primeFsrMasks(visibleMaterialFlags);
    imageStore(
            primeFsrReactiveMask,
            ivec2(pixel),
            vec4(primeFsrSanitizeMask(fsrMasks.reactive)));
    imageStore(
            primeFsrTransparencyCompositionMask,
            ivec2(pixel),
            vec4(primeFsrSanitizeMask(
                    fsrMasks.transparencyAndComposition)));
    if (primeCompositePush.diagnosticMode == PRIME_DIAGNOSTIC_SPECULAR_INPUT) {
        imageStore(
                primeCompositeOutput,
                ivec2(pixel),
                vec4(primeCompositeDisplayDiagnostic(primeCompositeSh0Color(
                        imageLoad(primeNoisySpecular, ivec2(pixel)))), 1.0));
        return;
    }
    if (primeCompositePush.diagnosticMode == PRIME_DIAGNOSTIC_SPECULAR_OUTPUT) {
        imageStore(
                primeCompositeOutput,
                ivec2(pixel),
                vec4(primeCompositeDisplayDiagnostic(primeCompositeSh0Color(
                        imageLoad(primeDenoisedSpecular, ivec2(pixel)))), 1.0));
        return;
    }
    if (primeCompositePush.diagnosticMode == PRIME_DIAGNOSTIC_SPECULAR_REMODULATED) {
        imageStore(
                primeCompositeOutput,
                ivec2(pixel),
                vec4(primeCompositeDisplayDiagnostic(
                        primeCompositeRemodulatedSpecular(pixel)), 1.0));
        return;
    }
    if (primeCompositePush.diagnosticMode == PRIME_DIAGNOSTIC_REPROJECTION_ERROR) {
        imageStore(
                primeCompositeOutput,
                ivec2(pixel),
                vec4(imageLoad(primeReprojectionError, ivec2(pixel)).rgb, 1.0));
        return;
    }
    if (primeCompositePush.diagnosticMode == PRIME_DIAGNOSTIC_MOTION) {
        vec3 motion = imageLoad(primeMotionDiagnostic, ivec2(pixel)).xyz;
        vec2 motionPixels = motion.xy;
        vec3 positiveColor = max(motionPixels.x, 0.0) * vec3(1.0, 0.0, 0.0)
                + max(motionPixels.y, 0.0) * vec3(0.0, 1.0, 0.0);
        vec3 negativeColor = max(-motionPixels.x, 0.0) * vec3(0.0, 1.0, 1.0)
                + max(-motionPixels.y, 0.0) * vec3(1.0, 0.0, 1.0);
        vec3 motionColor = (positiveColor + negativeColor + abs(motion.z)) * 0.25;
        imageStore(
                primeCompositeOutput,
                ivec2(pixel),
                vec4(clamp(motionColor, vec3(0.0), vec3(1.0)), 1.0));
        return;
    }
    vec4 material = imageLoad(primeCompositeMaterial, ivec2(pixel));
    vec3 radiance = primeCompositeRadiance(
            pixel, material, displayPosition.xyz);
    if (primeCompositePush.diagnosticMode == PRIME_DIAGNOSTIC_NRD_VALIDATION) {
        vec3 validationColor;
        if (primeCompositeIsValidationSceneTile(pixel)) {
            validationColor = primeCompositeDisplayDiagnostic(radiance);
            imageStore(
                    primeNrdValidation,
                    ivec2(pixel),
                    vec4(validationColor, 1.0));
        } else {
            validationColor = imageLoad(primeNrdValidation, ivec2(pixel)).rgb;
        }
        imageStore(
                primeCompositeOutput,
                ivec2(pixel),
                vec4(validationColor, 1.0));
        return;
    }
    imageStore(
            primeCompositeOutput,
            ivec2(pixel),
            vec4(radiance, 1.0));
}
