#version 460
#extension GL_GOOGLE_include_directive : require

#include "default_material.glsl"
#include "nrd_common.glsl"

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 0, binding = 0, rgba16f) uniform writeonly image2D primeMotion;
layout(set = 0, binding = 1, r32f) uniform image2D primeViewZ;
layout(set = 0, binding = 2, rgba32f) uniform readonly image2D primePrimaryPosition;
layout(set = 0, binding = 3, rgba16f) uniform writeonly image2D primeReprojectionError;
layout(set = 0, binding = 4, r32f) uniform writeonly image2D primeFsrDepth;
layout(set = 0, binding = 5, rgba16f) uniform image2D primeNoisyDiffuse;
layout(set = 0, binding = 6, rgba16f) uniform image2D primeNoisySpecular;
layout(set = 0, binding = 7, rgb10_a2) uniform image2D primeNormalRoughness;
layout(set = 0, binding = 8, rgba16f) uniform image2D primeMaterial;
layout(set = 0, binding = 9, rgba16f) uniform image2D primeSpecularMaterial;

layout(push_constant) uniform PrimeMotionPushConstants {
    mat4 currentClipToWorld;
    mat4 previousWorldToClip;
    mat4 previousRenderedWorldToClip;
    uint diagnosticMode;
} primeMotionPush;

const float PRIME_MOTION_SKY_VIEW_Z = 65504.0;
const float PRIME_FSR_NEAR_PLANE = 0.05;
const uint PRIME_DIAGNOSTIC_REPROJECTION_ERROR = 2u;

vec3 primeMotionRayDirection(vec2 screenUv) {
    // NRD uses D3D screen UVs: y=0 is clip y=+1. The Java boundary has already reflected
    // Minecraft's projection Y, so this names the same image row that world.rgen traced.
    vec2 clipXY = screenUv * vec2(2.0, -2.0) + vec2(-1.0, 1.0);
    vec4 nearPoint = primeMotionPush.currentClipToWorld * vec4(clipXY, 1.0, 1.0);
    vec4 farPoint = primeMotionPush.currentClipToWorld * vec4(clipXY, 0.0, 1.0);
    return normalize(farPoint.xyz / farPoint.w - nearPoint.xyz / nearPoint.w);
}

void primeStoreSkyMotion(ivec2 pixel, ivec2 extent) {
    // NRD masks sky from its surface denoiser, but FSR consumes this same XY motion texture.
    // A direction projected with w=0 ignores camera translation and preserves rotation, so
    // the infinite sky follows camera orientation without acquiring false parallax.
    vec2 currentUv = (vec2(pixel) + vec2(0.5)) / vec2(extent);
    vec3 rayDirection = primeMotionRayDirection(currentUv);
    vec4 previousClip = primeMotionPush.previousWorldToClip
            * vec4(rayDirection, 0.0);
    vec2 skyMotion = vec2(0.0);
    if (abs(previousClip.w) > 1.0e-6
            && !any(isnan(previousClip))
            && !any(isinf(previousClip))) {
        vec2 previousNdc = previousClip.xy / previousClip.w;
        vec2 previousUv = previousNdc * vec2(0.5, -0.5) + vec2(0.5);
        skyMotion = previousUv - currentUv;
    }
    imageStore(
            primeMotion,
            pixel,
            vec4(primeNrdSanitizeMotion(vec3(skyMotion, 0.0)), 0.0));
    imageStore(primeFsrDepth, pixel, vec4(0.0));
    if (primeMotionPush.diagnosticMode == PRIME_DIAGNOSTIC_REPROJECTION_ERROR) {
        imageStore(primeReprojectionError, pixel, vec4(0.0, 0.0, 0.0, 1.0));
    }
}

void main() {
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    ivec2 extent = imageSize(primeViewZ);
    if (any(greaterThanEqual(pixel, extent))) {
        return;
    }

    // Raygen leaves raw signals in the eventual NRD images. Resolve the primary guide and convert
    // them in place before motion generation. This pass is separated from raygen specifically to
    // shorten the maximum live range in the mega-kernel; its output encoding remains the exact
    // immutable NRD contract consumed by all following dispatches.
    vec4 rawMaterial = imageLoad(primeMaterial, pixel);
    float primaryDistance = rawMaterial.a;
    if (!primeNrdIsFinite(primaryDistance) || primaryDistance < 0.0) {
        imageStore(primeNoisyDiffuse, pixel, primeNrdPackRadianceAndHitDistance(vec3(0.0), 0.0));
        imageStore(primeNoisySpecular, pixel, primeNrdPackRadianceAndHitDistance(vec3(0.0), 0.0));
        imageStore(
                primeNormalRoughness,
                pixel,
                primeNrdPackNormalRoughness(
                        vec3(0.0, 0.0, 1.0),
                        PRIME_DEFAULT_REFERENCE_LINEAR_ROUGHNESS,
                        0.0));
        imageStore(primeViewZ, pixel, vec4(PRIME_MOTION_SKY_VIEW_Z, 0.0, 0.0, 0.0));
        imageStore(primeMaterial, pixel, vec4(1.0, 1.0, 1.0, -1.0));
        imageStore(
                primeSpecularMaterial,
                pixel,
                vec4(
                        1.0,
                        1.0,
                        1.0,
                        primeFsrTransparencyAndCompositionMask(0u)));
        primeStoreSkyMotion(pixel, extent);
        return;
    }

    vec4 primary = imageLoad(primePrimaryPosition, pixel);
    vec4 rawSpecularMaterial = imageLoad(primeSpecularMaterial, pixel);
    uint primaryMaterialFlags = primeNrdIsFinite(rawSpecularMaterial.a)
            ? uint(clamp(round(rawSpecularMaterial.a), 0.0, PRIME_NRD_FP16_MAX))
            : 0u;
    vec3 primaryNormal;
    float primaryLinearRoughness;
    primeNrdUnpackNormalRoughness(
            imageLoad(primeNormalRoughness, pixel),
            primaryNormal,
            primaryLinearRoughness);
    // Raygen supplies directional BSDF energy for each lobe. Zero-energy channels stay zero;
    // guarded division avoids manufacturing a material floor that would later change remodulation.
    vec3 diffuseAlbedo = primeNrdSanitizeAlbedo(rawMaterial.rgb);
    vec3 specularAlbedo = primeNrdSanitizeAlbedo(rawSpecularMaterial.rgb);
    vec3 primaryVector = primeNrdIsFinite(primary.xyz) ? primary.xyz : vec3(0.0);
    vec3 tracedRayDirection = dot(primaryVector, primaryVector) > 1.0e-12
            ? primeNrdSafeNormalize(primaryVector, vec3(0.0, 0.0, -1.0))
            : primeMotionRayDirection(
                    (vec2(pixel) + vec2(0.5)) / vec2(extent));
    vec3 cameraForward = primeMotionRayDirection(vec2(0.5));
    float currentViewZ = primaryDistance * dot(tracedRayDirection, cameraForward);
    currentViewZ = primeNrdIsFinite(currentViewZ) && currentViewZ > 0.0
            ? min(currentViewZ, PRIME_MOTION_SKY_VIEW_Z)
            : PRIME_MOTION_SKY_VIEW_Z;
    vec4 rawDiffuse = imageLoad(primeNoisyDiffuse, pixel);
    vec4 rawSpecular = imageLoad(primeNoisySpecular, pixel);
    float diffuseHitDistance = primeNrdSanitizeHitDistance(rawDiffuse.a);
    float specularHitDistance = primeNrdSanitizeHitDistance(rawSpecular.a);
    float normalizedDiffuseHitDistance = diffuseHitDistance <= 0.0
            ? 0.0
            : primeNrdNormalizedHitDistance(diffuseHitDistance, currentViewZ, 1.0);
    float normalizedSpecularHitDistance = specularHitDistance <= 0.0
            ? 0.0
            : primeNrdNormalizedHitDistance(
                    specularHitDistance, currentViewZ, primaryLinearRoughness);
    vec3 demodulatedDiffuse = primeNrdDemodulate(rawDiffuse.rgb, diffuseAlbedo);
    vec3 demodulatedSpecular = primeNrdDemodulate(rawSpecular.rgb, specularAlbedo);
    primeNrdClampRadiancePair(
            demodulatedDiffuse, demodulatedSpecular, PRIME_NRD_RADIANCE_LIMIT);
    imageStore(
            primeNoisyDiffuse,
            pixel,
            primeNrdPackRadianceAndHitDistance(
                    demodulatedDiffuse,
                    normalizedDiffuseHitDistance));
    imageStore(
            primeNoisySpecular,
            pixel,
            primeNrdPackRadianceAndHitDistance(
                    demodulatedSpecular,
                    normalizedSpecularHitDistance));
    imageStore(
            primeNormalRoughness,
            pixel,
            primeNrdPackNormalRoughness(
                    primaryNormal,
                    primaryLinearRoughness,
                    primeNrdMaterialId(primaryMaterialFlags)));
    imageStore(primeViewZ, pixel, vec4(currentViewZ, 0.0, 0.0, 0.0));
    imageStore(
            primeMaterial,
            pixel,
            vec4(diffuseAlbedo, primaryDistance));
    imageStore(
            primeSpecularMaterial,
            pixel,
            vec4(
                    specularAlbedo,
                    primeFsrTransparencyAndCompositionMask(primaryMaterialFlags)));

    if (!(currentViewZ > 0.0) || currentViewZ >= PRIME_MOTION_SKY_VIEW_Z) {
        primeStoreSkyMotion(pixel, extent);
        return;
    }

    // Minecraft/Prime use a reversed infinite depth convention. FSR reconstructs view-Z as
    // near/depth using the matching deviceToViewDepth constants; this is an API boundary and must
    // remain synchronized with Fsr3Upscaler rather than being inferred from Mojang's depth image.
    imageStore(primeFsrDepth, pixel, vec4(PRIME_FSR_NEAR_PLANE / currentViewZ));

    // NRD requires non-jittered motion even though the noisy primary sample is jittered.
    vec2 currentUv = (vec2(pixel) + vec2(0.5)) / vec2(extent);
    vec3 rayDirection = primeMotionRayDirection(currentUv);
    float forwardProjection = dot(rayDirection, cameraForward);
    if (!(forwardProjection > 1.0e-6)) {
        imageStore(primeMotion, pixel, vec4(0.0));
        imageStore(primeFsrDepth, pixel, vec4(0.0));
        if (primeMotionPush.diagnosticMode == PRIME_DIAGNOSTIC_REPROJECTION_ERROR) {
            imageStore(primeReprojectionError, pixel, vec4(1.0, 1.0, 1.0, 1.0));
        }
        return;
    }

    vec3 currentWorldPosition = rayDirection * (currentViewZ / forwardProjection);
    vec4 previousClip = primeMotionPush.previousWorldToClip
            * vec4(currentWorldPosition, 1.0);
    if (!(abs(previousClip.w) > 1.0e-6)
            || any(isnan(previousClip))
            || any(isinf(previousClip))) {
        imageStore(primeMotion, pixel, vec4(0.0));
        if (primeMotionPush.diagnosticMode == PRIME_DIAGNOSTIC_REPROJECTION_ERROR) {
            imageStore(primeReprojectionError, pixel, vec4(1.0, 1.0, 1.0, 1.0));
        }
        return;
    }

    vec2 previousNdc = previousClip.xy / previousClip.w;
    vec2 previousUv = previousNdc * vec2(0.5, -0.5) + vec2(0.5);
    // NRD's immutable contract is old = new + MV. Minecraft terrain is static, so camera
    // translation and rotation are both fully represented by this previous-current difference.
    vec2 screenMotion = previousUv - currentUv;
    float previousViewZ = abs(previousClip.w);
    imageStore(
            primeMotion,
            pixel,
            vec4(primeNrdSanitizeMotion(
                    vec3(screenMotion, previousViewZ - currentViewZ)), 0.0));

    if (primeMotionPush.diagnosticMode != PRIME_DIAGNOSTIC_REPROJECTION_ERROR) {
        return;
    }

    // This probe deliberately does not reconstruct the primary point from view-Z. Raygen records
    // the actual stochastic primary hit, and its sub-pixel sample is packed into W. Comparing that
    // independent point with the guide-derived motion exposes errors hidden by self-consistent
    // camera matrices and view-Z reconstruction.
    vec2 primarySample = unpackHalf2x16(floatBitsToUint(primary.w));
    vec2 primaryUv = (vec2(pixel) + primarySample) / vec2(extent);
    // This matrix is the inverse of the exact inverse-view-projection consumed by raygen, not the
    // canonical matrix used above to generate NRD motion. Its image Y therefore follows Prime's
    // native convention and intentionally supplies an independent reference.
    vec4 exactPreviousClip = primeMotionPush.previousRenderedWorldToClip
            * vec4(primary.xyz, 1.0);
    if (!(abs(exactPreviousClip.w) > 1.0e-6)
            || any(isnan(exactPreviousClip))
            || any(isinf(exactPreviousClip))) {
        imageStore(primeReprojectionError, pixel, vec4(1.0));
        return;
    }
    vec2 exactPreviousUv = exactPreviousClip.xy / exactPreviousClip.w
            * vec2(0.5) + vec2(0.5);
    vec2 reprojectionErrorPixels = (primaryUv + screenMotion - exactPreviousUv)
            * vec2(extent);
    float expectedPreviousViewZ = abs(exactPreviousClip.w);
    float depthError = currentViewZ + (previousViewZ - currentViewZ)
            - expectedPreviousViewZ;

    // Black is exact. Positive X/Y errors are red/green, negative X/Y are cyan/magenta, and
    // absolute depth disagreement is white. One full color unit represents four pixels or blocks.
    vec3 positiveColor = max(reprojectionErrorPixels.x, 0.0) * vec3(1.0, 0.0, 0.0)
            + max(reprojectionErrorPixels.y, 0.0) * vec3(0.0, 1.0, 0.0);
    vec3 negativeColor = max(-reprojectionErrorPixels.x, 0.0) * vec3(0.0, 1.0, 1.0)
            + max(-reprojectionErrorPixels.y, 0.0) * vec3(1.0, 0.0, 1.0);
    vec3 diagnosticColor = (positiveColor + negativeColor + abs(depthError)) * 0.25;
    imageStore(
            primeReprojectionError,
            pixel,
            vec4(clamp(diagnosticColor, vec3(0.0), vec3(1.0)), 1.0));
}
