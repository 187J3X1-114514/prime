#version 460
#extension GL_GOOGLE_include_directive : require

#include "auto_exposure.glsl"

layout(local_size_x = 1, local_size_y = 1, local_size_z = 1) in;

layout(std430, set = 0, binding = 3) readonly buffer PrimeAutoExposureHistogram {
    uint bins[256];
    uint validCount;
} primeAutoExposureHistogram;

layout(std430, set = 0, binding = 4) buffer PrimeAutoExposureState {
    float exposureEv;
    uint initialized;
    float targetEv;
    float measuredLogBrightness;
} primeAutoExposureState;

layout(push_constant) uniform PrimeAutoExposureUpdatePushConstants {
    float deltaSeconds;
    uint reset;
    uint instant;
    float compensation;
} primeAutoExposureUpdatePush;

void main() {
    uint validCount = primeAutoExposureHistogram.validCount;
    if (validCount == 0u) {
        if (primeAutoExposureUpdatePush.reset != 0u
                || primeAutoExposureUpdatePush.instant != 0u
                || primeAutoExposureState.initialized == 0u) {
            primeAutoExposureState.exposureEv = 0.0;
            primeAutoExposureState.initialized = 1u;
            primeAutoExposureState.targetEv = 0.0;
            primeAutoExposureState.measuredLogBrightness = 0.0;
        }
        return;
    }

    uint tailCount =
            validCount / PRIME_AUTO_EXPOSURE_TAIL_DENOMINATOR;
    uint keepBegin = tailCount;
    uint keepEnd = validCount - tailCount;
    uint cursor = 0u;
    uint retainedCount = 0u;
    float weightedLogBrightness = 0.0;
    float minimumLogBrightness = 0.0;
    float maximumLogBrightness = 0.0;
    for (uint bin = 0u; bin < 256u; ++bin) {
        uint binCount = primeAutoExposureHistogram.bins[bin];
        uint binBegin = cursor;
        uint binEnd = cursor + binCount;
        uint retainedBegin = max(binBegin, keepBegin);
        uint retainedEnd = min(binEnd, keepEnd);
        if (retainedEnd > retainedBegin) {
            uint retained = retainedEnd - retainedBegin;
            float binLogBrightness =
                    primeAutoExposureBinLogBrightness(bin);
            if (retainedCount == 0u) {
                minimumLogBrightness = binLogBrightness;
            }
            maximumLogBrightness = binLogBrightness;
            weightedLogBrightness += binLogBrightness * float(retained);
            retainedCount += retained;
        }
        cursor = binEnd;
    }
    if (retainedCount == 0u) {
        return;
    }
    float measuredLogBrightness =
            weightedLogBrightness / float(retainedCount);
    float targetEv =
            primeAutoExposureTargetEv(
                    measuredLogBrightness,
                    minimumLogBrightness,
                    maximumLogBrightness,
                    primeAutoExposureUpdatePush.compensation);
    float exposureEv = targetEv;
    if (primeAutoExposureUpdatePush.reset == 0u
            && primeAutoExposureUpdatePush.instant == 0u
            && primeAutoExposureState.initialized != 0u) {
        exposureEv = primeAutoExposureAdapt(
                primeAutoExposureState.exposureEv,
                targetEv,
                primeAutoExposureUpdatePush.deltaSeconds);
    }

    primeAutoExposureState.exposureEv = exposureEv;
    primeAutoExposureState.initialized = 1u;
    primeAutoExposureState.targetEv = targetEv;
    primeAutoExposureState.measuredLogBrightness = measuredLogBrightness;
}
