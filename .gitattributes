#
# https://help.github.com/articles/dealing-with-line-endings/
#
# Linux start script should use lf
/gradlew        text eol=lf

# These are Windows script files and should use crlf
*.bat           text eol=crlf

# Preserve the RoboCute author's temporary reference overlay byte-for-byte.
/third_party/robocute/author-bsdf-hotfix-2026-07-24/*.hpp -text whitespace=cr-at-eol
/third_party/robocute/author-bsdf-hotfix-2026-07-24/README.md text eol=lf
/third_party/robocute/author-bsdf-hotfix-2026-07-24/trans_ggx.bytes binary

# Immutable integer sampling tables must never undergo text conversion.
*.rg16ui binary

