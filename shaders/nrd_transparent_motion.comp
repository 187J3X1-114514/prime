#version 460
#extension GL_GOOGLE_include_directive : require

#include "nrd_common.glsl"

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 0, binding = 0, rgba16f) uniform writeonly image2D primeMotion;
layout(set = 0, binding = 1, r32f) uniform writeonly image2D primeViewZ;
layout(set = 0, binding = 2, rgba32f) uniform readonly image2D primeGuidePosition;
layout(set = 0, binding = 5, rgba16f) uniform image2D primeNoisyDiffuse;
// Diffuse-only NRD does not consume binding 6. Prime uses that otherwise idle image to preserve
// the first-interface-to-hit segment and eta without growing the motion descriptor ABI.
layout(set = 0, binding = 6, rgba16f) uniform readonly image2D primeInterface;
layout(set = 0, binding = 7, rgb10_a2) uniform writeonly image2D primeNormalRoughness;
layout(set = 0, binding = 8, rgba16f) uniform image2D primeMetadata;
layout(set = 0, binding = 9, rgba16f) uniform readonly image2D primeGuideMaterial;

layout(push_constant) uniform PrimeTransparentMotionPushConstants {
    mat4 currentClipToWorld;
    mat4 previousWorldToClip;
    // Opaque preparation uses this slot for its independent reprojection diagnostic matrix.
    // Transparent preparation reuses column zero: xyz is the previous effective pinhole in
    // current-camera-relative coordinates, and w is 1 for reflection or 2 for transmission.
    // Keeping the shared 192-byte ABI avoids raising Prime's Vulkan push-constant requirement.
    mat4 previousRenderedWorldToClipOrTransparentState;
} primeMotionPush;

const float PRIME_TRANSPARENT_SKY_VIEW_Z = 65504.0;
const float PRIME_REFLECTION_BRANCH = 1.0;

vec2 primeTransparentSignNotZero(vec2 value) {
    return vec2(value.x >= 0.0 ? 1.0 : -1.0, value.y >= 0.0 ? 1.0 : -1.0);
}

vec3 primeUnpackTransparentNormal(float packedValue) {
    vec2 encoded = unpackSnorm2x16(floatBitsToUint(packedValue));
    vec3 normal = vec3(encoded, 1.0 - abs(encoded.x) - abs(encoded.y));
    if (normal.z < 0.0) {
        normal.xy = (1.0 - abs(normal.yx))
                * primeTransparentSignNotZero(normal.xy);
    }
    return normalize(normal);
}

vec3 primeTransparentMotionRayDirection(vec2 screenUv) {
    vec2 clipXY = screenUv * vec2(2.0, -2.0) + vec2(-1.0, 1.0);
    vec4 nearPoint = primeMotionPush.currentClipToWorld * vec4(clipXY, 1.0, 1.0);
    vec4 farPoint = primeMotionPush.currentClipToWorld * vec4(clipXY, 0.0, 1.0);
    return normalize(farPoint.xyz / farPoint.w - nearPoint.xyz / nearPoint.w);
}

vec3 primeMirrorPointAcrossPlane(vec3 point, vec3 planePoint, vec3 planeNormal) {
    return point - 2.0 * planeNormal * dot(point - planePoint, planeNormal);
}

bool primeSolvePreviousRefraction(
        vec3 previousCamera,
        vec3 planePoint,
        vec3 planeNormal,
        vec3 target,
        float relativeEta,
        out vec3 interfacePoint) {
    vec3 helper = abs(planeNormal.z) < 0.9
            ? vec3(0.0, 0.0, 1.0)
            : vec3(0.0, 1.0, 0.0);
    vec3 tangent = normalize(cross(helper, planeNormal));
    vec3 bitangent = cross(planeNormal, tangent);
    interfacePoint = planePoint;

    // Minimize n_i |X-C| + n_t |Q-X| on the sampled microfacet plane. relativeEta is
    // n_t / n_i, exactly the convention carried by BsdfSample. This is Fermat/Snell reprojection,
    // not a screen-space heuristic; four Newton steps are ample for frame-to-frame camera motion.
    for (uint iteration = 0u; iteration < 4u; ++iteration) {
        vec3 incidentDelta = interfacePoint - previousCamera;
        vec3 transmittedDelta = target - interfacePoint;
        float incidentLength = length(incidentDelta);
        float transmittedLength = length(transmittedDelta);
        if (!(incidentLength > 1.0e-5) || !(transmittedLength > 1.0e-5)) {
            return false;
        }
        vec3 incident = incidentDelta / incidentLength;
        vec3 transmitted = transmittedDelta / transmittedLength;
        vec3 stationarity = incident - relativeEta * transmitted;
        vec2 residual = vec2(
                dot(stationarity, tangent),
                dot(stationarity, bitangent));
        mat3 identity = mat3(1.0);
        mat3 derivative = (identity - outerProduct(incident, incident)) / incidentLength
                + relativeEta
                * (identity - outerProduct(transmitted, transmitted)) / transmittedLength;
        mat2 jacobian = mat2(
                dot(tangent, derivative * tangent),
                dot(bitangent, derivative * tangent),
                dot(tangent, derivative * bitangent),
                dot(bitangent, derivative * bitangent));
        float jacobianDeterminant = determinant(jacobian);
        if (!(abs(jacobianDeterminant) > 1.0e-8)) {
            return false;
        }
        vec2 step = inverse(jacobian) * residual;
        float stepLength = length(step);
        if (stepLength > 8.0) {
            step *= 8.0 / stepLength;
        }
        interfacePoint -= tangent * step.x + bitangent * step.y;
    }

    vec3 incidentDelta = interfacePoint - previousCamera;
    vec3 transmittedDelta = target - interfacePoint;
    if (!(length(incidentDelta) > 1.0e-5) || !(length(transmittedDelta) > 1.0e-5)) {
        return false;
    }
    vec3 stationarity = normalize(incidentDelta)
            - relativeEta * normalize(transmittedDelta);
    return length(vec2(
            dot(stationarity, tangent),
            dot(stationarity, bitangent))) < 2.0e-3;
}

void primeStoreInvalidTransparentGuide(ivec2 pixel, vec3 rawRadiance) {
    imageStore(primeNoisyDiffuse, pixel, vec4(0.0));
    imageStore(
            primeNormalRoughness,
            pixel,
            primeNrdPackNormalRoughness(vec3(0.0, 0.0, 1.0), 1.0));
    imageStore(primeViewZ, pixel, vec4(PRIME_TRANSPARENT_SKY_VIEW_Z));
    imageStore(primeMotion, pixel, vec4(0.0));
    imageStore(primeMetadata, pixel, vec4(rawRadiance, -1.0));
}

void main() {
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    ivec2 extent = imageSize(primeViewZ);
    if (any(greaterThanEqual(pixel, extent))) {
        return;
    }

    vec4 metadata = imageLoad(primeMetadata, pixel);
    vec4 rawDiffuse = imageLoad(primeNoisyDiffuse, pixel);
    vec4 guidePositionData = imageLoad(primeGuidePosition, pixel);
    vec4 guide = imageLoad(primeGuideMaterial, pixel);
    vec4 interfaceData = imageLoad(primeInterface, pixel);
    if (metadata.a < 0.0) {
        // Deterministic atmosphere/sun misses bypass NRD and remain directly summable.
        imageStore(primeNoisyDiffuse, pixel, vec4(0.0));
        imageStore(
                primeNormalRoughness,
                pixel,
                primeNrdPackNormalRoughness(vec3(0.0, 0.0, 1.0), 1.0));
        imageStore(primeViewZ, pixel, vec4(PRIME_TRANSPARENT_SKY_VIEW_Z));
        imageStore(primeMotion, pixel, vec4(0.0));
        return;
    }

    vec3 planePoint = guidePositionData.xyz;
    vec3 target = planePoint + interfaceData.xyz;
    vec3 planeNormal = primeUnpackTransparentNormal(guidePositionData.w);
    float relativeEta = max(interfaceData.w, 1.0e-4);
    vec3 virtualNormal = normalize(guide.rgb);
    float virtualRoughness = clamp(guide.a, 0.0, 1.0);
    vec3 currentVirtualPosition;
    vec3 previousVirtualPosition;
    vec4 transparentState =
            primeMotionPush.previousRenderedWorldToClipOrTransparentState[0];
    bool reflectionBranch = transparentState.w
            < 0.5 * (PRIME_REFLECTION_BRANCH + 2.0);

    if (reflectionBranch) {
        currentVirtualPosition = primeMirrorPointAcrossPlane(
                target, planePoint, planeNormal);
        previousVirtualPosition = currentVirtualPosition;
        virtualNormal = normalize(
                virtualNormal - 2.0 * planeNormal * dot(virtualNormal, planeNormal));
    } else {
        float transmittedLength = length(target - planePoint);
        if (transmittedLength <= 1.0e-4) {
            // A stochastic environment continuation has no finite second surface. It is filtered
            // against the real first interface instead of inventing refractive geometry.
            currentVirtualPosition = planePoint;
            previousVirtualPosition = planePoint;
        } else {
            float incidentLength = length(planePoint);
            vec3 currentDirection = planePoint / max(incidentLength, 1.0e-5);
            float currentOpticalDistance = incidentLength
                    + relativeEta * transmittedLength;
            currentVirtualPosition = currentDirection * currentOpticalDistance;

            vec3 previousCamera = transparentState.xyz;
            vec3 previousInterface;
            if (!primeSolvePreviousRefraction(
                    previousCamera,
                    planePoint,
                    planeNormal,
                    target,
                    relativeEta,
                    previousInterface)) {
                primeStoreInvalidTransparentGuide(pixel, rawDiffuse.rgb);
                return;
            }
            vec3 previousDirection = normalize(previousInterface - previousCamera);
            float previousOpticalDistance = length(previousInterface - previousCamera)
                    + relativeEta * length(target - previousInterface);
            previousVirtualPosition = previousCamera
                    + previousDirection * previousOpticalDistance;
        }
    }

    vec3 cameraForward = primeTransparentMotionRayDirection(vec2(0.5));
    float currentViewZ = dot(currentVirtualPosition, cameraForward);
    if (!(currentViewZ > 0.0)
            || currentViewZ >= PRIME_TRANSPARENT_SKY_VIEW_Z
            || any(isnan(currentVirtualPosition))
            || any(isinf(currentVirtualPosition))) {
        primeStoreInvalidTransparentGuide(pixel, rawDiffuse.rgb);
        return;
    }

    float normalizedHitDistance = rawDiffuse.a <= 0.0
            ? 0.0
            : primeNrdNormalizedHitDistance(rawDiffuse.a, currentViewZ, virtualRoughness);
    imageStore(
            primeNoisyDiffuse,
            pixel,
            primeNrdPackRadianceAndHitDistance(rawDiffuse.rgb, normalizedHitDistance));
    imageStore(
            primeNormalRoughness,
            pixel,
            primeNrdPackNormalRoughness(virtualNormal, virtualRoughness));
    imageStore(primeViewZ, pixel, vec4(currentViewZ));

    vec2 currentUv = (vec2(pixel) + vec2(0.5)) / vec2(extent);
    vec4 previousClip = primeMotionPush.previousWorldToClip
            * vec4(previousVirtualPosition, 1.0);
    if (!(abs(previousClip.w) > 1.0e-6)
            || any(isnan(previousClip))
            || any(isinf(previousClip))) {
        imageStore(primeMotion, pixel, vec4(0.0));
        return;
    }
    vec2 previousNdc = previousClip.xy / previousClip.w;
    vec2 previousUv = previousNdc * vec2(0.5, -0.5) + vec2(0.5);
    float previousViewZ = abs(previousClip.w);
    // NRD's immutable screen-space convention is previous = current + motion.
    imageStore(
            primeMotion,
            pixel,
            vec4(previousUv - currentUv, previousViewZ - currentViewZ, 0.0));
}
