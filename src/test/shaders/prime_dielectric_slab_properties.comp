#version 460
#extension GL_GOOGLE_include_directive : require

#define PRIME_RC_TRANSMISSION_GGX_SET 0
#define PRIME_RC_TRANSMISSION_GGX_BINDING 2
#include "prime_test_abi.glsl"
#include "prime_bsdf_specializations.glsl"

const uint PRIME_SLAB_INPUT_WORDS = 1u;
const uint PRIME_SLAB_WITNESS_WORDS = 8u;

PrimeRcVolumeStack primeSlabEmptyStack() {
    PrimeRcVolumeStack stack;
    stack.values[0].extinction = vec3(0.0);
    stack.values[0].albedo = vec3(0.0);
    stack.values[0].anisotropy = 0.0;
    stack.values[0].ior = 1.0;
    stack.values[1] = stack.values[0];
    stack.count = 0u;
    return stack;
}

PrimeRcMaterial primeSlabMaterial(float ior) {
    PrimeRcMaterial material = primeRcMaterialFromMetallic(
            vec3(1.0), 0.0, 0.0, vec3(0.0, 0.0, 1.0));
    material.weight.transmission = 1.0;
    material.geometry.thinWalled = 0u;
    material.geometry.thickness = 1.0;
    material.specular.ior = ior;
    material.transmission.color = vec3(1.0);
    material.transmission.depth = 0.0;
    material.transmission.scatter = vec3(0.0);
    material.transmission.scatterAnisotropy = 0.0;
    material.transmission.dispersionScale = 0.0;
    return material;
}

PrimeRcState primeSlabState(
        PrimeRcMaterial material, vec3 wi, PrimeRcVolumeStack stack) {
    PrimeRcState state = primeRcTransmissionStateInit(
            material,
            wi,
            primeRcInverseOutsideIor(wi.z, stack),
            4.0,
            vec3(630.0, 532.0, 467.0),
            0u,
            PRIME_RC_DETAIL_DEFAULT,
            0u);
    state = primeRcPrimeTransmissionInterfaceState(wi, state);
    state.samplingFlags = PRIME_RC_FLAG_DELTA_TRANSMISSION;
    return state;
}

void primeSlabClassify(inout uint mask, PrimeRcSample sampleValue) {
    mask |= primeTestClassify(sampleValue.wo);
    mask |= primeTestClassify(sampleValue.throughput.value);
    mask |= primeTestClassify(sampleValue.pdf);
    mask |= primeTestClassify(sampleValue.eta);
}

void main() {
    uint caseIndex;
    if (!primeTestBegin(caseIndex)) return;
    uint inputOffset = primeTestInputOffset(caseIndex, PRIME_SLAB_INPUT_WORDS);
    vec2 parameters = uintBitsToFloat(primeTestInput.words[inputOffset].xy);
    float ior = parameters.x;
    float sine = parameters.y;
    float cosine = sqrt(max(0.0, 1.0 - sine * sine));
    vec3 wi = vec3(sine, 0.0, cosine);
    vec3 randomValue = vec3(0.5, 0.5, 0.0);
    PrimeRcMaterial material = primeSlabMaterial(ior);

    uint mask = 0u;
    PrimeRcVolumeStack emptyStack = primeSlabEmptyStack();
    PrimeRcState enterState = primeSlabState(material, wi, emptyStack);
    PrimeRcSampleResult entered = primeRcPrimeTransmissionSample(
            wi, randomValue, enterState, emptyStack);
    vec3 exitWi = entered.bsdfSample.wo;
    PrimeRcState exitState = primeSlabState(material, exitWi, entered.volumeStack);
    PrimeRcSampleResult exited = primeRcPrimeTransmissionSample(
            exitWi, randomValue, exitState, entered.volumeStack);

    primeSlabClassify(mask, entered.bsdfSample);
    primeSlabClassify(mask, exited.bsdfSample);
    mask |= primeTestClassify(enterState.specularFresnel.ior);
    mask |= primeTestClassify(exitState.specularFresnel.ior);
    mask |= primeTestClassify(enterState.transmissionMultipleScattering);
    mask |= primeTestClassify(exitState.transmissionMultipleScattering);

    if (entered.bsdfSample.throughput.flags != PRIME_RC_FLAG_DELTA_TRANSMISSION
            || exited.bsdfSample.throughput.flags != PRIME_RC_FLAG_DELTA_TRANSMISSION) {
        mask |= PRIME_TEST_FAILURE_EVENT;
    }
    if (entered.volumeStack.count != 1u
            || exited.volumeStack.count != 0u
            || !primeTestClose(exited.rayT, 0.0, 0.0, 0.0)) {
        mask |= PRIME_TEST_FAILURE_STATE;
    }
    if (!primeTestClose(enterState.specularFresnel.ior, ior, 2.0e-6, 2.0e-6)
            || !primeTestClose(exitState.specularFresnel.ior, ior, 2.0e-6, 2.0e-6)
            || !primeTestClose(
                    entered.bsdfSample.eta * exited.bsdfSample.eta,
                    1.0,
                    2.0e-6,
                    2.0e-6)) {
        mask |= PRIME_TEST_FAILURE_RECIPROCITY;
    }
    if (!primeTestClose(exited.bsdfSample.wo, wi, 4.0e-6, 2.0e-5)) {
        mask |= PRIME_TEST_FAILURE_ROUND_TRIP;
    }
    vec3 enterTransmission = entered.bsdfSample.throughput.value
            * primeRcSquare(entered.bsdfSample.eta);
    vec3 exitTransmission = exited.bsdfSample.throughput.value
            * primeRcSquare(exited.bsdfSample.eta);
    if (!primeTestClose(enterTransmission, exitTransmission, 4.0e-6, 2.0e-5)) {
        mask |= PRIME_TEST_FAILURE_VALUE;
    }

    float criticalSine = 1.0 / ior;
    float tirSine = 0.5 * (criticalSine + 1.0);
    float tirCosine = sqrt(max(0.0, 1.0 - tirSine * tirSine));
    vec3 tirWi = vec3(-tirSine, 0.0, -tirCosine);
    PrimeRcState tirState = primeSlabState(material, tirWi, entered.volumeStack);
    PrimeRcSampleResult tir = primeRcPrimeTransmissionSample(
            tirWi, randomValue, tirState, entered.volumeStack);
    primeSlabClassify(mask, tir.bsdfSample);
    if (tir.bsdfSample.throughput.flags != PRIME_RC_FLAG_NONE
            || tir.volumeStack.count != 1u
            || !primeTestClose(tirState.specularFresnel.ior, ior, 2.0e-6, 2.0e-6)) {
        mask |= PRIME_TEST_FAILURE_EVENT;
    }

    uint outputWords = primeTestOutputWords();
    uint outputOffset = primeTestOutputOffset(caseIndex, outputWords);
    primeTestOutput.words[outputOffset] = uvec4(mask, 0u, caseIndex, 0u);
    if (outputWords >= PRIME_SLAB_WITNESS_WORDS) {
        primeTestOutput.words[outputOffset + 1u] =
                primeTestInput.words[inputOffset];
        primeTestOutput.words[outputOffset + 2u] = floatBitsToUint(vec4(
                enterState.specularFresnel.ior,
                exitState.specularFresnel.ior,
                entered.bsdfSample.eta,
                exited.bsdfSample.eta));
        primeTestOutput.words[outputOffset + 3u] =
                floatBitsToUint(vec4(entered.bsdfSample.wo, entered.bsdfSample.pdf));
        primeTestOutput.words[outputOffset + 4u] =
                floatBitsToUint(vec4(exited.bsdfSample.wo, exited.bsdfSample.pdf));
        primeTestOutput.words[outputOffset + 5u] =
                floatBitsToUint(vec4(enterTransmission, entered.rayT));
        primeTestOutput.words[outputOffset + 6u] =
                floatBitsToUint(vec4(exitTransmission, exited.rayT));
        primeTestOutput.words[outputOffset + 7u] = uvec4(
                entered.bsdfSample.throughput.flags,
                exited.bsdfSample.throughput.flags,
                tir.bsdfSample.throughput.flags,
                tir.volumeStack.count);
    }
}
