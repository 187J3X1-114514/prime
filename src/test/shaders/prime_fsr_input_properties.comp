#version 460
#extension GL_GOOGLE_include_directive : require

#include "prime_test_abi.glsl"
#include "fsr_input.glsl"

const uint PRIME_FSR_INPUT_WORDS = 3u;
const uint PRIME_FSR_WITNESS_WORDS = 5u;

void main() {
    uint caseIndex;
    if (!primeTestBegin(caseIndex)) return;
    uint inputOffset = primeTestInputOffset(caseIndex, PRIME_FSR_INPUT_WORDS);
    uvec4 control = primeTestInput.words[inputOffset];
    vec4 values = uintBitsToFloat(primeTestInput.words[inputOffset + 1u]);
    vec4 second = uintBitsToFloat(primeTestInput.words[inputOffset + 2u]);
    uint kind = control.x;
    uint mask = 0u;
    vec4 actual = vec4(0.0);
    vec4 expected = vec4(0.0);

    if (kind == 0u) {
        uint flags = control.y;
        PrimeFsrMasks masks = primeFsrMasks(flags);
        actual.xy = vec2(masks.reactive, masks.transparencyAndComposition);
        expected.xy = primeMaterialIsTransmissive(flags)
                ? vec2(0.0, 1.0)
                : vec2(
                        0.0,
                        (flags & PRIME_MATERIAL_ANIMATED) != 0u
                                ? 0.75
                                : 0.0);
        if (!primeTestClose(actual.x, expected.x, 0.0, 0.0)
                || !primeTestClose(actual.y, expected.y, 0.0, 0.0)) {
            mask |= PRIME_TEST_FAILURE_STATE;
        }
    } else if (kind == 1u) {
        actual.x = primeFsrReversedInfiniteDepth(values.x);
        expected.x = primeNrdIsFinite(values.x) && values.x > 0.0
                ? clamp(PRIME_FSR_NEAR_PLANE / values.x, 0.0, 1.0)
                : 0.0;
        mask |= primeTestClassify(actual.x);
        if (actual.x < 0.0 || actual.x > 1.0) {
            mask |= PRIME_TEST_FAILURE_RANGE;
        }
        if (!primeTestClose(actual.x, expected.x, 0.0, 0.0)) {
            mask |= PRIME_TEST_FAILURE_IDENTITY;
        }
    } else if (kind == 2u) {
        actual.xy = primeFsrNormalizedMotion(values.xy, values.zw);
        vec2 raw = values.xy - values.zw;
        expected.xy = primeNrdIsFinite(raw)
                ? clamp(raw, vec2(-1.0), vec2(1.0))
                : vec2(0.0);
        mask |= primeTestClassify(actual.xy);
        if (any(lessThan(actual.xy, vec2(-1.0)))
                || any(greaterThan(actual.xy, vec2(1.0)))) {
            mask |= PRIME_TEST_FAILURE_RANGE;
        }
        if (!primeTestClose(actual.x, expected.x, 0.0, 0.0)
                || !primeTestClose(actual.y, expected.y, 0.0, 0.0)) {
            mask |= PRIME_TEST_FAILURE_IDENTITY;
        }
    } else if (kind == 3u) {
        actual.x = primeFsrSurfaceViewZ(values.xyz, second.xyz);
        float raw = dot(values.xyz, second.xyz);
        expected.x = primeNrdIsFinite(raw) && raw > 0.0
                ? min(raw, PRIME_NRD_FP16_MAX)
                : PRIME_NRD_FP16_MAX;
        mask |= primeTestClassify(actual.x);
        if (actual.x <= 0.0 || actual.x > PRIME_NRD_FP16_MAX) {
            mask |= PRIME_TEST_FAILURE_RANGE;
        }
        if (!primeTestClose(actual.x, expected.x, 0.0, 0.0)) {
            mask |= PRIME_TEST_FAILURE_IDENTITY;
        }
    } else if (kind == 4u) {
        actual.x = primeFsrSanitizeMask(values.x);
        expected.x = primeNrdSanitizeUnit(values.x, 0.0);
        mask |= primeTestClassify(actual.x);
        if (actual.x < 0.0 || actual.x > 1.0) {
            mask |= PRIME_TEST_FAILURE_RANGE;
        }
        if (!primeTestClose(actual.x, expected.x, 0.0, 0.0)) {
            mask |= PRIME_TEST_FAILURE_IDENTITY;
        }
    } else {
        mask |= PRIME_TEST_FAILURE_EVENT;
    }

    uint outputWords = primeTestOutputWords();
    uint outputOffset = primeTestOutputOffset(caseIndex, outputWords);
    primeTestOutput.words[outputOffset] = uvec4(mask, kind, caseIndex, 0u);
    if (outputWords >= PRIME_FSR_WITNESS_WORDS) {
        primeTestOutput.words[outputOffset + 1u] = control;
        primeTestOutput.words[outputOffset + 2u] = floatBitsToUint(values);
        primeTestOutput.words[outputOffset + 3u] = floatBitsToUint(second);
        primeTestOutput.words[outputOffset + 4u] =
                floatBitsToUint(vec4(actual.xy, expected.xy));
    }
}
