#version 460
#extension GL_GOOGLE_include_directive : require

#include "common.glsl"
#include "shadow_payload.glsl"

layout(location = 1) rayPayloadEXT PrimeShadowPayload primeShadowPayload;

const int PRIME_SUN_SHADOW_RESOLUTION = 512;
const float PRIME_SUN_SHADOW_NO_HIT_DEPTH = -1.0e20;

void primeStoreSunShadowDepth(int imageIndex, ivec2 coordinate, float depth) {
    if (imageIndex == 0) {
        imageStore(primeSunShadowDepth0, coordinate, vec4(depth));
    } else if (imageIndex == 1) {
        imageStore(primeSunShadowDepth1, coordinate, vec4(depth));
    } else if (imageIndex == 2) {
        imageStore(primeSunShadowDepth2, coordinate, vec4(depth));
    } else if (imageIndex == 3) {
        imageStore(primeSunShadowDepth3, coordinate, vec4(depth));
    } else if (imageIndex == 4) {
        imageStore(primeSunShadowDepth4, coordinate, vec4(depth));
    } else if (imageIndex == 5) {
        imageStore(primeSunShadowDepth5, coordinate, vec4(depth));
    } else if (imageIndex == 6) {
        imageStore(primeSunShadowDepth6, coordinate, vec4(depth));
    } else if (imageIndex == 7) {
        imageStore(primeSunShadowDepth7, coordinate, vec4(depth));
    } else if (imageIndex == 8) {
        imageStore(primeSunShadowDepth8, coordinate, vec4(depth));
    } else {
        imageStore(primeSunShadowDepth9, coordinate, vec4(depth));
    }
}

void main() {
    ivec2 launch = ivec2(gl_LaunchIDEXT.xy);
    if (any(greaterThanEqual(launch, ivec2(primePush.outputExtent)))) {
        return;
    }
    ivec2 regionCoordinate = ivec2(primePush.path.xy) + launch;
    int target = int(primePush.path.z);
    int imageIndex = target & 15;
    int storageBits = int(primePush.path.w);
    ivec2 storageOffset = ivec2(
            storageBits & (PRIME_SUN_SHADOW_RESOLUTION - 1),
            (storageBits >> 9) & (PRIME_SUN_SHADOW_RESOLUTION - 1));
    ivec2 storageCoordinate =
            (storageOffset + regionCoordinate) & (PRIME_SUN_SHADOW_RESOLUTION - 1);

    vec3 basisU = primePush.inverseViewProjection[0].xyz;
    float texelSize = primePush.inverseViewProjection[0].w;
    vec3 basisV = primePush.inverseViewProjection[1].xyz;
    float halfTraceDistance = primePush.inverseViewProjection[1].w;
    vec3 planeOrigin = primePush.inverseViewProjection[2].xyz;
    vec3 rayOrigin = planeOrigin
            + basisU * ((float(regionCoordinate.x) + 0.5) * texelSize)
            + basisV * ((float(regionCoordinate.y) + 0.5) * texelSize);
    vec3 directionToSun = normalize(primePush.sunDirection);

    float traceDistance = 2.0 * halfTraceDistance;
    primeShadowPayload.opticalDepthMomentHitDistance = vec4(0.0);
    primeShadowPayload.terminalExtinctionRayDistance = vec4(0.0, 0.0, 0.0, traceDistance);
    primeShadowPayload.startingExtinction0Winding = vec4(0.0);
    primeShadowPayload.startingExtinction1Winding = vec4(0.0);
    primeShadowPayload.startingMediumCount = 0u;
    traceRayEXT(
            primeScene,
            gl_RayFlagsNoneEXT,
            0xff,
            3,
            1,
            1,
            rayOrigin,
            0.001,
            -directionToSun,
            traceDistance,
            1);

    float hitDistance = primeShadowPayload.opticalDepthMomentHitDistance.w;
    float depth = hitDistance >= 65504.0
            ? PRIME_SUN_SHADOW_NO_HIT_DEPTH
            : dot(
                    rayOrigin
                            - directionToSun * hitDistance,
                    directionToSun);
    primeStoreSunShadowDepth(imageIndex, storageCoordinate, depth);
}
