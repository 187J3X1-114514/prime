#version 460
#extension GL_GOOGLE_include_directive : require

#include "atmosphere.glsl"
#include "display_transform.glsl"
#include "nrd_common.glsl"
#include "nrd_sh.glsl"

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

// FSR consumes scene-referred linear Rec.2020 HDR. The Oklab display transform belongs strictly
// after upscaling; applying it here would make temporal interpolation operate on non-linear,
// display-referred values and violate both the integrator and FSR signal contracts.
layout(set = 0, binding = 0, rgba16f) uniform writeonly image2D primeCompositeOutput;
layout(set = 0, binding = 1, rgba16f) uniform readonly image2D primeDenoisedDiffuse;
layout(set = 0, binding = 2, rgba16f) uniform readonly image2D primeDenoisedSpecular;
layout(set = 0, binding = 3, rgba16f) uniform readonly image2D primeCompositeMaterial;
layout(set = 0, binding = 4, rgba16f) uniform readonly image2D primeCompositeSpecularMaterial;
layout(set = 0, binding = 5, rgba32f) uniform readonly image2D primeStableAccumulation;
layout(set = 0, binding = 6, rgba16f) uniform readonly image3D primeCompositeAerialRadiance;
layout(set = 0, binding = 7, rgba16f) uniform readonly image3D primeCompositeAerialTransmittance;
layout(set = 0, binding = 8, rgba8) uniform image2D primeNrdValidation;
layout(set = 0, binding = 9, rgba16f) uniform readonly image2D primeReprojectionError;
layout(set = 0, binding = 10, rgba16f) uniform readonly image2D primeMotionDiagnostic;
layout(set = 0, binding = 11, r8) uniform writeonly image2D primeFsrReactiveMask;
layout(set = 0, binding = 12, r8) uniform writeonly image2D primeFsrTransparencyCompositionMask;
layout(set = 0, binding = 13, rgba16f) uniform readonly image2D primeUnshadowedSunLighting;
layout(set = 0, binding = 14, r16f) uniform readonly image2D primeSigmaSunShadow;
layout(set = 0, binding = 15, rgba16f) uniform readonly image2D primeDenoisedDiffuseSh1;
layout(set = 0, binding = 16, rgba16f) uniform readonly image2D primeDenoisedSpecularSh1;
layout(set = 0, binding = 17, rgb10_a2) uniform readonly image2D primeCompositeNormalRoughness;
layout(set = 0, binding = 18, r32f) uniform readonly image2D primeCompositeViewZ;
layout(set = 0, binding = 19, rgba32f) uniform readonly image2D primeCompositePrimaryPosition;
layout(set = 0, binding = 20, rgba16f) uniform readonly image2D primeNoisySpecular;

layout(push_constant) uniform PrimeCompositePushConstants {
    uvec2 outputExtent;
    uint diagnosticMode;
    float sunRadianceMultiplier;
    vec2 currentJitterPixels;
    float displayOverexposure;
} primeCompositePush;

const uint PRIME_DIAGNOSTIC_OFF = 0u;
const uint PRIME_DIAGNOSTIC_NRD_VALIDATION = 1u;
const uint PRIME_DIAGNOSTIC_REPROJECTION_ERROR = 2u;
const uint PRIME_DIAGNOSTIC_MOTION = 3u;
const uint PRIME_DIAGNOSTIC_SPECULAR_INPUT = 4u;
const uint PRIME_DIAGNOSTIC_SPECULAR_OUTPUT = 5u;
const uint PRIME_DIAGNOSTIC_SPECULAR_REMODULATED = 6u;

#ifndef PRIME_ENABLE_FILTERED_SUN_SHADOW
#define PRIME_ENABLE_FILTERED_SUN_SHADOW 1
#endif

ATM_DECLARE_SAMPLE_3D(primeCompositeSampleAerialRadiance, primeCompositeAerialRadiance)
ATM_DECLARE_SAMPLE_3D(primeCompositeSampleAerialTransmittance, primeCompositeAerialTransmittance)

vec3 primeCompositeSurfaceSignal(
        vec4 material,
        vec3 specularAlbedo,
        vec3 diffuseSignal,
        vec3 specularSignal,
        vec3 sunSignal) {
    // A negative primary distance is raygen's immutable miss marker. Sky radiance lives entirely
    // in primeStableAccumulation and must never consume REBLUR output: NRD treats its out-of-range
    // view-Z as invalid and is not required to erase surface history when a pixel becomes sky.
    if (!primeNrdIsFinite(material.a) || material.a < 0.0) {
        return vec3(0.0);
    }
    vec3 diffuseAlbedo = primeNrdSanitizeAlbedo(material.rgb);
    vec3 safeSpecularAlbedo = primeNrdSanitizeAlbedo(specularAlbedo);
    vec3 diffuse = primeNrdSanitizeRadiance(diffuseSignal) * diffuseAlbedo;
    vec3 specular = primeNrdSanitizeRadiance(specularSignal) * safeSpecularAlbedo;
    primeNrdClampRadianceTriple(
            diffuse, specular, sunSignal, PRIME_NRD_FP16_MAX);
    return diffuse + specular + sunSignal;
}

void primeCompositeApplyAerial(uvec2 pixel, float primaryDistance, inout vec3 radiance) {
    if (!primeNrdIsFinite(primaryDistance) || primaryDistance < 0.0) {
        return;
    }
    float distanceKm = primaryDistance * ATM_WORLD_UNIT_SCALE_KM;
    ivec3 dimensions = imageSize(primeCompositeAerialRadiance);
    float firstSliceDepth = 0.5 / float(max(dimensions.z, 1));
    float firstSliceDistanceKm = ATM_AERIAL_MAX_DISTANCE_KM * firstSliceDepth * firstSliceDepth;
    float normalizedDepth = max(firstSliceDepth, sqrt(clamp(
            distanceKm / max(ATM_AERIAL_MAX_DISTANCE_KM, 1.0e-6), 0.0, 1.0)));
    float nearWeight = clamp(distanceKm / max(firstSliceDistanceKm, 1.0e-6), 0.0, 1.0);
    vec2 screenUv = (vec2(pixel) + vec2(0.5)
            + primeCompositePush.currentJitterPixels)
            / vec2(primeCompositePush.outputExtent);
    vec3 uvw = vec3(screenUv, normalizedDepth);
    vec3 inscatter = max(primeCompositeSampleAerialRadiance(uvw).rgb, vec3(0.0));
    vec3 transmittance = clamp(
            primeCompositeSampleAerialTransmittance(uvw).rgb, vec3(0.0), vec3(1.0));
    if (any(isnan(inscatter)) || any(isinf(inscatter))) {
        inscatter = vec3(0.0);
    }
    if (any(isnan(transmittance)) || any(isinf(transmittance))) {
        transmittance = vec3(1.0);
    }
    radiance = radiance * mix(vec3(1.0), transmittance, nearWeight)
            + inscatter * nearWeight * primeCompositePush.sunRadianceMultiplier;
}

ivec2 primeCompositeNeighbor(ivec2 pixel, ivec2 offset) {
    return clamp(
            pixel + offset,
            ivec2(0),
            ivec2(primeCompositePush.outputExtent) - ivec2(1));
}

vec3 primeCompositeNormal(ivec2 pixel) {
    vec3 normal;
    float roughness;
    primeNrdUnpackNormalRoughness(
            imageLoad(primeCompositeNormalRoughness, pixel), normal, roughness);
    return normal;
}

void primeCompositeResolveSh(
        ivec2 pixel,
        float primaryDistance,
        out vec3 diffuse,
        out vec3 specular) {
    diffuse = vec3(0.0);
    specular = vec3(0.0);
    if (!primeNrdIsFinite(primaryDistance) || primaryDistance < 0.0) {
        return;
    }

    vec3 normal;
    float roughness;
    primeNrdUnpackNormalRoughness(
            imageLoad(primeCompositeNormalRoughness, pixel), normal, roughness);
    vec3 primaryPosition = imageLoad(primeCompositePrimaryPosition, pixel).xyz;
    vec3 view = primeNrdSafeNormalize(-primaryPosition, normal);
    PrimeNrdSg diffuseSg = primeNrdUnpackSg(
            imageLoad(primeDenoisedDiffuse, pixel),
            imageLoad(primeDenoisedDiffuseSh1, pixel).xyz);
    PrimeNrdSg specularSg = primeNrdUnpackSg(
            imageLoad(primeDenoisedSpecular, pixel),
            imageLoad(primeDenoisedSpecularSh1, pixel).xyz);
    float materialId = imageLoad(primeCompositeNormalRoughness, pixel).a;
    if (materialId > 0.5 && materialId < 5.0 / 6.0) {
        // NRD's SG resolver evaluates a reflective GGX lobe. A refracted direction lies below the
        // visible interface and would be clamped away, so transmission consumes the filtered SH0
        // color without applying a reflection-only resolve or re-jitter Jacobian.
        diffuse = primeNrdSgExtractColor(diffuseSg);
        specular = primeNrdSgExtractColor(specularSg);
        return;
    }
    bool hasDiffuseDirection = length(diffuseSg.c1) > PRIME_NRD_EPS;
    bool hasSpecularDirection = length(specularSg.c1) > PRIME_NRD_EPS;
    diffuse = hasDiffuseDirection
            ? primeNrdResolveSgDiffuse(diffuseSg, normal, view, roughness)
            : primeNrdSgExtractColor(diffuseSg);
    specular = hasSpecularDirection
            ? primeNrdResolveSgSpecular(specularSg, normal, view, roughness)
            : primeNrdSgExtractColor(specularSg);

    ivec2 east = primeCompositeNeighbor(pixel, ivec2(1, 0));
    ivec2 west = primeCompositeNeighbor(pixel, ivec2(-1, 0));
    ivec2 north = primeCompositeNeighbor(pixel, ivec2(0, 1));
    ivec2 south = primeCompositeNeighbor(pixel, ivec2(0, -1));
    float viewZ = imageLoad(primeCompositeViewZ, pixel).x;
    vec4 neighborViewZ = vec4(
            imageLoad(primeCompositeViewZ, east).x,
            imageLoad(primeCompositeViewZ, west).x,
            imageLoad(primeCompositeViewZ, north).x,
            imageLoad(primeCompositeViewZ, south).x);
    vec2 scale = primeNrdSgReJitter(
            diffuseSg,
            specularSg,
            view,
            roughness,
            viewZ,
            neighborViewZ,
            normal,
            primeCompositeNormal(east),
            primeCompositeNormal(west),
            primeCompositeNormal(north),
            primeCompositeNormal(south));
    if (!hasDiffuseDirection) scale.x = 1.0;
    if (!hasSpecularDirection) scale.y = 1.0;
    diffuse *= scale.x;
    specular *= scale.y;
}

vec3 primeCompositeRadiance(uvec2 pixel, vec4 material, vec4 specularMaterial) {
    vec4 unshadowedSunLighting = imageLoad(
            primeUnshadowedSunLighting, ivec2(pixel));
#if PRIME_ENABLE_FILTERED_SUN_SHADOW
    // The filtered shadow is stored as sqrt(visibility).
    float encodedSunShadow = imageLoad(primeSigmaSunShadow, ivec2(pixel)).x;
    float sunVisibility = isnan(encodedSunShadow) || isinf(encodedSunShadow)
            ? primeNrdSanitizeUnit(unshadowedSunLighting.a, 0.0)
            : clamp(encodedSunShadow * encodedSunShadow, 0.0, 1.0);
#else
    float sunVisibility = primeNrdSanitizeUnit(unshadowedSunLighting.a, 0.0);
#endif
    vec3 sunSignal = material.a >= 0.0
            ? unshadowedSunLighting.rgb * sunVisibility
            : vec3(0.0);
    vec3 diffuseSignal;
    vec3 specularSignal;
    primeCompositeResolveSh(
            ivec2(pixel), material.a, diffuseSignal, specularSignal);
    vec3 surface = primeCompositeSurfaceSignal(
            material,
            specularMaterial.rgb,
            diffuseSignal,
            specularSignal,
            sunSignal);
    vec3 stable = primeNrdClampRadiance(
            imageLoad(primeStableAccumulation, ivec2(pixel)).rgb,
            PRIME_NRD_FP16_MAX);
    vec3 radiance = surface + stable;
    primeCompositeApplyAerial(pixel, material.a, radiance);
    return primeNrdClampRadiance(radiance, PRIME_NRD_FP16_MAX);
}

vec3 primeCompositeSh0Color(vec4 sh0) {
    return primeNrdSgExtractColor(primeNrdUnpackSg(sh0, vec3(0.0)));
}

vec3 primeCompositeRemodulatedSpecular(
        uvec2 pixel, vec4 material, vec3 specularAlbedo) {
    if (!primeNrdIsFinite(material.a) || material.a < 0.0) {
        return vec3(0.0);
    }
    vec3 diffuse;
    vec3 specular;
    primeCompositeResolveSh(ivec2(pixel), material.a, diffuse, specular);
    return primeNrdClampRadiance(
            primeNrdSanitizeRadiance(specular)
                    * primeNrdSanitizeAlbedo(specularAlbedo),
            PRIME_NRD_FP16_MAX);
}

vec3 primeCompositeDisplayDiagnostic(vec3 radiance) {
    radiance = primeNrdIsFinite(radiance) ? max(radiance, vec3(0.0)) : vec3(0.0);
    return primeDisplayTransformToSrgb(
            radiance, primeCompositePush.displayOverexposure);
}

bool primeCompositeIsValidationSceneTile(uvec2 pixel) {
    // Match NRD's 4x4 viewport selection at pixel centers. REBLUR deliberately leaves the middle
    // six tiles untouched for the application-provided beauty image.
    uvec2 viewport = min(
            (pixel * 4u + 2u) / primeCompositePush.outputExtent,
            uvec2(3u));
    return (viewport.x == 1u || viewport.x == 2u) && viewport.y >= 1u;
}

void main() {
    uvec2 pixel = gl_GlobalInvocationID.xy;
    if (any(greaterThanEqual(pixel, primeCompositePush.outputExtent))) {
        return;
    }
    // The single PT/NRD path owns the complete surface signal. Valid surface motion should not be
    // marked reactive, while the material metadata below supplies FSR's composition hint.
    imageStore(primeFsrReactiveMask, ivec2(pixel), vec4(0.0));
    vec4 specularMaterial = imageLoad(
            primeCompositeSpecularMaterial, ivec2(pixel));
    vec4 material = imageLoad(primeCompositeMaterial, ivec2(pixel));
    float transparencyAndComposition = specularMaterial.a;
    imageStore(
            primeFsrTransparencyCompositionMask,
            ivec2(pixel),
            vec4(primeNrdSanitizeUnit(transparencyAndComposition, 0.0)));
    if (primeCompositePush.diagnosticMode == PRIME_DIAGNOSTIC_SPECULAR_INPUT) {
        imageStore(
                primeCompositeOutput,
                ivec2(pixel),
                vec4(primeCompositeDisplayDiagnostic(primeCompositeSh0Color(
                        imageLoad(primeNoisySpecular, ivec2(pixel)))), 1.0));
        return;
    }
    if (primeCompositePush.diagnosticMode == PRIME_DIAGNOSTIC_SPECULAR_OUTPUT) {
        imageStore(
                primeCompositeOutput,
                ivec2(pixel),
                vec4(primeCompositeDisplayDiagnostic(primeCompositeSh0Color(
                        imageLoad(primeDenoisedSpecular, ivec2(pixel)))), 1.0));
        return;
    }
    if (primeCompositePush.diagnosticMode == PRIME_DIAGNOSTIC_SPECULAR_REMODULATED) {
        imageStore(
                primeCompositeOutput,
                ivec2(pixel),
                vec4(primeCompositeDisplayDiagnostic(
                        primeCompositeRemodulatedSpecular(
                                pixel, material, specularMaterial.rgb)), 1.0));
        return;
    }
    if (primeCompositePush.diagnosticMode == PRIME_DIAGNOSTIC_REPROJECTION_ERROR) {
        imageStore(
                primeCompositeOutput,
                ivec2(pixel),
                vec4(imageLoad(primeReprojectionError, ivec2(pixel)).rgb, 1.0));
        return;
    }
    if (primeCompositePush.diagnosticMode == PRIME_DIAGNOSTIC_MOTION) {
        vec3 motion = imageLoad(primeMotionDiagnostic, ivec2(pixel)).xyz;
        vec2 motionPixels = motion.xy * vec2(primeCompositePush.outputExtent);
        vec3 positiveColor = max(motionPixels.x, 0.0) * vec3(1.0, 0.0, 0.0)
                + max(motionPixels.y, 0.0) * vec3(0.0, 1.0, 0.0);
        vec3 negativeColor = max(-motionPixels.x, 0.0) * vec3(0.0, 1.0, 1.0)
                + max(-motionPixels.y, 0.0) * vec3(1.0, 0.0, 1.0);
        vec3 motionColor = (positiveColor + negativeColor + abs(motion.z)) * 0.25;
        imageStore(
                primeCompositeOutput,
                ivec2(pixel),
                vec4(clamp(motionColor, vec3(0.0), vec3(1.0)), 1.0));
        return;
    }
    vec3 radiance = primeCompositeRadiance(pixel, material, specularMaterial);
    if (primeCompositePush.diagnosticMode == PRIME_DIAGNOSTIC_NRD_VALIDATION) {
        vec3 validationColor;
        if (primeCompositeIsValidationSceneTile(pixel)) {
            validationColor = primeCompositeDisplayDiagnostic(radiance);
            imageStore(
                    primeNrdValidation,
                    ivec2(pixel),
                    vec4(validationColor, 1.0));
        } else {
            validationColor = imageLoad(primeNrdValidation, ivec2(pixel)).rgb;
        }
        imageStore(
                primeCompositeOutput,
                ivec2(pixel),
                vec4(validationColor, 1.0));
        return;
    }
    imageStore(
            primeCompositeOutput,
            ivec2(pixel),
            vec4(radiance, 1.0));
}
