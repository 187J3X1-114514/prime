#version 460
#extension GL_GOOGLE_include_directive : require
#if defined(PRIME_ENABLE_SER)
#extension GL_EXT_buffer_reference_uvec2 : require
#extension GL_EXT_shader_invocation_reorder : require
#endif
#include "common.glsl"
#include "atmosphere_rt.glsl"
#include "nrd_common.glsl"

layout(location = 0) rayPayloadEXT TracePayload primePayload;
layout(location = 1) rayPayloadEXT uint primeShadowHitDistanceBits;

#include "sampling.glsl"
#include "bsdf.glsl"
#include "lights.glsl"
#include "integrator.glsl"
#include "camera.glsl"

uint primeClassifyRawOutput(PrimeIntegrationResult result) {
    uint flags = primeClassifyRadiance(result.radiance.diffuse)
            | primeClassifyRadiance(result.radiance.specular)
            | primeClassifyRadiance(result.radiance.stable)
            | primeClassifyRadiance(result.radiance.unshadowedSun)
            | primeClassifyUnit(result.radiance.sunVisibility)
            | primeClassifyRadiance(primeResolveIntegrationRadiance(result));
    flags |= primeClassifyNonFinite(result.guides.primaryDistance)
            | primeClassifyNonnegative(result.guides.specularHitDistance)
            | primeClassifyNonnegative(result.guides.diffuseHitDistance)
            | primeClassifyNonnegative(result.guides.sunPenumbra)
            | primeClassifyUnit(result.guides.primaryAlbedo)
            | primeClassifyDirection(result.guides.primaryNormal)
            | primeClassifyUnit(result.guides.primarySpecularAlbedo)
            | primeClassifyUnit(result.guides.primaryLinearRoughness)
            | primeClassifyNonFinite(result.guides.primaryPosition)
            | primeClassifyRadiance(result.guides.primaryAreaDiffuse)
            | primeClassifyRadiance(result.guides.primaryAreaSpecular);
    if (any(greaterThan(
            result.radiance.diffuse - result.guides.primaryAreaDiffuse, vec3(0.0)))) {
        flags |= primeClassifyDirection(result.guides.diffuseDirection);
    }
    if (any(greaterThan(
            result.radiance.specular - result.guides.primaryAreaSpecular, vec3(0.0)))) {
        flags |= primeClassifyDirection(result.guides.specularDirection);
    }
    if (any(greaterThan(result.guides.primaryAreaDiffuse, vec3(0.0)))
            || any(greaterThan(result.guides.primaryAreaSpecular, vec3(0.0)))) {
        flags |= primeClassifyDirection(result.guides.primaryAreaDirection);
    }
    return flags;
}

vec3 primeRawNumericalColor(uint flags) {
    if (flags == 0u) return vec3(0.0);
    uint nonFinite = flags & (PRIME_NUMERICAL_NAN
            | PRIME_NUMERICAL_POSITIVE_INFINITY
            | PRIME_NUMERICAL_NEGATIVE_INFINITY);
    if (nonFinite == PRIME_NUMERICAL_NAN) return vec3(1.0, 0.0, 1.0);
    if (nonFinite == PRIME_NUMERICAL_POSITIVE_INFINITY) return vec3(1.0, 0.0, 0.0);
    if (nonFinite == PRIME_NUMERICAL_NEGATIVE_INFINITY) return vec3(0.0, 1.0, 1.0);
    if (nonFinite != 0u) return vec3(1.0);
    if ((flags & PRIME_NUMERICAL_FINITE_NEGATIVE) != 0u) return vec3(0.0, 0.25, 1.0);
    if ((flags & PRIME_NUMERICAL_INVALID_DIRECTION) != 0u) return vec3(1.0, 0.0, 0.5);
    if ((flags & PRIME_NUMERICAL_ABOVE_UNIT) != 0u) return vec3(0.5, 0.0, 1.0);
    return vec3(1.0, 1.0, 0.0);
}

vec3 primeNrdEffectiveDirection(
        vec3 totalRadiance,
        vec3 primaryAreaRadiance,
        vec3 primaryAreaDirection,
        vec3 continuationDirection,
        vec3 albedo) {
    vec3 direct = min(primaryAreaRadiance, totalRadiance);
    vec3 continuation = max(totalRadiance - direct, vec3(0.0));
    float directY = primeNrdLinearToYCoCg(primeNrdDemodulate(direct, albedo)).x;
    float continuationY = primeNrdLinearToYCoCg(
            primeNrdDemodulate(continuation, albedo)).x;
    float totalY = directY + continuationY;
    vec3 moment = primaryAreaDirection * directY
            + continuationDirection * continuationY;
    return primeNrdIsFinite(moment) && primeNrdIsFinite(totalY) && totalY > 0.0
            ? clamp(moment / totalY, vec3(-1.0), vec3(1.0))
            : vec3(0.0);
}

void main() {
    uvec2 pixel = gl_LaunchIDEXT.xy;
    IntegratorRecord integrator;
    integrator.sunDirectionIntensity = vec4(
            primePush.sunDirection,
            ATM_SPACE_SUN_INTENSITY * primeSunRadianceMultiplier());
    integrator.environmentRadiance = vec4(0.0);
    vec2 cameraSample = primeCameraSample();
    PathState path = primeCameraPath(pixel, 0u, cameraSample);

    PrimeIntegrationResult sampleResult = primeIntegrate(path, integrator);
    if (primeWritesRawNumericalDiagnostic()) {
        imageStore(
                primeRawNumericalDiagnostic,
                ivec2(pixel),
                vec4(primeRawNumericalColor(
                        primeRawNumericalFlags | primeClassifyRawOutput(sampleResult)), 1.0));
    }
    vec3 noisyDiffuse = sampleResult.radiance.diffuse;
    vec3 noisySpecular = sampleResult.radiance.specular;
    bool hasPrimarySurface = sampleResult.guides.primaryHitKind == PRIME_HIT_SURFACE;
    float primaryDistance = primeNrdSanitizePrimaryDistance(
            sampleResult.guides.primaryDistance, hasPrimarySurface);
    vec3 primaryPosition = primeNrdIsFinite(sampleResult.guides.primaryPosition)
            ? sampleResult.guides.primaryPosition
            : vec3(0.0);
    float rawSignalScale = primeNrdClampRadiancePair(
            noisyDiffuse, noisySpecular, PRIME_NRD_FP16_MAX);
    // These images are a private raygen -> NRD-preparation scratch contract. Keeping raw
    // radiance, hit distance and primary material data here removes demodulation, YCoCg packing,
    // guide construction and FSR mask work from the register-heavy ray-generation shader. The
    // existing ray-tracing-to-compute barrier makes every write visible before nrd_motion.comp
    // converts the images in place to their public NRD meanings.
    imageStore(
            primeNrdNoisyDiffuse,
            ivec2(pixel),
            vec4(
                    primeNrdSanitizeRadiance(noisyDiffuse),
                    primeNrdSanitizeHitDistance(
                            sampleResult.guides.diffuseHitDistance)));
    imageStore(
            primeNrdNoisySpecular,
            ivec2(pixel),
            vec4(
                    primeNrdSanitizeRadiance(noisySpecular),
                    primeNrdSanitizeHitDistance(
                            sampleResult.guides.specularHitDistance)));
    // Diagnostic-only exact primary hit relative to the effective camera pinhole. Keeping this
    // separate from view-Z reconstruction lets the reprojection probe detect a self-consistent
    // but wrong camera transform instead of repeating the motion generator's assumptions.
    imageStore(
            primeNrdPrimaryPosition,
            ivec2(pixel),
            vec4(
                    primaryDistance < 0.0 ? vec3(0.0) : primaryPosition,
                    uintBitsToFloat(packHalf2x16(cameraSample))));
    if (primeWritesNrdShInputs()) {
        vec3 primaryAreaDiffuse = sampleResult.guides.primaryAreaDiffuse * rawSignalScale;
        vec3 primaryAreaSpecular = sampleResult.guides.primaryAreaSpecular * rawSignalScale;
        imageStore(
                primeNrdDiffuseDirection,
                ivec2(pixel),
                vec4(primeNrdEffectiveDirection(
                        noisyDiffuse,
                        primaryAreaDiffuse,
                        sampleResult.guides.primaryAreaDirection,
                        sampleResult.guides.diffuseDirection,
                        sampleResult.guides.primaryAlbedo), 0.0));
        imageStore(
                primeNrdSpecularDirection,
                ivec2(pixel),
                vec4(primeNrdEffectiveDirection(
                        noisySpecular,
                        primaryAreaSpecular,
                        sampleResult.guides.primaryAreaDirection,
                        sampleResult.guides.specularDirection,
                        sampleResult.guides.primarySpecularAlbedo), 0.0));
    }
    imageStore(
            primeNrdMaterial,
            ivec2(pixel),
            vec4(
                    primeNrdSanitizeAlbedo(sampleResult.guides.primaryAlbedo),
                    primaryDistance));
    imageStore(
            primeNrdNormalRoughness,
            ivec2(pixel),
            primeNrdPackNormalRoughness(
                    sampleResult.guides.primaryNormal,
                    sampleResult.guides.primaryLinearRoughness,
                    primeNrdMaterialId(sampleResult.guides.primaryMaterialFlags)));
    imageStore(
            primeNrdSpecularMaterial,
            ivec2(pixel),
            vec4(
                    primeNrdSanitizeAlbedo(sampleResult.guides.primarySpecularAlbedo),
                    float(sampleResult.guides.primaryMaterialFlags)));
    imageStore(
            primeNrdSunLighting,
            ivec2(pixel),
            vec4(
                    primeNrdClampRadiance(
                            sampleResult.radiance.unshadowedSun, PRIME_NRD_FP16_MAX),
                    primeNrdSanitizeUnit(sampleResult.radiance.sunVisibility, 0.0)));
    imageStore(
            primeNrdSunPenumbra,
            ivec2(pixel),
            vec4(primeNrdSanitizeHitDistance(sampleResult.guides.sunPenumbra)));
    // Directly visible sky/emission is a current-frame deterministic signal. FSR owns temporal
    // coverage reconstruction, so averaging a second independent history here would create stale
    // silhouettes and make its lock/disocclusion logic impossible to reason about.
    imageStore(
            primeAccumulation,
            ivec2(pixel),
            vec4(primeNrdSanitizeRadiance(sampleResult.radiance.stable), 1.0));
}
