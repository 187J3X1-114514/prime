#version 460
#extension GL_GOOGLE_include_directive : require
#include "common.glsl"
#include "atmosphere_rt.glsl"
#include "nrd_common.glsl"

layout(location = 0) rayPayloadEXT TracePayload primePayload;
layout(location = 1) rayPayloadEXT uint primeShadowOccluded;

#include "sampling.glsl"
#include "bsdf.glsl"
#include "lights.glsl"
#include "integrator.glsl"

void main() {
    uvec2 pixel = gl_LaunchIDEXT.xy;
    IntegratorRecord integrator;
    integrator.sunDirectionIntensity = vec4(
            primePush.sunDirection,
            ATM_SPACE_SUN_INTENSITY);
    integrator.environmentRadiance = vec4(0.0);
    PathState path;
    path.physicalOrigin = primePush.cameraPosition;
    path.bounce = 0u;
    path.traceOrigin = primePush.cameraPosition;
    path.sampleDimension = 0u;
    path.rayDirection = vec3(0.0);
    path.flags = PRIME_PATH_PREVIOUS_DELTA;
    path.throughput = vec3(1.0);
    path.previousBsdfPdf = 0.0;
    path.radiance = vec3(0.0);
    path.pixel = pixel;
    path.sampleIndex = primePush.path.x;
    path.sampleEpoch = primePush.path.y;

    // FSR 3.1's canonical base-2/base-3 Halton sequence is the sole camera jitter source.
    // path.w is a dedicated, monotonically advancing FSR frame index; NRD and the FSR constants
    // receive the identical pixel offset from Java. Do not replace this with a per-pixel sample:
    // temporal reconstruction can only describe one camera projection for the complete frame.
    uint jitterSequenceLength = max(primePush.path.z >> 16u, 1u);
    uint jitterPhase = (primePush.path.w % jitterSequenceLength) + 1u;
    float halton2 = 0.0;
    float halton3 = 0.0;
    float fraction2 = 1.0;
    float fraction3 = 1.0;
    uint index2 = jitterPhase;
    uint index3 = jitterPhase;
    while (index2 > 0u) {
        fraction2 *= 0.5;
        halton2 += fraction2 * float(index2 % 2u);
        index2 /= 2u;
    }
    while (index3 > 0u) {
        fraction3 /= 3.0;
        halton3 += fraction3 * float(index3 % 3u);
        index3 /= 3u;
    }
    vec2 cameraSample = vec2(halton2, halton3);
    vec2 uv = (vec2(pixel) + cameraSample) / vec2(primePush.outputExtent);
    vec2 ndc = vec2(uv.x * 2.0 - 1.0, uv.y * 2.0 - 1.0);
    vec4 nearPoint = primePush.inverseViewProjection * vec4(ndc, 1.0, 1.0);
    vec4 farPoint = primePush.inverseViewProjection * vec4(ndc, 0.0, 1.0);
    path.rayDirection = normalize(farPoint.xyz / farPoint.w - nearPoint.xyz / nearPoint.w);

    PrimeIntegrationResult sampleResult = primeIntegrate(path, integrator);
    vec4 centerNear = primePush.inverseViewProjection * vec4(0.0, 0.0, 1.0, 1.0);
    vec4 centerFar = primePush.inverseViewProjection * vec4(0.0, 0.0, 0.0, 1.0);
    vec3 cameraForward = normalize(
            centerFar.xyz / centerFar.w - centerNear.xyz / centerNear.w);
    float viewZ = sampleResult.primaryDistance < 0.0
            ? PRIME_NRD_FP16_MAX
            : sampleResult.primaryDistance * dot(path.rayDirection, cameraForward);
    vec3 diffuseMaterialFactor = vec3(1.0);
    vec3 specularMaterialFactor = vec3(1.0);
    float primaryLinearRoughness = PRIME_DEFAULT_REFERENCE_LINEAR_ROUGHNESS;
    if (sampleResult.primaryHitKind != PRIME_HIT_NONE) {
        primaryLinearRoughness = primeDefaultLinearRoughness(
                sampleResult.primaryBaseColor);
        primeNrdMaterialFactors(
                sampleResult.primaryNormal,
                -path.rayDirection,
                sampleResult.primaryBaseColor,
                vec3(PRIME_DEFAULT_DIELECTRIC_F0),
                primaryLinearRoughness,
                diffuseMaterialFactor,
                specularMaterialFactor);
    }
    vec3 demodulatedDiffuse = sampleResult.diffuseRadiance / diffuseMaterialFactor;
    vec3 demodulatedSpecular = sampleResult.specularRadiance / specularMaterialFactor;
    float normalizedDiffuseHitDistance = sampleResult.diffuseHitDistance <= 0.0
            ? 0.0
            : primeNrdNormalizedHitDistance(
                    sampleResult.diffuseHitDistance, viewZ, 1.0);
    float normalizedSpecularHitDistance = sampleResult.specularHitDistance <= 0.0
            ? 0.0
            : primeNrdNormalizedHitDistance(
                    sampleResult.specularHitDistance,
                    viewZ,
                    primaryLinearRoughness);

    imageStore(
            primeNrdNoisyDiffuse,
            ivec2(pixel),
            primeNrdPackRadianceAndHitDistance(
                    demodulatedDiffuse, normalizedDiffuseHitDistance));
    imageStore(
            primeNrdNoisySpecular,
            ivec2(pixel),
            primeNrdPackRadianceAndHitDistance(
                    demodulatedSpecular, normalizedSpecularHitDistance));
    imageStore(
            primeNrdNormalRoughness,
            ivec2(pixel),
            primeNrdPackNormalRoughness(
                    sampleResult.primaryNormal, primaryLinearRoughness));
    imageStore(primeNrdViewZ, ivec2(pixel), vec4(viewZ, 0.0, 0.0, 0.0));
    // Diagnostic-only exact primary hit relative to the effective camera pinhole. Keeping this
    // separate from view-Z reconstruction lets the reprojection probe detect a self-consistent
    // but wrong camera transform instead of repeating the motion generator's assumptions.
    imageStore(
            primeNrdPrimaryPosition,
            ivec2(pixel),
            sampleResult.primaryDistance < 0.0
                    ? vec4(0.0)
                    : vec4(
                            path.rayDirection * sampleResult.primaryDistance,
                            uintBitsToFloat(packHalf2x16(cameraSample))));
    imageStore(
            primeNrdMaterial,
            ivec2(pixel),
            vec4(diffuseMaterialFactor, sampleResult.primaryDistance));
    imageStore(
            primeNrdSpecularMaterial,
            ivec2(pixel),
            vec4(
                    specularMaterialFactor,
                    primeFsrTransparencyAndCompositionMask(
                            sampleResult.primaryMaterialFlags,
                            primaryLinearRoughness)));

    // Directly visible sky/emission is a current-frame deterministic signal. FSR owns temporal
    // coverage reconstruction, so averaging a second independent history here would create stale
    // silhouettes and make its lock/disocclusion logic impossible to reason about.
    imageStore(primeAccumulation, ivec2(pixel), vec4(sampleResult.stableRadiance, 1.0));
}
