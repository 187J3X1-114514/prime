#version 460
#extension GL_GOOGLE_include_directive : require
#extension GL_EXT_samplerless_texture_functions : require

#include "display_transform.glsl"

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 0, binding = 0) uniform texture2D primeFsrLinearOutput;
layout(set = 0, binding = 1, rgba8) uniform writeonly image2D primeDisplayOutput;
layout(std430, set = 0, binding = 2) readonly buffer PrimeAutoExposureState {
    float exposureEv;
    uint initialized;
    float targetEv;
    float measuredLogBrightness;
} primeAutoExposureState;

layout(push_constant) uniform PrimeFsrDisplayPushConstants {
    uvec2 outputExtent;
    uint debugView;
    float oklabOverexposure;
    float finalExposureMultiplier;
    float curveExponent;
    float curveCoefficient;
} primeFsrDisplayPush;

void main() {
    uvec2 pixel = gl_GlobalInvocationID.xy;
    if (any(greaterThanEqual(pixel, primeFsrDisplayPush.outputExtent))) {
        return;
    }
    // The FSR output already has display resolution. A one-to-one integer fetch preserves the
    // exact reconstructed sample and prevents this final color transform from filtering it again.
    vec3 radiance = texelFetch(primeFsrLinearOutput, ivec2(pixel), 0).rgb;
    if (primeFsrDisplayPush.debugView != 0u) {
        // FidelityFX and NRD diagnostics already contain display colors, not scene radiance.
        // Bypassing the Oklab transform preserves their labels, colors and numeric scale.
        imageStore(primeDisplayOutput, ivec2(pixel), vec4(clamp(radiance, 0.0, 1.0), 1.0));
        return;
    }
    if (any(isnan(radiance)) || any(isinf(radiance))) {
        radiance = vec3(0.0);
    }
    imageStore(
            primeDisplayOutput,
            ivec2(pixel),
            vec4(primeDisplayTransformToSrgb(
                    max(radiance, vec3(0.0)),
                    exp2(primeAutoExposureState.exposureEv)
                            * primeFsrDisplayPush.finalExposureMultiplier,
                    primeFsrDisplayPush.oklabOverexposure,
                    primeFsrDisplayPush.curveExponent,
                    primeFsrDisplayPush.curveCoefficient), 1.0));
}
